@page "/Events/EventDetail/{id:int}"
@model Group6_PRN222_Project.Pages.Events.EventDetailModel
@{
    ViewData["Title"] = Model.Event?.EventName ?? "Chi tiết sự kiện";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var ev = Model.Event;
    var themes = new[] { "theme-1", "theme-2", "theme-3", "theme-4", "theme-5", "theme-6" };
    var theme = themes[Math.Abs((ev?.EventId ?? 0) % themes.Length)];
    var capacityPct = ev?.Capacity.HasValue == true && ev.Capacity > 0
        ? Math.Min((int)((double)Model.TicketCount / ev.Capacity.Value * 100), 100)
        : Math.Min(Model.TicketCount * 2, 100);
}

@section Styles {
    <style>
        .detail-hero {
            height: 380px;
            position: relative;
            overflow: hidden;
        }

        .detail-hero__bg {
            position: absolute;
            inset: 0;
        }

        .detail-hero__overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(26,23,20,.15) 0%, rgba(26,23,20,.8) 100%);
        }

        .detail-hero__content {
            position: relative;
            z-index: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .detail-hero__title {
            font-family: var(--ff-display);
            font-size: clamp(28px, 4vw, 52px);
            font-weight: 700;
            color: #fff;
            letter-spacing: -.5px;
            line-height: 1.1;
            margin-bottom: 14px;
        }

        .detail-hero__meta {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .detail-hero__meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            color: rgba(255,255,255,.8);
        }

            .detail-hero__meta-item svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }

        .detail-layout {
            max-width: 1200px;
            margin: 0 auto;
            padding: 48px 40px;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 40px;
            align-items: start;
        }

        .detail-section {
            margin-bottom: 36px;
        }

        .detail-section-title {
            font-family: var(--ff-display);
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--c-sand);
            letter-spacing: -.2px;
        }

        .detail-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .detail-info-item {
            background: var(--c-cream);
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-md);
            padding: 16px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .detail-info-icon {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            background: var(--c-gold-pale);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .detail-info-label {
            font-size: 11px;
            color: var(--c-ink-60);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 3px;
        }

        .detail-info-value {
            font-size: 14px;
            font-weight: 600;
            color: var(--c-ink);
        }

        .register-card {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-xl);
            overflow: hidden;
            position: sticky;
            top: 88px;
            box-shadow: var(--shadow-md);
        }

        .register-card__header {
            background: var(--c-ink);
            padding: 24px;
        }

        .register-card__event-name {
            font-family: var(--ff-display);
            font-size: 18px;
            font-weight: 600;
            color: var(--c-ivory);
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .register-card__date {
            font-size: 13px;
            color: rgba(250,248,244,.5);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .register-card__body {
            padding: 24px;
        }

        .capacity-bar {
            margin-bottom: 20px;
        }

        .capacity-bar__labels {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: var(--c-ink-60);
            margin-bottom: 6px;
        }

            .capacity-bar__labels strong {
                color: var(--c-ink);
            }

        .progress {
            height: 6px;
            background: var(--c-sand);
            border-radius: 3px;
            overflow: hidden;
        }

        .progress__fill {
            height: 100%;
            border-radius: 3px;
            background: linear-gradient(90deg, var(--c-accent), var(--c-gold));
            transition: width .6s ease;
        }

            .progress__fill.full {
                background: linear-gradient(90deg, #C04830, #E06040);
            }

        .section-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--c-ink-60);
            text-transform: uppercase;
            letter-spacing: .8px;
            margin-bottom: 10px;
            display: block;
        }

        .ticket-types {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 18px;
        }

        .ticket-option {
            position: relative;
        }

            .ticket-option input[type="radio"] {
                position: absolute;
                opacity: 0;
                width: 0;
                height: 0;
            }

        .ticket-option__label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            border: 1.5px solid var(--c-sand);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all var(--transition);
        }

            .ticket-option__label:hover {
                border-color: var(--c-taupe);
                background: var(--c-cream);
            }

        .ticket-option input:checked + .ticket-option__label {
            border-color: var(--c-gold);
            background: var(--c-gold-pale);
        }

        .ticket-option__left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ticket-option__icon {
            width: 30px;
            height: 30px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .ticket-option__name {
            font-size: 14px;
            font-weight: 600;
            color: var(--c-ink);
        }

        .ticket-option__desc {
            font-size: 11px;
            color: var(--c-ink-60);
            margin-top: 1px;
        }

        .ticket-option__price {
            font-size: 14px;
            font-weight: 700;
            color: var(--c-ink);
            white-space: nowrap;
        }

            .ticket-option__price.free {
                color: var(--c-success);
            }

        .payment-methods {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 18px;
        }

        .payment-option {
            position: relative;
        }

            .payment-option input[type="radio"] {
                position: absolute;
                opacity: 0;
                width: 0;
                height: 0;
            }

        .payment-option__label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border: 1.5px solid var(--c-sand);
            border-radius: var(--radius-md);
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            color: var(--c-ink);
            transition: all var(--transition);
        }

            .payment-option__label:hover {
                border-color: var(--c-taupe);
            }

        .payment-option input:checked + .payment-option__label {
            border-color: var(--c-gold);
            background: var(--c-gold-pale);
            color: #8B6020;
        }

        .payment-option__icon {
            width: 28px;
            height: 28px;
            border-radius: var(--radius-sm);
            background: var(--c-cream);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .payment-option__sub {
            font-size: 10px;
            color: var(--c-ink-60);
            font-weight: 400;
            margin-top: 1px;
        }

        .bank-info {
            background: #E4EDF8;
            border: 1px solid #B5D4F4;
            border-radius: var(--radius-md);
            padding: 14px;
            font-size: 12px;
            margin-bottom: 14px;
            display: none;
            line-height: 1.8;
        }

        .order-summary {
            background: var(--c-cream);
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-md);
            padding: 14px;
            margin-bottom: 16px;
        }

        .order-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: var(--c-ink-60);
            margin-bottom: 6px;
        }

            .order-row:last-child {
                margin-bottom: 0;
                padding-top: 8px;
                border-top: 1px solid var(--c-sand);
                font-weight: 600;
                color: var(--c-ink);
                font-size: 15px;
            }

        .btn-register {
            width: 100%;
            padding: 14px;
            justify-content: center;
            font-size: 15px;
            border-radius: var(--radius-md);
            background: var(--c-gold) !important;
            border-color: var(--c-gold) !important;
            color: var(--c-ink) !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(184,151,90,.25);
        }

            .btn-register:hover {
                background: var(--c-gold-light) !important;
                transform: translateY(-1px);
                box-shadow: 0 6px 24px rgba(184,151,90,.35);
            }

        .already-joined {
            background: #E8F2EC;
            border: 1px solid #9FD8B8;
            border-radius: var(--radius-md);
            padding: 20px;
            text-align: center;
        }

        .login-prompt {
            background: var(--c-cream);
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-md);
            padding: 20px;
            text-align: center;
        }

        .closed-notice {
            background: #FAE8E4;
            border: 1px solid #F5C4B3;
            border-radius: var(--radius-md);
            padding: 20px;
            text-align: center;
        }

        @@media (max-width: 900px) {
            .detail-layout {
                grid-template-columns: 1fr;
            }

            .register-card {
                position: static;
            }

            .detail-hero__content {
                padding: 24px 20px;
            }

            .detail-info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@if (ev == null)
{
    <div class="container" style="padding:80px 40px;text-align:center">
        <div style="font-size:52px;margin-bottom:16px">😕</div>
        <h2 style="font-family:var(--ff-display);font-size:28px;margin-bottom:8px">Không tìm thấy sự kiện</h2>
        <a asp-page="/Events/EventList" class="btn btn-primary" style="margin-top:16px;display:inline-flex">Xem tất cả sự kiện</a>
    </div>
    return;
}

<!-- Hero -->
<div class="detail-hero">
    <div class="detail-hero__bg @theme"></div>
    <div class="detail-hero__overlay"></div>
    <div class="detail-hero__content container">
        @{
            var bc = ev.Status switch
            {
                "Open" => "badge-green",
                "Planning" => "badge-blue",
                "Completed" => "badge-gray",
                _ => "badge-gray"
            };
            var bt = ev.Status switch
            {
                "Open" => "Đang mở đăng ký",
                "Planning" => "Chuẩn bị",
                "Completed" => "Đã kết thúc",
                _ => ev.Status ?? ""
            };
        }
        <div style="margin-bottom:12px"><span class="badge @bc">@bt</span></div>
        <h1 class="detail-hero__title">@ev.EventName</h1>
        <div class="detail-hero__meta">
            @if (ev.StartDate.HasValue)
            {
                <div class="detail-hero__meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    @ev.StartDate.Value.ToString("dd/MM/yyyy")
                    @if (ev.EndDate.HasValue && ev.EndDate.Value.Date != ev.StartDate.Value.Date)
                    {
                        <span>— @ev.EndDate.Value.ToString("dd/MM/yyyy")</span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(ev.Location))
            {
                <div class="detail-hero__meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    @ev.Location
                </div>
            }
            <div class="detail-hero__meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                @Model.TicketCount người đã đăng ký
                @if (ev.Capacity.HasValue)
                {
                    <span>/ @ev.Capacity chỗ</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Breadcrumb -->
<div style="background:var(--c-cream);border-bottom:1px solid var(--c-sand);padding:12px 0">
    <div class="container">
        <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--c-ink-60)">
            <a asp-page="/Index" style="color:var(--c-gold);text-decoration:none">Trang chủ</a>
            <span>/</span>
            <a asp-page="/Events/EventList" style="color:var(--c-gold);text-decoration:none">Sự kiện</a>
            <span>/</span>
            <span>@ev.EventName</span>
        </div>
    </div>
</div>

<!-- Main -->
<div class="detail-layout">

    <!-- LEFT -->
    <div>
        @if (!string.IsNullOrEmpty(ev.Concept))
        {
            <div class="detail-section">
                <div class="detail-section-title">Giới thiệu sự kiện</div>
                <p style="font-size:15px;color:var(--c-ink-60);line-height:1.8">@ev.Concept</p>
            </div>
        }

        <div class="detail-section">
            <div class="detail-section-title">Thông tin chi tiết</div>
            <div class="detail-info-grid">
                <div class="detail-info-item">
                    <div class="detail-info-icon">📅</div>
                    <div>
                        <div class="detail-info-label">Ngày bắt đầu</div>
                        <div class="detail-info-value">@(ev.StartDate?.ToString("dd/MM/yyyy") ?? "TBD")</div>
                    </div>
                </div>
                <div class="detail-info-item">
                    <div class="detail-info-icon">🕐</div>
                    <div>
                        <div class="detail-info-label">Giờ bắt đầu</div>
                        <div class="detail-info-value">@(ev.EventTime?.ToString("hh\\:mm") ?? "TBD")</div>
                    </div>
                </div>
                <div class="detail-info-item">
                    <div class="detail-info-icon">📍</div>
                    <div>
                        <div class="detail-info-label">Địa điểm</div>
                        <div class="detail-info-value">@(ev.Location ?? "TBD")</div>
                    </div>
                </div>
                <div class="detail-info-item">
                    <div class="detail-info-icon">👥</div>
                    <div>
                        <div class="detail-info-label">Sức chứa</div>
                        <div class="detail-info-value">
                            @if (ev.Capacity.HasValue)
                            {
                                @($"{Model.TicketCount} / {ev.Capacity} chỗ")
                            }
                            else
                            {
                                <span>Không giới hạn</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="detail-info-item">
                    <div class="detail-info-icon">💰</div>
                    <div>
                        <div class="detail-info-label">Giá vé cơ bản</div>
                        <div class="detail-info-value">
                            @if (ev.Amount > 0)
                            {
                                @($"{ev.Amount:N0} VNĐ")
                            }
                            else
                            {
                                <span style="color:var(--c-success)">Miễn phí</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="detail-info-item">
                    <div class="detail-info-icon">📏</div>
                    <div>
                        <div class="detail-info-label">Quy mô</div>
                        <div class="detail-info-value">
                            @(ev.Scale switch { "Nho" => "Nhỏ", "Vua" => "Vừa", "Lon" => "Lớn", _ => "N/A" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ticket types info — dùng giá từ Model -->
        <div class="detail-section">
            <div class="detail-section-title">Loại vé</div>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px">
                @{
                    var ticketInfos = new[]
                    {
                                new { Icon="🎟", Label="Standard",  Desc="Vé thường",              Price=Model.PriceStandard,       Color="#E8F2EC", TextColor="#1A5A30" },
                                new { Icon="⭐", Label="VIP",        Desc="Ưu tiên vị trí tốt",    Price=Model.PriceVip,            Color="#F0E8D4", TextColor="#8B6020" },
                                new { Icon="🎓", Label="Student",   Desc="Xuất trình thẻ SV",      Price=Model.PriceStudent,        Color="#E4EDF8", TextColor="#1A3A6B" },
                                new { Icon="🎁", Label="Miễn phí",  Desc="Vé mời đặc biệt",        Price=Model.PriceComplimentary,  Color="#FAE8E4", TextColor="#7A2A1A" },
                                };
                }
                @foreach (var ti in ticketInfos)
                {
                    <div style="background:@ti.Color;border-radius:var(--radius-md);padding:14px 16px">
                        <div style="font-size:18px;margin-bottom:6px">@ti.Icon</div>
                        <div style="font-weight:600;font-size:14px;color:@ti.TextColor">@ti.Label</div>
                        <div style="font-size:12px;color:@ti.TextColor;opacity:.7;margin-top:2px">@ti.Desc</div>
                        <div style="font-size:15px;font-weight:700;color:@ti.TextColor;margin-top:8px">
                            @(ti.Price == 0 ? "Miễn phí" : $"{ti.Price:N0} ₫")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT: Register Card -->
    <div>
        <div class="register-card">
            <div class="register-card__header">
                <div class="register-card__event-name">@ev.EventName</div>
                <div class="register-card__date">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    @ev.StartDate?.ToString("dd/MM/yyyy")
                    @if (ev.EventTime.HasValue)
                    {
                        <span>lúc @ev.EventTime.Value.ToString("hh\\:mm")</span>
                    }
                </div>
            </div>

            <div class="register-card__body">
                <!-- Capacity bar -->
                <div class="capacity-bar">
                    <div class="capacity-bar__labels">
                        <span>Đã đăng ký: <strong>@Model.TicketCount</strong></span>
                        @if (ev.Capacity.HasValue)
                        {
                            <span>Còn lại: <strong>@(ev.Capacity.Value - Model.TicketCount)</strong></span>
                        }
                    </div>
                    <div class="progress">
                        <div class="progress__fill @(capacityPct >= 100 ? "full" : "")"
                             style="width:@capacityPct%"></div>
                    </div>
                    @if (ev.Capacity.HasValue)
                    {
                        <div style="font-size:11px;color:var(--c-ink-60);margin-top:4px;text-align:right">@capacityPct% đã đặt chỗ</div>
                    }
                </div>

                @if (Model.AlreadyJoined)
                {
                    <div class="already-joined">
                        <div style="font-size:32px;margin-bottom:8px">🎉</div>
                        <div style="font-weight:700;color:var(--c-success);font-size:16px;margin-bottom:4px">Bạn đã đăng ký!</div>
                        <div style="font-size:13px;color:var(--c-success);opacity:.8">Hẹn gặp bạn tại sự kiện nhé.</div>
                    </div>
                }
                else if (!Model.IsLoggedIn)
                {
                    <div class="login-prompt">
                        <div style="font-size:28px;margin-bottom:10px">🔐</div>
                        <div style="font-weight:600;font-size:15px;margin-bottom:6px">Đăng nhập để đăng ký</div>
                        <div style="font-size:13px;color:var(--c-ink-60);margin-bottom:16px">Cần tài khoản Participant để tham gia sự kiện này.</div>
                        <a asp-page="/Account/Login"
                           asp-route-returnUrl="/Events/EventDetail/@ev.EventId"
                           class="btn btn-primary" style="width:100%;justify-content:center">
                            Đăng nhập ngay
                        </a>
                        <div style="margin-top:10px;font-size:12px;color:var(--c-ink-60)">
                            Chưa có tài khoản? <a asp-page="/Account/Register" style="color:var(--c-gold)">Đăng ký miễn phí</a>
                        </div>
                    </div>
                }
                else if (!Model.IsParticipant)
                {
                    <div class="closed-notice">
                        <div style="font-size:28px;margin-bottom:8px">⚠️</div>
                        <div style="font-weight:600;color:var(--c-danger);font-size:14px">Chỉ tài khoản Participant mới đăng ký được sự kiện.</div>
                    </div>
                }
                else if (!Model.IsOpenForReg)
                {
                    <div class="closed-notice">
                        <div style="font-size:28px;margin-bottom:8px">🔒</div>
                        <div style="font-weight:600;color:var(--c-danger);font-size:15px;margin-bottom:4px">Sự kiện chưa mở đăng ký</div>
                        <div style="font-size:13px;color:var(--c-danger);opacity:.8">Trạng thái: @ev.Status</div>
                    </div>
                }
                else
                {
                    <!-- Form đăng ký -->
                    <form method="post" asp-page-handler="Register" asp-route-id="@ev.EventId" id="registerForm">

                        <!-- Chọn loại vé — lấy giá từ Model -->
                        <span class="section-label">Chọn loại vé</span>
                        <div class="ticket-types" id="ticketTypesContainer">
                            @{
                                var typeOpts = new[]
                                {
                                                new { Val="Standard",      Icon="🎟", Name="Standard",  Desc="Vé thường",                     Price=Model.PriceStandard },
                                                new { Val="VIP",           Icon="⭐", Name="VIP",        Desc="Ưu tiên vị trí tốt",            Price=Model.PriceVip },
                                                new { Val="Student",       Icon="🎓", Name="Student",   Desc="Xuất trình CMHS/thẻ sinh viên", Price=Model.PriceStudent },
                                                new { Val="Complimentary", Icon="🎁", Name="Miễn phí",  Desc="Vé mời đặc biệt",               Price=Model.PriceComplimentary },
                                                };
                            }
                            @foreach (var opt in typeOpts)
                            {
                                <div class="ticket-option">
                                    <input type="radio" name="ticketType" id="tt-@opt.Val"
                                           value="@opt.Val"
                                           @(opt.Val == "Standard" ? "checked" : "")
                                           onchange="updatePrice()" />
                                    <label class="ticket-option__label" for="tt-@opt.Val">
                                        <div class="ticket-option__left">
                                            <div class="ticket-option__icon" style="background:var(--c-cream)">@opt.Icon</div>
                                            <div>
                                                <div class="ticket-option__name">@opt.Name</div>
                                                <div class="ticket-option__desc">@opt.Desc</div>
                                            </div>
                                        </div>
                                        <div class="ticket-option__price @(opt.Price == 0 ? "free" : "")">
                                            @(opt.Price == 0 ? "Miễn phí" : $"{opt.Price:N0} ₫")
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>

                        <!-- Chọn thanh toán -->
                        <span class="section-label">Phương thức thanh toán</span>
                        <div class="payment-methods">
                            <div class="payment-option">
                                <input type="radio" name="paymentMethod" id="pm-direct" value="Direct" checked onchange="toggleBankInfo(this)" />
                                <label class="payment-option__label" for="pm-direct">
                                    <div class="payment-option__icon">💵</div>
                                    <div><div>Thanh toán trực tiếp</div><div class="payment-option__sub">Nộp tại quầy vào ngày sự kiện</div></div>
                                </label>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="paymentMethod" id="pm-transfer" value="Transfer" onchange="toggleBankInfo(this)" />
                                <label class="payment-option__label" for="pm-transfer">
                                    <div class="payment-option__icon">🏦</div>
                                    <div><div>Chuyển khoản ngân hàng</div><div class="payment-option__sub">Chuyển trước, chờ xác nhận</div></div>
                                </label>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="paymentMethod" id="pm-card" value="CreditCard" onchange="toggleBankInfo(this)" />
                                <label class="payment-option__label" for="pm-card">
                                    <div class="payment-option__icon">💳</div>
                                    <div><div>Thẻ tín dụng / Ghi nợ</div><div class="payment-option__sub">Thanh toán ngay, xác nhận tức thì</div></div>
                                </label>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="paymentMethod" id="pm-zalopay" value="ZaloPay" onchange="toggleBankInfo(this)" />
                                <label class="payment-option__label" for="pm-zalopay">
                                    <div class="payment-option__icon">⚡</div>
                                    <div><div>ZaloPay</div><div class="payment-option__sub">Ví ZaloPay</div></div>
                                </label>
                            </div>
                        </div>

                        <!-- Bank info -->
                        <div class="bank-info" id="bankInfo">
                            <strong>Thông tin chuyển khoản:</strong><br>
                            Ngân hàng: <strong>Vietcombank</strong><br>
                            STK: <strong>1234567890</strong><br>
                            Chủ TK: <strong>EVENTPRO GROUP 6</strong><br>
                            Nội dung: <strong>DANGKY @ev.EventId [Họ tên]</strong>
                        </div>

                        <!-- Order summary -->
                        <div class="order-summary" id="orderSummary">
                            <div class="order-row">
                                <span>Loại vé</span>
                                <span id="summaryType">Standard</span>
                            </div>
                            <div class="order-row">
                                <span>Đơn giá</span>
                                <span id="summaryPrice">@Model.PriceStandard.ToString("N0") ₫</span>
                            </div>
                            <div class="order-row">
                                <span>Tổng cộng</span>
                                <span id="summaryTotal">@Model.PriceStandard.ToString("N0") ₫</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-register">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V22H4V12" /><path d="M22 7H2v5h20V7z" /><path d="M12 22V7" /><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" /><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" /></svg>
                            Đăng ký tham gia
                        </button>
                        <div style="font-size:11px;color:var(--c-ink-60);text-align:center;margin-top:10px;line-height:1.6">
                            Bằng cách đăng ký, bạn đồng ý với điều khoản tham gia sự kiện.
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Giá lấy từ Model server, không hardcode
        var prices = {
            Standard:      @Model.PriceStandard.ToString(System.Globalization.CultureInfo.InvariantCulture),
            VIP:           @Model.PriceVip.ToString(System.Globalization.CultureInfo.InvariantCulture),
            Student:       @Model.PriceStudent.ToString(System.Globalization.CultureInfo.InvariantCulture),
            Complimentary: 0
        };

        function formatVND(n) {
            return n === 0 ? 'Miễn phí' : n.toLocaleString('vi-VN') + ' ₫';
        }

        function updatePrice() {
            var sel = document.querySelector('input[name="ticketType"]:checked');
            if (!sel) return;
            var type  = sel.value;
            var price = prices[type] ?? 0;
            document.getElementById('summaryType').textContent  = type;
            document.getElementById('summaryPrice').textContent = formatVND(price);
            document.getElementById('summaryTotal').textContent = formatVND(price);
        }

        function toggleBankInfo(radio) {
            document.getElementById('bankInfo').style.display =
                radio.value === 'Transfer' ? 'block' : 'none';
        }

        document.getElementById('pm-direct')?.addEventListener('change', function () {
            document.getElementById('bankInfo').style.display = 'none';
        });
    </script>
}
