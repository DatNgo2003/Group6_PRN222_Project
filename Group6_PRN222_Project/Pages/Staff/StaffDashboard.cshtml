@page "/Staff/StaffDashboard"
@model Group6_PRN222_Project.Pages.Staff.StaffDashboardModel
@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";

    var (headerBg, icon, roleLabel) = Model.Role switch
    {
        "Staff(Security)" => ("#1A3A5A", "🛡", "Nhân viên An ninh"),
        "Staff(MKT)" => ("#5A1A1A", "📢", "Nhân viên Marketing"),
        "Staff(Logistics)" => ("#1A3A1A", "📦", "Nhân viên Hậu cần"),
        _ => ("var(--c-ink)", "👤", "Nhân viên")
    };
}

@section Styles {
    <style>
        .dashboard-hero {
            background: @headerBg;
            padding: 40px 0;
        }

        .dashboard-hero__inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .dashboard-hero__left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .dashboard-hero__avatar {
            width: 52px;
            height: 52px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .dashboard-hero__name {
            font-family: var(--ff-display);
            font-size: 26px;
            font-weight: 600;
            color: #fff;
            line-height: 1.1;
        }

        .dashboard-hero__role {
            font-size: 13px;
            color: rgba(255,255,255,.6);
            margin-top: 3px;
        }

        .dashboard-hero__time {
            font-size: 13px;
            color: rgba(255,255,255,.35);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-lg);
            padding: 24px;
            transition: transform var(--transition), box-shadow var(--transition);
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-md);
            }

        .stat-card__icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 16px;
        }

        .stat-card__value {
            font-family: var(--ff-display);
            font-size: 40px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -1px;
            margin-bottom: 4px;
        }

        .stat-card__label {
            font-size: 13px;
            color: var(--c-ink-60);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .data-table-wrap {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .data-table-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--c-sand);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .data-table-title {
            font-family: var(--ff-display);
            font-size: 18px;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 12px 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: var(--c-ink-60);
            background: var(--c-cream);
            border-bottom: 1px solid var(--c-sand);
        }

        td {
            padding: 13px 20px;
            font-size: 14px;
            border-bottom: 1px solid var(--c-sand);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: var(--c-cream);
        }

        .progress-bar {
            height: 6px;
            background: var(--c-sand);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-bar__fill {
            height: 100%;
            border-radius: 3px;
            background: linear-gradient(90deg, var(--c-accent), var(--c-gold));
        }

        @@media (max-width: 900px) {
            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="dashboard-hero">
    <div class="dashboard-hero__inner">
        <div class="dashboard-hero__left">
            <div class="dashboard-hero__avatar">@icon</div>
            <div>
                <div class="dashboard-hero__name">@Model.FullName</div>
                <div class="dashboard-hero__role">@roleLabel</div>
            </div>
        </div>
        <div class="dashboard-hero__time">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

<div class="section-sm">
    <div class="container">

        @if (Model.Role == "Staff(Security)")
        {
            <div style="margin-bottom:28px;padding:20px 24px;border-radius:var(--radius-lg);border:1px solid var(--c-sand);background:linear-gradient(135deg,#E4EDF8 0%,#F3EFE7 100%);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;">
                <div>
                    <div style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--c-info);margin-bottom:6px;">Trung tâm an ninh</div>
                    <div style="font-family:var(--ff-display);font-size:20px;font-weight:600;">VIP, headcount, QR check-in &amp; báo cáo hiện trường</div>
                </div>
                <a class="btn btn-primary" asp-page="/StaffSecurity/Index">Mở module An ninh</a>
            </div>
        }

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card__icon" style="background:#E4EDF8">📋</div>
                <div class="stat-card__value" style="color:var(--c-info)">@Model.MyTotalTasks</div>
                <div class="stat-card__label">Tổng nhiệm vụ</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__icon" style="background:#E8F2EC">✅</div>
                <div class="stat-card__value" style="color:var(--c-success)">@Model.MyDoneTasks</div>
                <div class="stat-card__label">Đã hoàn thành</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__icon" style="background:#FAE8E4">⏳</div>
                <div class="stat-card__value" style="color:var(--c-danger)">@Model.MyPendingTasks</div>
                <div class="stat-card__label">Chờ xử lý</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__icon" style="background:var(--c-gold-pale)">📝</div>
                <div class="stat-card__value" style="color:var(--c-gold)">@Model.MyReports</div>
                <div class="stat-card__label">Báo cáo đã gửi</div>
                @if (Model.MyTotalTasks > 0)
                {
                    var pct = (int)((double)Model.MyDoneTasks / Model.MyTotalTasks * 100);
                    <div class="progress-bar" style="margin-top:12px">
                        <div class="progress-bar__fill" style="width:@pct%"></div>
                    </div>
                    <div style="font-size:11px;color:var(--c-ink-60);margin-top:4px">@((int)((double)Model.MyDoneTasks / Model.MyTotalTasks * 100))% hoàn thành</div>
                }
            </div>
        </div>

        <div class="grid-2">
            <!-- Tasks -->
            <div class="data-table-wrap">
                <div class="data-table-header">
                    <div class="data-table-title">Nhiệm vụ của tôi</div>
                    <span class="badge badge-blue">@Model.MyTotalTasks việc</span>
                </div>
                <table>
                    <thead>
                        <tr><th>Nhiệm vụ</th><th>Sự kiện</th><th>Deadline</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.MyTasks)
                        {
                            <tr>
                                <td style="font-weight:500;font-size:13px">@task.TaskName</td>
                                <td style="font-size:12px;color:var(--c-ink-60)">@task.Event?.EventName</td>
                                <td style="font-size:12px;color:var(--c-ink-60)">@task.Deadline?.ToString("dd/MM")</td>
                                <td>
                                    @{
                                        var tc = task.Status == "Done" ? "badge-green"
                                        : task.Status == "In Progress" ? "badge-blue"
                                        : "badge-gray";
                                    }
                                    <span class="badge @tc">@task.Status</span>
                                </td>
                            </tr>
                        }
                        @if (!Model.MyTasks.Any())
                        {
                            <tr><td colspan="4" style="text-align:center;color:var(--c-ink-60);padding:24px">Chưa có nhiệm vụ nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Field Reports -->
            <div class="data-table-wrap">
                <div class="data-table-header">
                    <div class="data-table-title">Báo cáo thực địa</div>
                    <span class="badge badge-gold">@Model.MyReports báo cáo</span>
                </div>
                <table>
                    <thead>
                        <tr><th>Loại báo cáo</th><th>Sự kiện</th><th>Thời gian</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.MyFieldReports)
                        {
                            <tr>
                                <td style="font-weight:500;font-size:13px">@report.ReportType</td>
                                <td style="font-size:12px;color:var(--c-ink-60)">@report.Event?.EventName</td>
                                <td style="font-size:12px;color:var(--c-ink-60)">@report.ReportTime?.ToString("dd/MM HH:mm")</td>
                                <td><span class="badge badge-green">@(report.Status ?? "Submitted")</span></td>
                            </tr>
                        }
                        @if (!Model.MyFieldReports.Any())
                        {
                            <tr><td colspan="4" style="text-align:center;color:var(--c-ink-60);padding:24px">Chưa có báo cáo nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
