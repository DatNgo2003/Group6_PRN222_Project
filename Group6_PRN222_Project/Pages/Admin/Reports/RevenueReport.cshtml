@page
@model Project_PRN222.Pages.Admin.Reports.RevenueReportModel
@{
    ViewData["Title"] = "Báo cáo doanh thu";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

@section Styles {
<style>
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    @@media (max-width: 900px) { .stat-grid { grid-template-columns: repeat(2,1fr); } }
    @@media (max-width: 500px)  { .stat-grid { grid-template-columns: 1fr; } }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--card-bdr);
        border-radius: var(--r-lg);
        padding: 20px 22px;
    }
    .stat-label {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 8px;
    }
    .stat-value {
        font-family: var(--ff-display);
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        color: var(--text-1);
    }
    .stat-value.gold  { color: var(--c-gold); }
    .stat-value.green { color: #6ee7b7; }
    .stat-value.red   { color: #f87171; }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 20px;
        align-items: start;
    }
    @@media (max-width: 1100px) { .two-col { grid-template-columns: 1fr; } }

    .filter-row {
        display: flex;
        gap: 12px;
        align-items: flex-end;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }
    .filter-group { display: flex; flex-direction: column; gap: 5px; }
    .filter-group label {
        font-size: .75rem;
        font-weight: 600;
        color: var(--text-3);
    }
    .filter-group input { width: 170px; }

    .rpt-card {
        background: var(--card-bg);
        border: 1px solid var(--card-bdr);
        border-radius: var(--r-lg);
        overflow: hidden;
    }
    .rpt-card-header {
        padding: 14px 20px;
        border-bottom: 1px solid var(--card-bdr);
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(184,151,90,.55);
        background: rgba(0,0,0,.12);
    }
    .rpt-card-body { padding: 20px; }

    .top-table { width: 100%; border-collapse: collapse; font-size: .845rem; }
    .top-table th {
        padding: 9px 14px;
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--text-3);
        border-bottom: 1px solid var(--card-bdr);
        background: rgba(0,0,0,.12);
        text-align: left;
    }
    .top-table td {
        padding: 10px 14px;
        border-bottom: 1px solid var(--row-bdr);
        vertical-align: middle;
    }
    .top-table tbody tr:last-child td { border-bottom: none; }
    .top-table tbody tr:hover { background: var(--row-hover); }

    .rank-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px; height: 20px;
        border-radius: 50%;
        font-size: .68rem;
        font-weight: 700;
        background: var(--c-gold-pale);
        color: var(--c-gold);
        border: 1px solid rgba(184,151,90,.22);
        margin-right: 6px;
        flex-shrink: 0;
    }
    .rank-badge.dim {
        background: rgba(250,248,244,.05);
        color: var(--text-3);
        border-color: rgba(250,248,244,.09);
    }
    .num-right {
        font-family: var(--ff-mono);
        font-size: .82rem;
        color: var(--c-gold);
        font-weight: 600;
        text-align: right;
    }
    .empty-box {
        text-align: center;
        padding: 48px 0;
        color: var(--text-3);
        font-size: .875rem;
    }
</style>
}

<div class="page-header">
    <div class="page-title">
        <h1>Báo cáo doanh thu</h1>
        <p class="subtitle">Thống kê vé theo thời gian và sự kiện</p>
    </div>
</div>

<form method="get" class="filter-row">
    <div class="filter-group">
        <label>Từ ngày</label>
        <input type="date" name="DateFrom" class="form-control"
               value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="filter-group">
        <label>Đến ngày</label>
        <input type="date" name="DateTo" class="form-control"
               value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
    </div>
    <button type="submit" class="btn btn-primary">Lọc</button>
    <a href="./RevenueReport" class="btn btn-secondary">Reset</a>
</form>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label">Tổng vé</div>
        <div class="stat-value">@Model.Report.TotalTickets</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Vé đã thanh toán</div>
        <div class="stat-value green">@Model.Report.PaidTickets</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Chưa thanh toán</div>
        <div class="stat-value red">@Model.Report.UnpaidTickets</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Tỷ lệ paid</div>
        <div class="stat-value gold">
            @(Model.Report.TotalTickets == 0 ? "0.0" :
              Math.Round((double)Model.Report.PaidTickets / Model.Report.TotalTickets * 100, 1).ToString("F1"))%
        </div>
    </div>
</div>

<div class="two-col">
    <div class="rpt-card">
        <div class="rpt-card-header">Vé paid theo tháng</div>
        <div class="rpt-card-body">
            @if (Model.Report.MonthlyBreakdown.Any())
            {
                <canvas id="revenueChart" height="260"></canvas>
            }
            else
            {
                <div class="empty-box">Không có dữ liệu trong khoảng thời gian này</div>
            }
        </div>
    </div>

    <div class="rpt-card">
        <div class="rpt-card-header">Top sự kiện</div>
        <table class="top-table">
            <thead>
                <tr>
                    <th>Sự kiện</th>
                    <th style="text-align:right">Vé paid</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (ev, i) in Model.Report.TopEvents.Select((e, idx) => (e, idx)))
                {
                    <tr>
                        <td style="display:flex;align-items:center">
                            <span class="rank-badge @(i >= 3 ? "dim" : "")">@(i+1)</span>
                            <span style="font-size:.84rem;color:var(--text-2)">@ev.EventName</span>
                        </td>
                        <td class="num-right">@ev.PaidCount</td>
                    </tr>
                }
                @if (!Model.Report.TopEvents.Any())
                {
                    <tr><td colspan="2" class="empty-box">Không có dữ liệu</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
    var canvas = document.getElementById('revenueChart');
    if (!canvas) return;
    var labels  = [@Html.Raw(string.Join(",", Model.Report.MonthlyBreakdown.Select(m => $"\"{m.Label}\"")))];
    var tickets = [@string.Join(",", Model.Report.MonthlyBreakdown.Select(m => m.Tickets))];
    new Chart(canvas, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Vé paid',
                data: tickets,
                backgroundColor: 'rgba(184,151,90,0.22)',
                borderColor: 'rgba(184,151,90,0.75)',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { labels: { color: 'rgba(250,248,244,.5)', font: { size: 12 } } }
            },
            scales: {
                x: {
                    ticks: { color: 'rgba(250,248,244,.38)', font: { size: 11 } },
                    grid:  { color: 'rgba(250,248,244,.04)' }
                },
                y: {
                    beginAtZero: true,
                    ticks: { color: 'rgba(250,248,244,.38)', font: { size: 11 } },
                    grid:  { color: 'rgba(250,248,244,.06)' }
                }
            }
        }
    });
})();
</script>
}
