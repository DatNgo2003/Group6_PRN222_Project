@page
@model Project_PRN222.Pages.Admin.Reports.RevenueReportModel
@{
    ViewData["Title"] = "Báo cáo tài chính";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    string Vnd(decimal v) => v == 0 ? "—" : v.ToString("N0") + " ₫";
    string VndShort(decimal v)
    {
        if (v == 0) return "—";
        if (v >= 1_000_000_000) return (v / 1_000_000_000m).ToString("F1") + " tỷ";
        if (v >= 1_000_000)     return (v / 1_000_000m).ToString("F0") + " tr";
        return v.ToString("N0");
    }
}

@section Styles {
<style>
    .filter-bar {
        background:var(--card-bg); border:1px solid var(--card-bdr);
        border-radius:var(--r-lg); padding:16px 20px; margin-bottom:24px;
        display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end;
    }
    .fg { display:flex; flex-direction:column; gap:5px; }
    .fg label { font-size:.7rem; font-weight:600; letter-spacing:.07em; text-transform:uppercase; color:var(--text-3); }
    .fg select { min-width:220px; }
    .fg input  { min-width:155px; }

    /* ── KPI grid ── */
    .kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
    @@media(max-width:1100px){ .kpi-grid{ grid-template-columns:repeat(2,1fr); } }
    @@media(max-width:600px) { .kpi-grid{ grid-template-columns:1fr; } }

    .kpi {
        background:var(--card-bg); border:1px solid var(--card-bdr);
        border-radius:var(--r-lg); padding:20px 22px; position:relative; overflow:hidden;
    }
    .kpi::before {
        content:''; position:absolute; top:0; left:0; right:0;
        height:2px; background:var(--kc,var(--c-gold)); opacity:.6;
    }
    .kpi-label { font-size:.68rem; font-weight:600; letter-spacing:.09em; text-transform:uppercase; color:var(--text-3); margin-bottom:10px; }
    .kpi-value { font-family:var(--ff-display); font-size:1.9rem; font-weight:700; line-height:1; color:var(--kc,var(--text-1)); }
    .kpi-sub   { font-size:.74rem; color:var(--text-3); margin-top:6px; }

    /* ── Budget status pills ── */
    .budget-status { display:flex; gap:10px; margin-top:10px; flex-wrap:wrap; }
    .bs-pill {
        display:flex; align-items:center; gap:6px;
        padding:5px 12px; border-radius:20px; font-size:.78rem; font-weight:600;
        border:1px solid transparent;
    }
    .bs-approved { background:rgba(74,154,122,.10); color:#6ee7b7; border-color:rgba(74,154,122,.20); }
    .bs-pending  { background:rgba(184,151,90,.10);  color:var(--c-gold); border-color:rgba(184,151,90,.20); }
    .bs-rejected { background:rgba(220,60,60,.08);   color:#f87171; border-color:rgba(220,60,60,.16); }

    /* ── Chart full-width ── */
    .chart-full { margin-bottom:24px; }

    .rpt-card { background:var(--card-bg); border:1px solid var(--card-bdr); border-radius:var(--r-lg); overflow:hidden; }
    .rpt-hdr  { padding:13px 20px; border-bottom:1px solid var(--card-bdr); font-size:.7rem; font-weight:600; letter-spacing:.09em; text-transform:uppercase; color:rgba(184,151,90,.55); background:rgba(0,0,0,.12); display:flex; justify-content:space-between; align-items:center; }
    .rpt-body { padding:20px; }

    /* ── Event finance table ── */
    .fin-table { width:100%; border-collapse:collapse; font-size:.845rem; }
    .fin-table th {
        padding:10px 16px; font-size:.68rem; font-weight:600; letter-spacing:.08em;
        text-transform:uppercase; color:var(--text-3);
        background:rgba(0,0,0,.12); border-bottom:1px solid var(--card-bdr); text-align:left;
    }
    .fin-table td { padding:12px 16px; border-bottom:1px solid var(--row-bdr); vertical-align:middle; }
    .fin-table tbody tr:last-child td { border-bottom:none; }
    .fin-table tbody tr:hover { background:var(--row-hover); }
    .fin-table th.r, .fin-table td.r { text-align:right; }

    .ev-name   { font-size:.855rem; font-weight:600; color:var(--text-1); }
    .ev-status { font-size:.74rem; color:var(--text-3); margin-top:2px; display:flex; align-items:center; gap:4px; }
    .sdot { display:inline-block; width:6px; height:6px; border-radius:50%; flex-shrink:0; }

    .money       { font-family:var(--ff-mono); font-size:.82rem; }
    .money-gold  { color:var(--c-gold); font-weight:600; }
    .money-green { color:#6ee7b7; }
    .money-red   { color:#f87171; }
    .money-dim   { color:var(--text-3); }

    .approval-badge {
        display:inline-block; padding:2px 9px; border-radius:20px;
        font-size:.7rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase;
    }
    .ap-approved { background:rgba(74,154,122,.10); color:#6ee7b7; }
    .ap-pending  { background:rgba(184,151,90,.10); color:var(--c-gold); }
    .ap-rejected { background:rgba(220,60,60,.08);  color:#f87171; }
    .ap-none     { background:rgba(250,248,244,.05); color:var(--text-3); }

    .empty-box { text-align:center; padding:48px 0; color:var(--text-3); font-size:.875rem; }
</style>
}

<div class="page-header">
    <div class="page-title">
        <h1>Báo cáo tài chính</h1>
        <p class="subtitle">Ngân sách · Doanh thu · Hợp đồng · Chi phí</p>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="fg">
        <label>Sự kiện</label>
        <select name="EventId" class="form-control">
            <option value="">— Tất cả sự kiện —</option>
            @foreach (SelectListItem item in Model.EventList)
            {
                <option value="@item.Value" selected="@(item.Selected)">
                    @item.Text
                </option>
            }
        </select>
    </div>
    <div class="fg">
        <label>Từ ngày (StartDate)</label>
        <input type="date" name="DateFrom" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="fg">
        <label>Đến ngày</label>
        <input type="date" name="DateTo" class="form-control" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary">Lọc</button>
    <a asp-page="RevenueReport" class="btn btn-secondary">Reset</a>
</form>

<div class="kpi-grid">
    <div class="kpi" style="--kc:var(--text-1)">
        <div class="kpi-label">Tổng ngân sách</div>
        <div class="kpi-value" style="font-size:1.5rem">@VndShort(Model.Report.TotalAllocated)</div>
        <div class="kpi-sub">@Model.Report.TotalEvents sự kiện</div>
        <div class="budget-status">
            <span class="bs-pill bs-approved">✓ @Model.Report.BudgetApproved Approved</span>
            <span class="bs-pill bs-pending">⏳ @Model.Report.BudgetPending Pending</span>
            @if (Model.Report.BudgetRejected > 0)
            {
                <span class="bs-pill bs-rejected">✕ @Model.Report.BudgetRejected Rejected</span>
            }
        </div>
    </div>
    <div class="kpi" style="--kc:#6ee7b7">
        <div class="kpi-label">Lợi nhuận</div>
        <div class="kpi-value" style="font-size:1.5rem">@VndShort(Model.Report.TotalProfit)</div>
        <div class="kpi-sub">Vé − Marketing − Logistics</div>
    </div>
    <div class="kpi" style="--kc:#93c5fd">
        <div class="kpi-label">Doanh thu vé</div>
        <div class="kpi-value" style="font-size:1.5rem">@VndShort(Model.Report.TotalTicketRevenue)</div>
        <div class="kpi-sub">Vé đã thanh toán (Paid)</div>
    </div>
    <div class="kpi" style="--kc:#f87171">
        <div class="kpi-label">Chi phí</div>
        <div class="kpi-value" style="font-size:1.5rem">@VndShort(Model.Report.TotalMarketing + Model.Report.TotalLogistics)</div>
        <div class="kpi-sub">
            Marketing: @VndShort(Model.Report.TotalMarketing) ·
            Logistics: @VndShort(Model.Report.TotalLogistics)
        </div>
    </div>
</div>

<div class="chart-full">
    <div class="rpt-card">
        <div class="rpt-hdr"><span>Tổng quan tài chính theo sự kiện</span></div>
        <div class="rpt-body">
            @if (Model.Report.EventFinances.Any())
            {
                <canvas id="overviewChart" height="100"></canvas>
            }
            else { <div class="empty-box">Không có dữ liệu</div> }
        </div>
    </div>
</div>

<div class="rpt-card">
    <div class="rpt-hdr"><span>Chi tiết tài chính theo sự kiện</span></div>
    <div style="overflow-x:auto">
        <table class="fin-table">
            <thead>
                <tr>
                    <th>Sự kiện</th>
                    <th class="r">Ngân sách</th>
                    <th class="r">Doanh thu vé</th>
                    <th class="r">Chi marketing</th>
                    <th class="r">Chi logistics</th>
                    <th class="r">Lợi nhuận</th>
                    <th class="r">Hợp đồng</th>
                    <th>Duyệt NS</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Report.EventFinances.Any())
                {
                    <tr><td colspan="8" class="empty-box">Không có dữ liệu</td></tr>
                }
                @foreach (var ev in Model.Report.EventFinances)
                {
                    var dotColor = ev.Status == "Completed" ? "#6ee7b7"
                                 : ev.Status == "Planning"  ? "var(--c-gold)"
                                 : "var(--text-3)";
                    var apClass  = ev.ApprovalStatus == "Approved" ? "ap-approved"
                                 : ev.ApprovalStatus == "Pending"  ? "ap-pending"
                                 : ev.ApprovalStatus == "Rejected" ? "ap-rejected"
                                 : "ap-none";
                    var profitClass = ev.Profit > 0 ? "money-green"
                                   : ev.Profit < 0 ? "money-red"
                                   : "money-dim";
                    <tr>
                        <td>
                            <div class="ev-name">@ev.EventName</div>
                            <div class="ev-status">
                                <span class="sdot" style="background:@dotColor"></span>@ev.Status
                            </div>
                        </td>
                        <td class="r money money-gold">@Vnd(ev.Allocated)</td>
                        <td class="r money money-dim">@Vnd(ev.TicketRevenue)</td>
                        <td class="r money money-dim">@Vnd(ev.Marketing)</td>
                        <td class="r money money-dim">@Vnd(ev.Logistics)</td>
                        <td class="r money @profitClass">@Vnd(ev.Profit)</td>
                        <td class="r money money-dim">@Vnd(ev.ContractValue)</td>
                        <td><span class="approval-badge @apClass">@ev.ApprovalStatus</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
    const gridColor = 'rgba(250,248,244,.05)';
    const tickColor = 'rgba(250,248,244,.35)';

    var oCanvas = document.getElementById('overviewChart');
    if (!oCanvas) return;

    var labels    = [@Html.Raw(string.Join(",", Model.Report.EventFinances.Select(e => $"\"{e.EventName}\"")))];
    var allocated = [@string.Join(",", Model.Report.EventFinances.Select(e => e.Allocated))];
    var ticket    = [@string.Join(",", Model.Report.EventFinances.Select(e => e.TicketRevenue))];
    var marketing = [@string.Join(",", Model.Report.EventFinances.Select(e => e.Marketing))];
    var logistics = [@string.Join(",", Model.Report.EventFinances.Select(e => e.Logistics))];
    var profit    = [@string.Join(",", Model.Report.EventFinances.Select(e => e.Profit))];
    var contract  = [@string.Join(",", Model.Report.EventFinances.Select(e => e.ContractValue))];

    new Chart(oCanvas, {
        type: 'bar',
        data: {
            labels,
            datasets: [
                { label: 'Ngân sách',      data: allocated, backgroundColor: 'rgba(184,151,90,0.20)',  borderColor: 'rgba(184,151,90,0.70)',  borderWidth:1, borderRadius:4 },
                { label: 'Doanh thu vé',   data: ticket,    backgroundColor: 'rgba(147,197,253,0.20)', borderColor: 'rgba(147,197,253,0.65)', borderWidth:1, borderRadius:4 },
                { label: 'Chi marketing',  data: marketing, backgroundColor: 'rgba(253,186,116,0.20)', borderColor: 'rgba(253,186,116,0.65)', borderWidth:1, borderRadius:4 },
                { label: 'Chi logistics',  data: logistics, backgroundColor: 'rgba(248,113,113,0.20)', borderColor: 'rgba(248,113,113,0.65)', borderWidth:1, borderRadius:4 },
                { label: 'Lợi nhuận',     data: profit,    backgroundColor: 'rgba(110,231,183,0.20)', borderColor: 'rgba(110,231,183,0.65)', borderWidth:1, borderRadius:4 },
                { label: 'Hợp đồng',      data: contract,  backgroundColor: 'rgba(196,181,253,0.20)', borderColor: 'rgba(196,181,253,0.65)', borderWidth:1, borderRadius:4 },
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { position: 'top', labels: { color: 'rgba(250,248,244,.55)', font: { size: 11 }, padding: 16 } },
                tooltip: { callbacks: { label: ctx => ' ' + ctx.dataset.label + ': ' + Number(ctx.raw).toLocaleString('vi-VN') + ' ₫' } }
            },
            scales: {
                x: { ticks: { color: tickColor, font: { size: 11 } }, grid: { color: gridColor } },
                y: {
                    beginAtZero: true,
                    ticks: { color: tickColor, font: { size: 11 }, callback: v => v === 0 ? '0' : (v / 1_000_000).toFixed(0) + 'M' },
                    grid: { color: gridColor }
                }
            }
        }
    });
})();
</script>
}
