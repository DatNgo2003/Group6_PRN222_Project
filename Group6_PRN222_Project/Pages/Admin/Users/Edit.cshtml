@page "{id:int}"
@model Project_PRN222.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Sửa người dùng";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    var isOtherAdmin = Model.IsOtherAdmin;
}

<div class="page-header">
    <div class="page-title">
        <h1>Sửa thông tin người dùng</h1>
        <p class="subtitle"><a asp-page="Index" class="back-link">← Danh sách người dùng</a></p>
    </div>
</div>

@if (isOtherAdmin)
{
    <div class="alert alert-danger">Không thể chỉnh sửa tài khoản Admin khác.</div>
    return;
}

<div class="form-card">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InputUser.UserId" />
        <input type="hidden" asp-for="InputUser.CreatedAt" />

        <div class="form-section">
            <h3 class="section-title">Thông tin tài khoản</h3>
            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="InputUser.Username">Username <span class="required">*</span></label>
                    <input asp-for="InputUser.Username" class="form-control" />
                    <span asp-validation-for="InputUser.Username" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="InputUser.FullName">Họ và tên</label>
                    <input asp-for="InputUser.FullName" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="InputUser.Email">Email</label>
                    <input asp-for="InputUser.Email" type="email" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="InputUser.RoleId">Vai trò <span class="required">*</span></label>
                    <select asp-for="InputUser.RoleId" asp-items="Model.RoleList" class="form-control">
                        <option value="">-- Chọn vai trò --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="InputUser.DepartmentId">Phòng ban</label>
                    <select asp-for="InputUser.DepartmentId" asp-items="Model.DepartmentList" class="form-control">
                        <option value="">-- Chọn phòng ban --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="InputUser.Status">Trạng thái <span class="required">*</span></label>
                    <select asp-for="InputUser.Status" class="form-control">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

            </div>
        </div>

        <div class="form-section">
            <h3 class="section-title">Đổi mật khẩu</h3>
            <p class="section-hint">Để trống nếu không muốn thay đổi mật khẩu</p>
            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <div class="password-input-wrap">
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Để trống = giữ nguyên" id="pwd" />
                        <button type="button" class="toggle-pwd" onclick="togglePwd('pwd', this)">Hiện</button>
                    </div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <div class="password-input-wrap">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" id="pwd2" />
                        <button type="button" class="toggle-pwd" onclick="togglePwd('pwd2', this)">Hiện</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-page="Index" class="btn btn-ghost">Huỷ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePwd(id, btn) {
            const input = document.getElementById(id);
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'Ẩn' : 'Hiện';
        }
    </script>
}

@section Styles {
    <style>
        .back-link {
            color: var(--accent);
            text-decoration: none;
            font-size: .9rem;
        }

            .back-link:hover {
                text-decoration: underline;
            }

        .form-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 0;
            overflow: hidden;
            max-width: 860px;
        }

        .form-section {
            padding: 28px 32px;
            border-bottom: 1px solid var(--border);
        }

            .form-section:last-of-type {
                border-bottom: none;
            }

        .section-title {
            font-size: .85rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 0 0 6px;
        }

        .section-hint {
            font-size: .82rem;
            color: var(--text-muted);
            margin: 0 0 16px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        @@media (max-width:600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .form-group label {
                font-size: .85rem;
                font-weight: 600;
                color: var(--text-primary);
            }

        .required {
            color: #e53e3e;
        }

        .password-input-wrap {
            display: flex;
        }

            .password-input-wrap .form-control {
                border-radius: 8px 0 0 8px;
                flex: 1;
            }

        .toggle-pwd {
            padding: 0 12px;
            background: var(--bg-muted);
            border: 1px solid var(--border);
            border-left: none;
            border-radius: 0 8px 8px 0;
            cursor: pointer;
            font-size: .8rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

            .toggle-pwd:hover {
                background: var(--border);
            }

        .field-error {
            color: #e53e3e;
            font-size: .8rem;
        }

        .form-actions {
            padding: 20px 32px;
            display: flex;
            gap: 12px;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: .9rem;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
}
