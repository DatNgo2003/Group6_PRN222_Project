@page
@model Project_PRN222.Pages.Admin.Config.EquipmentModel
@{
    ViewData["Title"] = "Quản lý thiết bị";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}
@section Styles {
<style>
.stat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:20px; }
.stat-card { background:var(--card-bg); border:1px solid var(--card-bdr); border-radius:var(--r-lg); padding:16px 20px; }
.stat-label { font-size:.72rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--text-3); margin-bottom:6px; }
.stat-value { font-family:var(--ff-display); font-size:1.8rem; font-weight:700; color:var(--text-1); }
.stat-value.green { color:#6ee7b7; } .stat-value.red { color:#f87171; } .stat-value.gold { color:var(--c-gold); }
.status-badge { display:inline-block; padding:3px 10px; border-radius:20px; font-size:.72rem; font-weight:600; }
.modal-backdrop { background:rgba(0,0,0,.55); padding:60px 24px; }
.modal-box { background:var(--card-bg); border:1px solid var(--card-bdr); border-radius:var(--r-lg); max-width:460px; margin:0 auto; overflow:hidden; }
.modal-header { padding:14px 22px; border-bottom:1px solid var(--card-bdr); font-size:.72rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:rgba(184,151,90,.55); background:rgba(0,0,0,.12); }
.modal-body { padding:22px; }
.form-group { display:flex; flex-direction:column; gap:6px; margin-bottom:16px; }
.form-group label { font-size:.79rem; font-weight:600; color:var(--text-2); }
.modal-footer { padding:14px 22px; border-top:1px solid var(--card-bdr); display:flex; gap:10px; background:rgba(0,0,0,.1); }
</style>
}

<div class="page-header">
    <div class="page-title">
        <h1>Quản lý thiết bị</h1>
        <p class="subtitle">Theo dõi kho thiết bị và trạng thái</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }

<div class="card">
    <div class="card-toolbar" style="display:flex; justify-content:space-between; align-items:center;">
        <div style="font-weight:600; color:var(--text-1);">Danh sách thiết bị</div>
        <button class="btn btn-primary" onclick="openModal()">+ Thêm thiết bị</button>
    </div>
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên thiết bị</th>
                    <th style="text-align:center">Total Owned</th>
                    <th style="text-align:center">Available</th>
                    <th style="text-align:center">Defective</th>
                    <th style="text-align:center">Outsourced</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eq in Model.Equipments)
                {
                    <tr>
                        <td class="id-cell">@eq.EquipmentId</td>
                        <td style="font-weight:600;color:var(--text-1)">@eq.EquipmentName</td>
                        <td style="text-align:center; font-weight:600;">@eq.TotalOwned</td>
                        <td style="text-align:center; color:#6ee7b7; font-weight:600;">@eq.AvailableQuantity</td>
                        <td style="text-align:center; color:#f87171; font-weight:600;">@eq.DefectiveQuantity</td>
                        <td style="text-align:center; color:var(--c-gold); font-weight:600;">@eq.OutsourcedQuantity</td>
                        <td class="action-cell">
                            <button class="btn-action btn-edit" onclick="openEditModal(@eq.EquipmentId,'@eq.EquipmentName',@eq.TotalOwned,@eq.AvailableQuantity,@eq.DefectiveQuantity,@eq.OutsourcedQuantity)">Sửa</button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@eq.EquipmentId" style="display:inline;" onsubmit="return confirm('Xác nhận xoá?');">
                                <button type="submit" class="btn-action btn-delete">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Equipments.Any())
                {
                    <tr><td colspan="7" style="text-align:center;padding:40px 0;color:var(--text-3)">Không có thiết bị nào</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="modal" style="display:none">
    <div class="modal-backdrop">
        <div class="modal-box">
            <div class="modal-header" id="modal-title">Thêm thiết bị</div>
            <form method="post" id="modal-form">
                <input type="hidden" name="Input.EquipmentId" id="f-id" value="0" />
                <div class="modal-body">
                    <div class="form-group">
                        <label>Tên thiết bị <span class="required">*</span></label>
                        <input class="form-control" name="Input.EquipmentName" id="f-name" required />
                    </div>
                    <div class="form-group">
                        <label>Tương đương giá mua/thuê dự kiến</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="Input.UnitPrice" id="f-price" value="0" />
                    </div>
                    <div class="form-group">
                        <label>Tổng sở hữu (Total Owned)</label>
                        <input type="number" min="0" class="form-control" name="Input.TotalOwned" id="f-total" value="0" />
                    </div>
                    <div class="form-group">
                        <label>Tồn kho hiện khả dụng (Available)</label>
                        <input type="number" min="0" class="form-control" name="Input.AvailableQuantity" id="f-avai" value="0" />
                    </div>
                    <div class="form-group">
                        <label>Số lượng hỏng (Defective)</label>
                        <input type="number" min="0" class="form-control" name="Input.DefectiveQuantity" id="f-defective" value="0" />
                    </div>
                    <div class="form-group">
                        <label>Số lượng mượn ngoài (Outsourced)</label>
                        <input type="number" min="0" class="form-control" name="Input.OutsourcedQuantity" id="f-outsourced" value="0" readonly />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Lưu</button>
                    <button type="button" class="btn btn-secondary" onclick="closeModal()">Huỷ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openModal() {
    document.getElementById('f-id').value='0';
    document.getElementById('f-name').value='';
    document.getElementById('f-price').value='0';
    document.getElementById('f-total').value='0';
    document.getElementById('f-avai').value='0';
    document.getElementById('f-defective').value='0';
    document.getElementById('f-outsourced').value='0';
    document.getElementById('modal-title').textContent='Thêm thiết bị';
    document.getElementById('modal-form').action='?handler=Create';
    document.getElementById('modal').style.display='block';
}
function openEditModal(id,name,total,avai,defective,outsourced) {
    document.getElementById('f-id').value=id;
    document.getElementById('f-name').value=name;
    document.getElementById('f-total').value=total;
    document.getElementById('f-avai').value=avai;
    document.getElementById('f-defective').value=defective;
    document.getElementById('f-outsourced').value=outsourced;
    document.getElementById('modal-title').textContent='Sửa thiết bị';
    document.getElementById('modal-form').action='?handler=Edit';
    document.getElementById('modal').style.display='block';
}
function closeModal() { document.getElementById('modal').style.display='none'; }
</script>
}
