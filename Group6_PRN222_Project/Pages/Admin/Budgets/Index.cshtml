@page
@model Project_PRN222.Pages.Admin.Budgets.IndexModel
@{
    ViewData["Title"] = "Duyệt ngân sách";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        @@media (max-width: 700px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--card-bdr);
            border-radius: var(--r-lg);
            padding: 18px 22px;
            cursor: pointer;
            transition: border-color var(--tr);
            text-decoration: none;
            display: block;
        }

            .stat-card:hover {
                border-color: rgba(184,151,90,.28);
            }

            .stat-card.active-filter {
                border-color: var(--c-gold);
            }

        .stat-label {
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--text-3);
            margin-bottom: 8px;
        }

        .stat-value {
            font-family: var(--ff-display);
            font-size: 2rem;
            font-weight: 700;
            line-height: 1;
            color: var(--text-1);
        }

            .stat-value.gold {
                color: var(--c-gold);
            }

            .stat-value.green {
                color: #6ee7b7;
            }

            .stat-value.red {
                color: #f87171;
            }

        .filter-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-pill {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: .79rem;
            font-weight: 600;
            border: 1px solid var(--card-bdr);
            background: transparent;
            color: var(--text-3);
            cursor: pointer;
            text-decoration: none;
            transition: background var(--tr), color var(--tr), border-color var(--tr);
        }

            .filter-pill:hover {
                background: var(--sidebar-hover);
                color: var(--text-2);
            }

            .filter-pill.active {
                background: var(--c-gold-pale);
                color: var(--c-gold);
                border-color: rgba(184,151,90,.35);
            }

        .budget-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .855rem;
        }

            .budget-table th {
                padding: 11px 16px;
                text-align: left;
                font-size: .68rem;
                font-weight: 600;
                letter-spacing: .08em;
                text-transform: uppercase;
                color: var(--text-3);
                background: var(--table-head);
                border-bottom: 1px solid var(--card-bdr);
            }

            .budget-table td {
                padding: 13px 16px;
                border-bottom: 1px solid var(--row-bdr);
                vertical-align: middle;
            }

            .budget-table tbody tr:last-child td {
                border-bottom: none;
            }

            .budget-table tbody tr:hover {
                background: var(--row-hover);
            }

        .mono {
            font-family: var(--ff-mono);
            font-size: .8rem;
            color: var(--text-3);
        }

        .event-name {
            font-weight: 600;
            color: var(--text-1);
            font-size: .875rem;
        }

        .organizer {
            font-size: .78rem;
            color: var(--text-3);
            margin-top: 2px;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 11px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .status-pending {
            background: rgba(184,151,90,.12);
            color: var(--c-gold);
        }

        .status-approved {
            background: rgba(74,154,122,.12);
            color: #6ee7b7;
        }

        .status-rejected {
            background: rgba(220,60,60,.09);
            color: #f87171;
        }

        .money {
            font-family: var(--ff-mono);
            font-size: .82rem;
            color: var(--text-1);
        }

        .money-dim {
            font-family: var(--ff-mono);
            font-size: .8rem;
            color: var(--text-3);
        }

        .action-group {
            display: flex;
            gap: 6px;
        }

        .btn-approve {
            padding: 5px 13px;
            border-radius: var(--r-sm);
            font-size: .775rem;
            font-weight: 600;
            border: 1px solid rgba(74,154,122,.25);
            background: rgba(74,154,122,.10);
            color: #6ee7b7;
            cursor: pointer;
            font-family: var(--ff-body);
            transition: opacity var(--tr);
        }

            .btn-approve:hover {
                opacity: .75;
            }

        .btn-reject {
            padding: 5px 13px;
            border-radius: var(--r-sm);
            font-size: .775rem;
            font-weight: 600;
            border: 1px solid rgba(220,60,60,.18);
            background: rgba(220,60,60,.09);
            color: #f87171;
            cursor: pointer;
            font-family: var(--ff-body);
            transition: opacity var(--tr);
        }

            .btn-reject:hover {
                opacity: .75;
            }

        .btn-detail {
            padding: 5px 13px;
            border-radius: var(--r-sm);
            font-size: .775rem;
            font-weight: 500;
            border: 1px solid var(--card-bdr);
            background: transparent;
            color: var(--text-3);
            text-decoration: none;
            transition: opacity var(--tr);
        }

            .btn-detail:hover {
                opacity: .75;
                color: var(--text-2);
            }

        .empty-box {
            text-align: center;
            padding: 52px 0;
            color: var(--text-3);
            font-size: .875rem;
        }
    </style>
}

<div class="page-header">
    <div class="page-title">
        <h1>Duyệt ngân sách</h1>
        <p class="subtitle">Xem xét và phê duyệt đề xuất ngân sách từ Organizer</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="stat-grid">
    <a href="?StatusFilter=All" class="stat-card @(Model.StatusFilter == "All" ? "active-filter" : "")">
        <div class="stat-label">Tổng ngân sách</div>
        <div class="stat-value">@(Model.PendingCount + Model.ApprovedCount + Model.RejectedCount)</div>
    </a>
    <a href="?StatusFilter=Pending" class="stat-card @(Model.StatusFilter == "Pending" ? "active-filter" : "")">
        <div class="stat-label">Chờ duyệt</div>
        <div class="stat-value gold">@Model.PendingCount</div>
    </a>
    <a href="?StatusFilter=Approved" class="stat-card @(Model.StatusFilter == "Approved" ? "active-filter" : "")">
        <div class="stat-label">Đã duyệt</div>
        <div class="stat-value green">@Model.ApprovedCount</div>
    </a>
</div>

<div class="filter-bar">
    <a href="?StatusFilter=All" class="filter-pill @(Model.StatusFilter == "All" ? "active" : "")">Tất cả</a>
    <a href="?StatusFilter=Pending" class="filter-pill @(Model.StatusFilter == "Pending" ? "active" : "")">Chờ duyệt</a>
    <a href="?StatusFilter=Approved" class="filter-pill @(Model.StatusFilter == "Approved" ? "active" : "")">Đã duyệt</a>
    <a href="?StatusFilter=Rejected" class="filter-pill @(Model.StatusFilter == "Rejected" ? "active" : "")">Đã từ chối</a>
</div>

<div class="card">
    <div class="card-toolbar">
        <span style="font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:rgba(184,151,90,.55)">
            Danh sách ngân sách
        </span>
        <span class="record-count">@Model.Budgets.Count bản ghi</span>
    </div>
    <div class="table-wrapper">
        <table class="budget-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Sự kiện / Organizer</th>
                    <th>Tổng NS</th>
                    <th>Trạng thái</th>
                    <th>Duyệt bởi</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Budgets)
                {
                    var statusClass = b.ApprovalStatus switch
                    {
                                "Approved" => "status-approved",
                                "Rejected" => "status-rejected",
                        _ => "status-pending"
                    };

                    <tr>
                        <td class="mono">@b.BudgetId</td>
                        <td>
                            <div class="event-name">@b.EventName</div>
                            @if (b.OrganizerName != null)
                            {
                                <div class="organizer">👤 @b.OrganizerName</div>
                            }
                            @if (b.EventStartDate.HasValue)
                            {
                                <div class="organizer">📅 @b.EventStartDate.Value.ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                        <td class="money">@b.TotalAllocated.ToString("N0")</td>
                        <td>
                            <span class="status-badge @statusClass">@b.ApprovalStatus</span>
                        </td>
                        <td class="money-dim">@(b.ApprovedByName ?? "—")</td>
                        <td>
                            <div class="action-group">
                                <a asp-page="./Detail" asp-route-id="@b.BudgetId"
                                   class="btn-detail">Chi tiết</a>

                                @if (b.ApprovalStatus == "Pending")
                                {
                                    <form method="post" asp-page-handler="Approve"
                                          style="display:inline"
                                          onsubmit="return confirm('Duyệt ngân sách #@b.BudgetId?')">
                                        <input type="hidden" name="id" value="@b.BudgetId" />
                                        <button type="submit" class="btn-approve">Duyệt</button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject"
                                          style="display:inline"
                                          onsubmit="return confirm('Từ chối ngân sách #@b.BudgetId?')">
                                        <input type="hidden" name="id" value="@b.BudgetId" />
                                        <button type="submit" class="btn-reject">Từ chối</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Budgets.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-box">
                            Không có ngân sách nào @(Model.StatusFilter != "All" ? $"ở trạng thái {Model.StatusFilter}" : "")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
