============================================= -->
<section class="section" id="events" style="background:var(--c-ivory)">
    <div class="container">
        <div class="events-header">
            <div>
                <div class="section__label">Sự kiện nổi bật</div>
                <h2 class="section__title">Sắp diễn ra</h2>
            </div>
            <a asp-page="EventList" class="btn btn-ghost">
                Xem tất cả
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
            </a>
        </div>

        <div class="events-grid">
            @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
            {
                string[] themes = { "theme-1", "theme-2", "theme-3", "theme-4", "theme-5", "theme-6" };
                int ti = 0;
                foreach (var ev in Model.UpcomingEvents)
                {
                    string theme = themes[ti % themes.Length]; ti++;
                    <a asp-page="/Events/EventDetail" asp-route-id="@ev.EventId" class="event-card">
                        <div class="event-card__thumb">
                            <div class="event-card__thumb-bg @theme"></div>
                            <div class="event-card__status">
                                @{
                                    var badgeClass = ev.Status switch
                                    {
                                        "Active" => "badge-green",
                                        "Planning" => "badge-blue",
                                        "Closed" => "badge-gray",
                                        "Completed" => "badge-gray",
                                        _ => "badge-gray"
                                    };
                                    var badgeText = ev.Status switch
                                    {
                                        "Active" => "Đang mở",
                                        "Planning" => "Chuẩn bị",
                                        "Closed" => "Đã đóng",
                                        "Completed" => "Đã kết thúc",
                                        _ => ev.Status
                                    };
                                }
                                <span class="badge @badgeClass">@badgeText</span>
                            </div>
                            <div class="event-card__date-badge">
                                @ev.StartDate?.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        <div class="event-card__body">
                            <div class="event-card__title">@ev.EventName</div>
                            <div class="event-card__location">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                                @(ev.Location ?? "Chưa xác định")
                            </div>
                            <div class="event-card__footer">
                                <div class="event-card__organizer">
                                    Tổ chức bởi: <strong>@(ev.Organizer?.FullName ?? "N/A")</strong>
                                </div>
                                <div class="event-card__arrow">
                                    <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="events-empty">
                    <div class="events-empty__icon">📅</div>
                    <div class="events-empty__title">Chưa có sự kiện nào</div>
                    <p style="color:var(--c-ink-60);font-size:14px">Các sự kiện sắp tới sẽ hiển thị tại đây.</p>
                </div>
            }
        </div>
    </div>
</section>

