@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["ActivePage"] = "Home";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* =============================================
           HERO
        ============================================= */
        .hero {
            position: relative;
            min-height: calc(100vh - 68px);
            display: flex;
            align-items: center;
            overflow: hidden;
            background: var(--c-ivory);
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(var(--c-sand) 1px, transparent 1px), linear-gradient(90deg, var(--c-sand) 1px, transparent 1px);
                background-size: 48px 48px;
                opacity: .40;
                pointer-events: none;
            }

            .hero::after {
                content: '';
                position: absolute;
                top: -80px;
                right: -120px;
                width: 700px;
                height: 700px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(184,151,90,.13) 0%, transparent 70%);
                pointer-events: none;
            }

        .hero__inner {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 80px 40px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            width: 100%;
        }

        .hero__tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--c-gold-pale);
            color: #8B6020;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 100px;
            margin-bottom: 28px;
            border: 1px solid rgba(184,151,90,.25);
        }

        .hero__tag-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--c-gold);
            animation: heroPulse 2s ease-in-out infinite;
        }

        @@keyframes heroPulse {
            0%, 100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: .5;
                transform: scale(1.35);
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        @@keyframes barGrow {
            from {
                width: 0
            }

            to {
                width: 68%
            }
        }

        .hero__title {
            font-family: var(--ff-display);
            font-size: clamp(44px, 5.5vw, 76px);
            font-weight: 700;
            line-height: 1.05;
            letter-spacing: -1.5px;
            color: var(--c-ink);
            margin-bottom: 24px;
        }

            .hero__title em {
                font-style: normal;
                color: var(--c-gold);
                position: relative;
            }

                .hero__title em::after {
                    content: '';
                    position: absolute;
                    bottom: 4px;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: var(--c-gold);
                    border-radius: 2px;
                    opacity: .35;
                }

        .hero__desc {
            font-size: 17px;
            color: var(--c-ink-60);
            line-height: 1.75;
            max-width: 480px;
            margin-bottom: 40px;
        }

        .hero__cta {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .hero__trust {
            margin-top: 52px;
            display: flex;
            align-items: center;
            gap: 28px;
            padding-top: 28px;
            border-top: 1px solid var(--c-sand);
        }

        .hero__trust-item {
            display: flex;
            flex-direction: column;
        }

        .hero__trust-number {
            font-family: var(--ff-display);
            font-size: 30px;
            font-weight: 700;
            color: var(--c-ink);
            line-height: 1;
        }

        .hero__trust-label {
            font-size: 12px;
            color: var(--c-ink-60);
            margin-top: 3px;
        }

        .hero__trust-sep {
            width: 1px;
            height: 36px;
            background: var(--c-sand);
        }

        /* Hero visual */
        .hero__visual {
            position: relative;
            animation: fadeUp .9s ease both;
        }

        .hero__card-stack {
            position: relative;
        }

        .hero__card-back {
            position: absolute;
            inset: 0;
            background: var(--c-cream);
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-xl);
            transform: rotate(3deg) translateY(10px);
            z-index: 1;
        }

        .hero__card-main {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-xl);
            padding: 28px;
            box-shadow: var(--shadow-lg);
            position: relative;
            z-index: 2;
        }

        .event-preview-img {
            width: 100%;
            height: 175px;
            background: linear-gradient(135deg, var(--c-accent) 0%, #4A7A6A 50%, var(--c-gold) 100%);
            border-radius: var(--radius-lg);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .event-preview-img::before {
                content: '';
                position: absolute;
                inset: 0;
                background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
            }

        .event-preview-label {
            font-family: var(--ff-display);
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            position: relative;
            z-index: 1;
            text-align: center;
            text-shadow: 0 2px 8px rgba(0,0,0,.2);
        }

        .event-preview-meta {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .event-preview-name {
            font-weight: 600;
            font-size: 16px;
            color: var(--c-ink);
        }

        .event-preview-date {
            font-size: 13px;
            color: var(--c-ink-60);
            margin-top: 2px;
        }

        .event-preview-bar {
            height: 4px;
            background: var(--c-cream);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 16px;
        }

        .event-preview-bar-fill {
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, var(--c-accent), var(--c-gold));
            border-radius: 2px;
            animation: barGrow 1.5s .5s ease forwards;
        }

        .event-preview-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 6px;
            font-size: 12px;
            color: var(--c-ink-60);
        }

        .hero__floating-badge {
            position: absolute;
            top: -18px;
            right: -18px;
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            box-shadow: var(--shadow-md);
            z-index: 3;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: float 3s ease-in-out infinite;
        }

        .hero__floating-icon {
            width: 32px;
            height: 32px;
            border-radius: var(--radius-sm);
            background: var(--c-gold-pale);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .hero__floating-text strong {
            display: block;
            font-size: 14px;
            font-weight: 600;
        }

        .hero__floating-text span {
            font-size: 11px;
            color: var(--c-ink-60);
        }

        /* =============================================
           STATS BAND
        ============================================= */
        .stats-band {
            background: var(--c-ink);
        }

        .stats-band__inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
        }

        .stats-band__item {
            padding: 44px 32px;
            border-right: 1px solid rgba(250,248,244,.07);
            transition: background var(--transition);
        }

            .stats-band__item:last-child {
                border-right: none;
            }

            .stats-band__item:hover {
                background: rgba(250,248,244,.03);
            }

        .stats-band__number {
            font-family: var(--ff-display);
            font-size: 52px;
            font-weight: 700;
            color: var(--c-gold);
            line-height: 1;
            letter-spacing: -1px;
            margin-bottom: 6px;
        }

        .stats-band__label {
            font-size: 13px;
            color: rgba(250,248,244,.5);
        }

        .stats-band__sub {
            font-size: 11px;
            color: rgba(250,248,244,.28);
            margin-top: 2px;
        }

        /* =============================================
           EVENTS SECTION
        ============================================= */
        .events-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 48px;
            gap: 20px;
            flex-wrap: wrap;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .event-card {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-lg);
            overflow: hidden;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: block;
            transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
        }

            .event-card:hover {
                transform: translateY(-6px);
                box-shadow: var(--shadow-lg);
                border-color: var(--c-taupe);
            }

        .event-card__thumb {
            height: 200px;
            position: relative;
            overflow: hidden;
        }

        .event-card__thumb-bg {
            position: absolute;
            inset: 0;
            transition: transform .5s ease;
        }

        .event-card:hover .event-card__thumb-bg {
            transform: scale(1.05);
        }

        .theme-1 {
            background: linear-gradient(135deg, #2C4A3E 0%, #4A7A6A 60%, #B8975A 100%);
        }

        .theme-2 {
            background: linear-gradient(135deg, #3A2A5A 0%, #6A4A9A 60%, #D4B882 100%);
        }

        .theme-3 {
            background: linear-gradient(135deg, #5A2A1E 0%, #9A4A3A 60%, #E8975A 100%);
        }

        .theme-4 {
            background: linear-gradient(135deg, #1A3A5A 0%, #2A6A9A 60%, #B8D4F0 100%);
        }

        .theme-5 {
            background: linear-gradient(135deg, #3A4A1E 0%, #6A7A3A 60%, #C8C875 100%);
        }

        .theme-6 {
            background: linear-gradient(135deg, #4A1A3A 0%, #9A3A7A 60%, #F0B8D4 100%);
        }

        .event-card__status {
            position: absolute;
            top: 14px;
            left: 14px;
            z-index: 1;
        }

        .event-card__date-badge {
            position: absolute;
            bottom: 14px;
            right: 14px;
            background: rgba(26,23,20,.55);
            backdrop-filter: blur(8px);
            color: #fff;
            font-size: 12px;
            font-weight: 500;
            padding: 5px 10px;
            border-radius: var(--radius-sm);
            z-index: 1;
        }

        .event-card__body {
            padding: 22px 24px 24px;
        }

        .event-card__title {
            font-family: var(--ff-display);
            font-size: 20px;
            font-weight: 600;
            line-height: 1.25;
            margin-bottom: 8px;
            letter-spacing: -.2px;
            color: var(--c-ink);
        }

        .event-card__location {
            font-size: 13px;
            color: var(--c-ink-60);
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 16px;
        }

        .event-card__footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 16px;
            border-top: 1px solid var(--c-sand);
        }

        .event-card__organizer {
            font-size: 12px;
            color: var(--c-ink-60);
        }

            .event-card__organizer strong {
                color: var(--c-ink);
                font-weight: 500;
            }

        .event-card__arrow {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--c-cream);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition), transform var(--transition);
            flex-shrink: 0;
        }

        .event-card:hover .event-card__arrow {
            background: var(--c-gold);
            transform: translateX(3px);
        }

        .event-card__arrow svg {
            width: 13px;
            height: 13px;
            fill: none;
            stroke: var(--c-ink);
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .event-card:hover .event-card__arrow svg {
            stroke: #fff;
        }

        .events-empty {
            grid-column: 1/-1;
            text-align: center;
            padding: 60px 20px;
        }

        .events-empty__icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .events-empty__title {
            font-family: var(--ff-display);
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        /* =============================================
           ABOUT SECTION
        ============================================= */
        .about-section {
            background: var(--c-ivory);
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .about-features {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 36px;
        }

        .about-feature {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 20px;
            background: var(--c-cream);
            border-radius: var(--radius-md);
            border: 1px solid var(--c-sand);
            transition: border-color var(--transition), box-shadow var(--transition);
        }

            .about-feature:hover {
                border-color: var(--c-taupe);
                box-shadow: var(--shadow-sm);
            }

        .about-feature__icon {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            border-radius: var(--radius-sm);
            background: var(--c-gold-pale);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .about-feature__title {
            font-weight: 600;
            font-size: 15px;
            margin-bottom: 4px;
        }

        .about-feature__desc {
            font-size: 13px;
            color: var(--c-ink-60);
            line-height: 1.6;
        }

        .about-main-card {
            background: var(--c-ink);
            border-radius: var(--radius-xl);
            padding: 36px;
            color: var(--c-ivory);
        }

        .about-role-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 20px;
        }

        .about-role-item {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(250,248,244,.06);
            padding: 12px 16px;
            border-radius: var(--radius-md);
            font-size: 14px;
            transition: background var(--transition);
        }

            .about-role-item:hover {
                background: rgba(250,248,244,.10);
            }

            .about-role-item .role-name {
                flex: 1;
            }

            .about-role-item .role-desc {
                font-size: 12px;
                color: rgba(250,248,244,.45);
            }

        .about-role-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* =============================================
           CTA / NEWSLETTER
        ============================================= */
        .cta-band {
            background: var(--c-cream);
            border-top: 1px solid var(--c-sand);
            border-bottom: 1px solid var(--c-sand);
        }

        .cta-band__inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 80px 40px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .cta-subscribe-row {
            display: flex;
            gap: 10px;
            margin-top: 28px;
        }

            .cta-subscribe-row .form-input {
                flex: 1;
                background: #fff;
            }

        .cta-feature-card {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-lg);
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: border-color var(--transition);
        }

            .cta-feature-card:hover {
                border-color: var(--c-taupe);
            }

            .cta-feature-card + .cta-feature-card {
                margin-top: 14px;
            }

        .cta-feature-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            background: var(--c-gold-pale);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .cta-feature-title {
            font-weight: 600;
            font-size: 15px;
        }

        .cta-feature-desc {
            font-size: 13px;
            color: var(--c-ink-60);
            margin-top: 2px;
        }

        /* =============================================
           CONTACT SECTION
        ============================================= */
        .contact-section {
            background: var(--c-ivory);
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: start;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 18px;
            margin-top: 32px;
        }

        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 14px;
            color: var(--c-ink-60);
        }

        .contact-info-icon {
            width: 38px;
            height: 38px;
            border-radius: var(--radius-sm);
            background: var(--c-gold-pale);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .contact-form {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-xl);
            padding: 36px;
        }

            .contact-form .form-group {
                margin-bottom: 18px;
            }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        textarea.form-input {
            resize: vertical;
            min-height: 100px;
        }

        /* =============================================
           AUTH MODAL
        ============================================= */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(26,23,20,.5);
            backdrop-filter: blur(5px);
            z-index: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity .2s ease;
        }

            .modal-overlay.open {
                opacity: 1;
                pointer-events: all;
            }

        .modal-box {
            background: #fff;
            border-radius: var(--radius-xl);
            width: 100%;
            max-width: 460px;
            margin: 20px;
            box-shadow: 0 24px 80px rgba(26,23,20,.18);
            overflow: hidden;
            transform: translateY(24px) scale(.97);
            transition: transform .25s cubic-bezier(.34,1.56,.64,1);
            position: relative;
        }

        .modal-overlay.open .modal-box {
            transform: translateY(0) scale(1);
        }

        .modal-close {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--c-cream);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: var(--c-ink-60);
            transition: background var(--transition);
            z-index: 1;
            line-height: 1;
        }

            .modal-close:hover {
                background: var(--c-sand);
            }

        .modal-tabs {
            display: flex;
            border-bottom: 1px solid var(--c-sand);
        }

        .modal-tab {
            flex: 1;
            padding: 18px;
            font-size: 15px;
            font-weight: 500;
            text-align: center;
            cursor: pointer;
            border: none;
            background: none;
            color: var(--c-ink-60);
            transition: all var(--transition);
            font-family: var(--ff-body);
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
        }

            .modal-tab.active {
                color: var(--c-ink);
                border-bottom-color: var(--c-gold);
            }

        .modal-body {
            padding: 32px;
        }

        .modal-panel {
            display: none;
        }

            .modal-panel.active {
                display: block;
            }

        .modal-title {
            font-family: var(--ff-display);
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 4px;
            letter-spacing: -.3px;
        }

        .modal-subtitle {
            font-size: 14px;
            color: var(--c-ink-60);
            margin-bottom: 26px;
        }

        .modal-form .form-group {
            margin-bottom: 16px;
        }

        .modal-footer {
            text-align: center;
            margin-top: 18px;
            font-size: 13px;
            color: var(--c-ink-60);
        }

            .modal-footer a {
                color: var(--c-gold);
                font-weight: 500;
                cursor: pointer;
                text-decoration: underline;
            }

        /* =============================================
           RESPONSIVE
        ============================================= */
        @@media (max-width: 1024px) {
            .hero__inner {
                gap: 48px;
            }

            .events-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .about-grid {
                gap: 48px;
            }

            .cta-band__inner {
                gap: 48px;
            }

            .contact-grid {
                gap: 48px;
            }
        }

        @@media (max-width: 768px) {
            .hero__inner {
                grid-template-columns: 1fr;
                padding: 60px 20px;
            }

            .hero__visual {
                display: none;
            }

            .stats-band__inner {
                grid-template-columns: 1fr 1fr;
                padding: 0 20px;
            }

            .stats-band__item {
