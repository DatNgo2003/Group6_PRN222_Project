@page "/Account/MyTickets"
@model Group6_PRN222_Project.Pages.Account.MyTicketsModel
@{
    ViewData["Title"] = "Vé của tôi";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
<style>
/* ── Page Hero ─────────────────────────────────── */
.mytickets-hero {
    background: var(--c-ink);
    padding: 44px 0;
}
.mytickets-hero__inner {
    max-width: 1200px; margin: 0 auto; padding: 0 40px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
}
.mytickets-hero__left { display: flex; align-items: center; gap: 16px; }
.mytickets-hero__icon {
    width: 52px; height: 52px;
    background: rgba(184,151,90,.2);
    border: 1px solid rgba(184,151,90,.3);
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center; font-size: 24px;
}
.mytickets-hero__title {
    font-family: var(--ff-display);
    font-size: 28px; font-weight: 700;
    color: var(--c-ivory); margin-bottom: 3px;
}
.mytickets-hero__sub { font-size: 13px; color: rgba(250,248,244,.45); }

/* ── Filter Tabs ───────────────────────────────── */
.filter-tabs {
    display: flex; align-items: center; gap: 6px;
    flex-wrap: wrap;
}
.filter-tab {
    padding: 8px 18px;
    border: 1.5px solid var(--c-sand);
    border-radius: 100px;
    font-size: 13px; font-weight: 500;
    color: var(--c-ink-60); text-decoration: none;
    transition: all var(--transition);
    background: #fff;
}
.filter-tab:hover { border-color: var(--c-taupe); color: var(--c-ink); }
.filter-tab.active {
    background: var(--c-ink); border-color: var(--c-ink);
    color: var(--c-ivory);
}
.filter-tab.active-valid      { background: var(--c-success); border-color: var(--c-success); color: #fff; }
.filter-tab.active-used       { background: var(--c-info); border-color: var(--c-info); color: #fff; }
.filter-tab.active-cancelled  { background: var(--c-danger); border-color: var(--c-danger); color: #fff; }

/* ── Ticket Card ───────────────────────────────── */
.tickets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(600px, 1fr));
    gap: 20px;
}

.ticket-card {
    background: #fff;
    border: 1px solid var(--c-sand);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: box-shadow var(--transition);
    display: grid;
    grid-template-columns: 1fr auto;
}
.ticket-card:hover { box-shadow: var(--shadow-md); }

/* Status border left */
.ticket-card.status-valid      { border-left: 4px solid var(--c-success); }
.ticket-card.status-used       { border-left: 4px solid var(--c-info); }
.ticket-card.status-cancelled  { border-left: 4px solid var(--c-danger); }
.ticket-card.status-pending    { border-left: 4px solid var(--c-gold); }

/* Left: ticket info */
.ticket-card__left { padding: 24px 24px 24px 28px; }

.ticket-card__event-thumb {
    height: 80px; border-radius: var(--radius-md);
    margin-bottom: 16px; position: relative; overflow: hidden;
}
.ticket-card__event-thumb-bg {
    position: absolute; inset: 0;
}

.ticket-card__header {
    display: flex; align-items: flex-start;
    justify-content: space-between; gap: 12px; margin-bottom: 12px;
}
.ticket-card__event-name {
    font-family: var(--ff-display);
    font-size: 20px; font-weight: 600;
    color: var(--c-ink); line-height: 1.2;
}

.ticket-card__meta {
    display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px;
}
.ticket-card__meta-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--c-ink-60);
}
.ticket-card__meta-item svg {
    width: 14px; height: 14px; flex-shrink: 0;
    color: var(--c-gold);
}

.ticket-card__footer {
    display: flex; align-items: center; gap: 12px;
    padding-top: 14px; border-top: 1px solid var(--c-sand);
    flex-wrap: wrap;
}

/* Ticket type & price pills */
.ticket-type-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 100px;
    font-size: 12px; font-weight: 600;
}
.pill-standard    { background: #E8F2EC; color: #1A5A30; }
.pill-vip         { background: var(--c-gold-pale); color: #8B6020; }
.pill-student     { background: #E4EDF8; color: #1A3A6B; }
.pill-comp        { background: #FAE8E4; color: #7A2A1A; }

.payment-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 100px;
    font-size: 12px; font-weight: 500;
}
.payment-paid    { background: #E8F2EC; color: #1A5A30; }
.payment-pending { background: #FEF3CD; color: #856404; }

.ticket-price {
    font-family: var(--ff-display);
    font-size: 18px; font-weight: 700;
    color: var(--c-gold); margin-left: auto;
}

/* Cancel btn */
.btn-cancel {
    padding: 7px 14px; font-size: 12px;
    border: 1.5px solid #F5C4B3;
    border-radius: var(--radius-sm);
    color: var(--c-danger); background: #FAE8E4;
    cursor: pointer; font-family: var(--ff-body); font-weight: 500;
    transition: all var(--transition);
}
.btn-cancel:hover { background: var(--c-danger); color: #fff; border-color: var(--c-danger); }

/* Right: QR section */
.ticket-card__right {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 24px 28px;
    border-left: 1px dashed var(--c-sand);
    background: var(--c-cream);
    min-width: 160px;
    position: relative;
}
/* Notch cutout effect */
.ticket-card__right::before,
.ticket-card__right::after {
    content: '';
    position: absolute; left: -12px;
    width: 24px; height: 24px;
    background: var(--c-ivory);
    border-radius: 50%;
    border: 1px solid var(--c-sand);
}
.ticket-card__right::before { top: -12px; }
.ticket-card__right::after  { bottom: -12px; }

.qr-wrapper {
    width: 110px; height: 110px;
    background: #fff;
    border: 1px solid var(--c-sand);
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 10px;
    overflow: hidden;
    position: relative;
}
.qr-wrapper canvas { display: block; }

.ticket-id {
    font-size: 10px; color: var(--c-ink-60);
    letter-spacing: .5px; text-align: center;
    font-weight: 500; margin-bottom: 8px;
}

/* Cancelled overlay */
.qr-cancelled-overlay {
    position: absolute; inset: 0;
    background: rgba(139,58,42,.85);
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md);
    font-size: 13px; font-weight: 700;
    color: #fff; letter-spacing: 1px;
}

/* Expand/collapse detail */
.ticket-detail-toggle {
    font-size: 12px; color: var(--c-gold);
    cursor: pointer; background: none; border: none;
    font-family: var(--ff-body); font-weight: 500;
    padding: 0; text-decoration: underline;
    transition: opacity var(--transition);
}
.ticket-detail-toggle:hover { opacity: .75; }

.ticket-detail-panel {
    display: none;
    padding: 14px 16px;
    background: var(--c-cream);
    border-top: 1px solid var(--c-sand);
    font-size: 13px;
    grid-column: 1 / -1;
}
.ticket-detail-panel.open { display: block; }
.ticket-detail-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
}
.ticket-detail-item { display: flex; flex-direction: column; gap: 2px; }
.ticket-detail-label { font-size: 11px; font-weight: 600; color: var(--c-ink-60); text-transform: uppercase; letter-spacing: .6px; }
.ticket-detail-value { font-size: 13px; font-weight: 600; color: var(--c-ink); }

/* Empty state */
.tickets-empty {
    text-align: center; padding: 80px 20px;
    color: var(--c-ink-60);
}
.tickets-empty__icon  { font-size: 56px; margin-bottom: 16px; }
.tickets-empty__title { font-family: var(--ff-display); font-size: 26px; font-weight: 600; color: var(--c-ink); margin-bottom: 8px; }

/* Confirm modal */
.confirm-overlay {
    position: fixed; inset: 0;
    background: rgba(26,23,20,.5);
    backdrop-filter: blur(4px);
    z-index: 500;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity .2s;
}
.confirm-overlay.open { opacity: 1; pointer-events: all; }
.confirm-box {
    background: #fff; border-radius: var(--radius-xl);
    padding: 36px; max-width: 400px; width: 90%;
    box-shadow: var(--shadow-lg);
    transform: scale(.97); transition: transform .2s;
    text-align: center;
}
.confirm-overlay.open .confirm-box { transform: scale(1); }
.confirm-box__icon  { font-size: 44px; margin-bottom: 12px; }
.confirm-box__title { font-family: var(--ff-display); font-size: 22px; font-weight: 600; margin-bottom: 8px; }
.confirm-box__desc  { font-size: 14px; color: var(--c-ink-60); margin-bottom: 24px; line-height: 1.7; }
.confirm-box__btns  { display: flex; gap: 10px; justify-content: center; }

@@media (max-width: 700px) {
    .tickets-grid { grid-template-columns: 1fr; }
    .ticket-card { grid-template-columns: 1fr; }
    .ticket-card__right { border-left: none; border-top: 1px dashed var(--c-sand); flex-direction: row; gap: 16px; }
    .ticket-card__right::before, .ticket-card__right::after { display: none; }
    .ticket-detail-grid { grid-template-columns: 1fr 1fr; }
    .mytickets-hero__inner { flex-direction: column; align-items: flex-start; }
    .filter-tabs { margin-top: 12px; }
}
</style>
}

<!-- Hero -->
<div class="mytickets-hero">
    <div class="mytickets-hero__inner">
        <div class="mytickets-hero__left">
            <div class="mytickets-hero__icon">🎟</div>
            <div>
                <div class="mytickets-hero__title">Vé của tôi</div>
                <div class="mytickets-hero__sub">
                    Xin chào, <strong style="color:var(--c-gold)">@Model.CurrentParticipant?.FullName</strong>
                    — @Model.Tickets.Count vé
                </div>
            </div>
        </div>

        <!-- Filter tabs -->
        <div class="filter-tabs">
            @{
                var allActive      = string.IsNullOrEmpty(Model.FilterStatus);
                var validActive    = Model.FilterStatus == "Valid";
                var usedActive     = Model.FilterStatus == "Used";
                var cancelActive   = Model.FilterStatus == "Cancelled";
            }
            <a href="/Account/MyTickets" class="filter-tab @(allActive ? "active" : "")">Tất cả</a>
            <a href="/Account/MyTickets?FilterStatus=Valid"     class="filter-tab @(validActive  ? "active-valid"     : "")">✅ Valid</a>
            <a href="/Account/MyTickets?FilterStatus=Used"      class="filter-tab @(usedActive   ? "active-used"      : "")">🏁 Đã dùng</a>
            <a href="/Account/MyTickets?FilterStatus=Cancelled" class="filter-tab @(cancelActive ? "active-cancelled" : "")">❌ Đã hủy</a>
        </div>
    </div>
</div>

<!-- Main -->
<div class="section">
    <div class="container">
        @if (!Model.Tickets.Any())
        {
            <div class="tickets-empty">
                <div class="tickets-empty__icon">🎫</div>
                <div class="tickets-empty__title">
                    @(string.IsNullOrEmpty(Model.FilterStatus)
                        ? "Bạn chưa có vé nào"
                        : $"Không có vé nào ở trạng thái \"{Model.FilterStatus}\"")
                </div>
                <p style="margin-bottom:24px">Hãy khám phá các sự kiện và đăng ký tham gia!</p>
                <a asp-page="/Events/EventList" class="btn btn-primary btn-lg">Khám phá sự kiện</a>
            </div>
        }
        else
        {
            <div class="tickets-grid">
                @{
                    string[] themes = { "theme-1","theme-2","theme-3","theme-4","theme-5","theme-6" };
                    int ti = 0;
                }
                @foreach (var ticket in Model.Tickets)
                {
                    var ev         = ticket.Event;
                    var statusCss  = (ticket.Status ?? "").ToLower();
                    var theme      = themes[(ti++) % themes.Length];
                    var isCancelled = ticket.Status == "Cancelled";
                    var isValid    = ticket.Status == "Valid";

                    var typeCss = (ticket.TicketType ?? "Standard") switch {
                        "VIP"           => "pill-vip",
                        "Student"       => "pill-student",
                        "Complimentary" => "pill-comp",
                        _               => "pill-standard"
                    };
                    var paymentCss = ticket.PaymentStatus == "Paid" ? "payment-paid" : "payment-pending";

                    <div class="ticket-card status-@statusCss" id="ticket-@ticket.TicketId">
                        <!-- LEFT -->
                        <div class="ticket-card__left">
                            <!-- Event thumb -->
                            <div class="ticket-card__event-thumb">
                                <div class="ticket-card__event-thumb-bg @theme"
                                     style="@(isCancelled ? "opacity:.45;filter:grayscale(1)" : "")"></div>
                            </div>

                            <div class="ticket-card__header">
                                <div class="ticket-card__event-name">
                                    @(ev?.EventName ?? "Sự kiện")
                                </div>
                                @{
                                    var sbc = ticket.Status switch {
                                        "Valid"     => "badge-green",
                                        "Used"      => "badge-blue",
                                        "Cancelled" => "badge-red",
                                        _           => "badge-gray"
                                    };
                                    var sbt = ticket.Status switch {
                                        "Valid"     => "Valid",
                                        "Used"      => "Đã dùng",
                                        "Cancelled" => "Đã hủy",
                                        _           => ticket.Status
                                    };
                                }
                                <span class="badge @sbc">@sbt</span>
                            </div>

                            <div class="ticket-card__meta">
                                @if (ev?.StartDate.HasValue == true)
                                {
                                    <div class="ticket-card__meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        @ev.StartDate.Value.ToString("dddd, dd/MM/yyyy")
                                        @if (ev.EventTime.HasValue)
                                        { <span>lúc @ev.EventTime.Value.ToString("hh\\:mm")</span> }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ev?.Location))
                                {
                                    <div class="ticket-card__meta-item">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                        @ev.Location
                                    </div>
                                }
                                <div class="ticket-card__meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    Tổ chức bởi @(ev?.Organizer?.FullName ?? "Ban tổ chức")
                                </div>
                            </div>

                            <div class="ticket-card__footer">
                                <span class="ticket-type-pill @typeCss">
                                    @(ticket.TicketType ?? "Standard")
                                </span>
                                <span class="payment-pill @paymentCss">
                                    @(ticket.PaymentStatus == "Paid" ? "✅ Đã thanh toán" : "⏳ Chờ thanh toán")
                                </span>

                                @if (ticket.Price > 0)
                                {
                                    <div class="ticket-price">@ticket.Price?.ToString("N0") ₫</div>
                                }
                                else
                                {
                                    <div class="ticket-price" style="color:var(--c-success)">Miễn phí</div>
                                }

                                <button class="ticket-detail-toggle"
                                        onclick="toggleDetail(@ticket.TicketId)">
                                    Xem chi tiết ▾
                                </button>

                                @if (isValid && ev?.StartDate > DateTime.Now)
                                {
                                    <button class="btn-cancel"
        data-id="@ticket.TicketId"
        data-name="@ev?.EventName"
        onclick="confirmCancel(this)">
    Hủy vé
</button>
                                }
                            </div>
                        </div>

                        <!-- RIGHT: QR -->
                        <div class="ticket-card__right">
                            <div class="qr-wrapper" id="qr-wrap-@ticket.TicketId">
                                <canvas id="qr-@ticket.TicketId" width="100" height="100"></canvas>
                                @if (isCancelled)
                                {
                                    <div class="qr-cancelled-overlay">HỦY</div>
                                }
                            </div>
                            <div class="ticket-id">
                                #@ticket.TicketId.ToString("D6")
                            </div>
                            @if (!isCancelled)
                            {
                                <button onclick="downloadQR(@ticket.TicketId)"
                                        style="font-size:11px;color:var(--c-gold);background:none;border:none;cursor:pointer;font-family:var(--ff-body);padding:0;text-decoration:underline">
                                    Tải QR
                                </button>
                            }
                        </div>

                        <!-- DETAIL PANEL -->
                        <div class="ticket-detail-panel" id="detail-@ticket.TicketId">
                            <div class="ticket-detail-grid">
                                <div class="ticket-detail-item">
                                    <span class="ticket-detail-label">Mã vé</span>
                                    <span class="ticket-detail-value">#@ticket.TicketId.ToString("D6")</span>
                                </div>
                                <div class="ticket-detail-item">
                                    <span class="ticket-detail-label">Mã QR</span>
                                    <span class="ticket-detail-value" style="font-size:11px;word-break:break-all">
                                        @ticket.Qrcode?.ToString().ToUpper().Substring(0, 8)...
                                    </span>
                                </div>
                                <div class="ticket-detail-item">
                                    <span class="ticket-detail-label">Loại vé</span>
                                    <span class="ticket-detail-value">@(ticket.TicketType ?? "Standard")</span>
                                </div>
                                <div class="ticket-detail-item">
                                    <span class="ticket-detail-label">Giá</span>
                                    <span class="ticket-detail-value">
                                        @(ticket.Price > 0 ? $"{ticket.Price:N0} VNĐ" : "Miễn phí")
                                    </span>
                                </div>
                                <div class="ticket-detail-item">
                                    <span class="ticket-detail-label">Thanh toán</span>
                                    <span class="ticket-detail-value">@ticket.PaymentStatus</span>
                                </div>
                                <div class="ticket-detail-item">
                                    <span class="ticket-detail-label">Check-in</span>
                                    <span class="ticket-detail-value">
                                        @(ticket.CheckInTime.HasValue
                                            ? ticket.CheckInTime.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Chưa check-in")
                                    </span>
                                </div>
                                @if (ev != null)
                                {
                                    <div class="ticket-detail-item">
                                        <span class="ticket-detail-label">Sự kiện</span>
                                        <span class="ticket-detail-value">@ev.EventName</span>
                                    </div>
                                    <div class="ticket-detail-item">
                                        <span class="ticket-detail-label">Ngày</span>
                                        <span class="ticket-detail-value">@ev.StartDate?.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="ticket-detail-item">
                                        <span class="ticket-detail-label">Địa điểm</span>
                                        <span class="ticket-detail-value">@(ev.Location ?? "TBD")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Confirm Cancel Modal -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box">
        <div class="confirm-box__icon">⚠️</div>
        <div class="confirm-box__title">Xác nhận hủy vé</div>
        <div class="confirm-box__desc" id="confirmDesc">
            Bạn có chắc muốn hủy vé này không? Hành động này không thể hoàn tác.
        </div>
        <div class="confirm-box__btns">
            <button class="btn btn-ghost" onclick="closeConfirm()">Giữ lại</button>
            <form method="post" asp-page-handler="Cancel" id="cancelForm" style="display:inline">
                <input type="hidden" name="ticketId" id="cancelTicketId" />
                <button type="submit" class="btn btn-primary"
                        style="background:var(--c-danger)!important;border-color:var(--c-danger)!important">
                    Hủy vé
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
// ── Sinh QR cho từng vé ──────────────────────────────────
var qrData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Tickets.Select(t => new {
        id       = t.TicketId,
        qr       = t.Qrcode.ToString(),
        status   = t.Status
    }).ToList()
));

document.addEventListener('DOMContentLoaded', function() {
    qrData.forEach(function(t) {
        var canvas = document.getElementById('qr-' + t.id);
        if (!canvas) return;

        var qrText = 'EVENTPRO-TICKET:' + t.id + ':' + t.qr.toUpperCase();

        var qr = new QRCode(canvas.parentElement, {
            text:          qrText,
            width:         100,
            height:        100,
            colorDark:     t.status === 'Cancelled' ? '#888' : '#1A1714',
            colorLight:    '#ffffff',
            correctLevel:  QRCode.CorrectLevel.M
        });
        // Remove the canvas placeholder (QRCode.js creates its own)
        if (canvas && canvas.parentElement.querySelector('img')) {
            canvas.remove();
        }
    });
});

// ── Toggle chi tiết ──────────────────────────────────────
function toggleDetail(id) {
    var panel  = document.getElementById('detail-' + id);
    var btn    = panel.previousElementSibling
                    .querySelector('.ticket-detail-toggle');
    var isOpen = panel.classList.toggle('open');
    btn.textContent = isOpen ? 'Ẩn chi tiết ▴' : 'Xem chi tiết ▾';
}

// ── Xác nhận hủy vé ─────────────────────────────────────
function confirmCancel(ticketId, eventName) {
    document.getElementById('cancelTicketId').value = ticketId;
    document.getElementById('confirmDesc').textContent =
        'Bạn có chắc muốn hủy vé sự kiện "' + eventName + '"? Hành động này không thể hoàn tác.';
    document.getElementById('confirmOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeConfirm() {
    document.getElementById('confirmOverlay').classList.remove('open');
    document.body.style.overflow = '';
}

document.getElementById('confirmOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeConfirm();
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeConfirm();
});

// ── Tải QR ───────────────────────────────────────────────
function downloadQR(ticketId) {
    var wrap = document.getElementById('qr-wrap-' + ticketId);
    var img  = wrap ? wrap.querySelector('img') : null;
    if (!img) return;

    var a    = document.createElement('a');
    a.href   = img.src;
    a.download = 'ticket-' + String(ticketId).padStart(6, '0') + '.png';
    a.click();
}
</script>
}
