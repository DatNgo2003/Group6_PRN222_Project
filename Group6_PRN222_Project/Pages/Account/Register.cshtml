@page
@model Group6_PRN222_Project.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .auth-page {
            min-height: calc(100vh - 68px);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--c-ivory);
            position: relative;
            padding: 40px 20px;
        }

            .auth-page::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(var(--c-sand) 1px, transparent 1px), linear-gradient(90deg, var(--c-sand) 1px, transparent 1px);
                background-size: 48px 48px;
                opacity: .35;
                pointer-events: none;
            }

        .auth-card {
            position: relative;
            z-index: 1;
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-xl);
            width: 100%;
            max-width: 500px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }

        .auth-card__header {
            background: var(--c-ink);
            padding: 32px 40px 28px;
            text-align: center;
        }

        .auth-card__logo {
            font-family: var(--ff-display);
            font-size: 30px;
            font-weight: 700;
            color: var(--c-ivory);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-bottom: 4px;
        }

        .auth-card__logo-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--c-gold);
            margin-bottom: 9px;
        }

        .auth-card__subtitle {
            font-size: 13px;
            color: rgba(250,248,244,.45);
        }

        .auth-card__body {
            padding: 32px 40px 36px;
        }

        .auth-card__title {
            font-family: var(--ff-display);
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .auth-card__desc {
            font-size: 14px;
            color: var(--c-ink-60);
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--c-ink-30);
            pointer-events: none;
        }

            .input-icon svg {
                width: 15px;
                height: 15px;
                display: block;
            }

        .form-input.has-icon {
            padding-left: 40px;
        }

        .password-strength {
            margin-top: 6px;
            height: 3px;
            background: var(--c-sand);
            border-radius: 2px;
            overflow: hidden;
        }

        .password-strength__bar {
            height: 100%;
            width: 0;
            border-radius: 2px;
            transition: width .3s ease, background .3s ease;
        }

        .strength-label {
            font-size: 11px;
            color: var(--c-ink-60);
            margin-top: 4px;
        }

        .btn-submit {
            width: 100%;
            justify-content: center;
            font-size: 15px;
            padding: 13px;
            border-radius: var(--radius-md);
            margin-top: 8px;
        }

        .auth-footer {
            text-align: center;
            font-size: 14px;
            color: var(--c-ink-60);
            margin-top: 20px;
        }

            .auth-footer a {
                color: var(--c-gold);
                font-weight: 600;
                text-decoration: none;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        .terms-note {
            font-size: 12px;
            color: var(--c-ink-30);
            text-align: center;
            margin-top: 14px;
            line-height: 1.6;
        }

        @@media (max-width: 480px) {
            .auth-card__body {
                padding: 28px 24px 32px;
            }

            .auth-card__header {
                padding: 28px 24px;
            }

            .form-row-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <div class="auth-card__logo">
                EventPro<span class="auth-card__logo-dot"></span>
            </div>
            <div class="auth-card__subtitle">Tạo tài khoản mới</div>
        </div>

        <div class="auth-card__body">
            <div class="auth-card__title">Đăng ký</div>
            <div class="auth-card__desc">Điền thông tin bên dưới để tạo tài khoản EventPro.</div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" style="margin-bottom:20px">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="form-group">
                    <label class="form-label">Họ và tên</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </span>
                        <input asp-for="FullName" class="form-input has-icon"
                               placeholder="Nguyễn Văn A" required />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Tên đăng nhập</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94" /></svg>
                            </span>
                            <input asp-for="Username" class="form-input has-icon"
                                   placeholder="username" autocomplete="username" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger" style="font-size:12px"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                            </span>
                            <input asp-for="Email" type="email" class="form-input has-icon"
                                   placeholder="email@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger" style="font-size:12px"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Mật khẩu</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        </span>
                        <input asp-for="Password" id="pwInput" type="password"
                               class="form-input has-icon"
                               placeholder="Tối thiểu 6 ký tự"
                               oninput="checkStrength(this.value)"
                               autocomplete="new-password" required />
                    </div>
                    <div class="password-strength">
                        <div class="password-strength__bar" id="strengthBar"></div>
                    </div>
                    <div class="strength-label" id="strengthLabel"></div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        </span>
                        <input asp-for="ConfirmPassword" id="pwConfirm" type="password"
                               class="form-input has-icon"
                               placeholder="Nhập lại mật khẩu"
                               autocomplete="new-password" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-submit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                    Tạo tài khoản
                </button>
            </form>

            <div class="terms-note">
                Bằng cách đăng ký, bạn đồng ý với
                <a href="#" style="color:var(--c-gold)">Điều khoản sử dụng</a> của chúng tôi.
            </div>

            <div class="auth-footer">
                Đã có tài khoản?
                <a asp-page="/Account/Login">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkStrength(val) {
            const bar   = document.getElementById('strengthBar');
            const label = document.getElementById('strengthLabel');
            let score = 0;
            if (val.length >= 6)  score++;
            if (val.length >= 10) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const levels = [
                { w:'0%',   bg:'transparent', text:'' },
                { w:'25%',  bg:'#E24B4A', text:'Rất yếu' },
                { w:'50%',  bg:'#EF9F27', text:'Yếu' },
                { w:'75%',  bg:'#B8975A', text:'Khá' },
                { w:'90%',  bg:'#3A9A6A', text:'Mạnh' },
                { w:'100%', bg:'#2C6B4E', text:'Rất mạnh' },
            ];
            const l = levels[Math.min(score, 5)];
            bar.style.width      = l.w;
            bar.style.background = l.bg;
            label.textContent    = l.text;
            label.style.color    = l.bg;
        }
    </script>
}
