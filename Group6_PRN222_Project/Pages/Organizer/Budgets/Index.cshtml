@page
@model Group6_PRN222_Project.Pages.Organizer.Budgets.IndexModel
@{
    ViewData["Title"] = "Budget Allocation";
}

<h1>Budget Allocation & Requests</h1>
<p>
    <a asp-page="Create" class="btn btn-primary">Allocate New Budget</a>
</p>
<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Event</th>
            <th>Total Allocated</th>
            <th>Spent Amount</th>
            <th>Status</th>
            <th>Approved By</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Budgets)
        {
            <tr>
                <td><strong>@item.Event?.EventName</strong></td>
                <td>@item.TotalAllocated?.ToString("C0")</td>
                <td>@item.SpentAmount?.ToString("C0")</td>
                <td>
                    @{
                        var badgeClass = item.ApprovalStatus switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Approved" => "bg-success",
                            "Rejected" => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@item.ApprovalStatus</span>
                </td>
                <td>@(item.ApprovedByNavigation?.FullName ?? "N/A")</td>
            </tr>
        }
        @if (Model.Budgets.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center">No budgets found.</td>
            </tr>
        }
    </tbody>
</table>
