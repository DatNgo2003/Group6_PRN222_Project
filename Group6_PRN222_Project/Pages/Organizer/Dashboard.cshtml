@page
@model Group6_PRN222_Project.Pages.Organizer.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4 pt-3">
    <div class="col-12">
        <h1 class="display-6">Organizer Dashboard</h1>
        <p class="text-muted">Overview of Event Performance, Real-time Progress, and Resource Allocation.</p>
    </div>
</div>

<div class="row">
    <!-- Event Performance Statistics -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-header bg-primary text-white">Event Performance</div>
            <div class="card-body text-center">
                <h3 class="card-title text-primary display-4">@Model.OngoingEvents <small class="text-muted fs-6">/ @Model.TotalEvents</small></h3>
                <p class="text-muted">Active Events</p>
                <p class="card-text border-top pt-2 mt-2">Total tracked events going on right now in the system.</p>
                <a asp-page="/Organizer/Events/Index" class="btn btn-outline-primary w-100 mt-2">Manage Events</a>
            </div>
        </div>
    </div>

    <!-- Real-time Progress Monitoring -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-header bg-success text-white">Progress Monitoring</div>
            <div class="card-body text-center">
                <h3 class="card-title text-success display-4">@Model.CompletedTasks <small class="text-muted fs-6">/ @Model.TotalTasks</small></h3>
                <p class="text-muted">Tasks Done</p>
                @{
                    var percent = Model.TotalTasks > 0 ? (Model.CompletedTasks * 100 / Model.TotalTasks) : 0;
                }
                <div class="progress mb-2" style="height: 20px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">@percent%</div>
                </div>
                <p class="card-text border-top pt-2">Real-time task completion rate across all active events.</p>
                <a asp-page="/Organizer/Tasks/Index" class="btn btn-outline-success w-100 mt-2">Manage Tasks</a>
            </div>
        </div>
    </div>

    <!-- Resource Allocation Summaries -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-warning">
            <div class="card-header bg-warning text-dark">Resource Allocations</div>
            <div class="card-body text-center">
                <h3 class="card-title text-warning display-4">@Model.TotalBudgetSpent.ToString("C0")</h3>
                <p class="text-muted">Total Spent</p>
                <h5 class="text-dark">Allocated: @Model.TotalBudgetAllocated.ToString("C0")</h5>
                <p class="card-text border-top pt-2 mt-2">Budget overview across all events and departments.</p>
                <a asp-page="/Organizer/Budgets/Index" class="btn btn-outline-warning text-dark w-100 mt-2">Manage Budget</a>
            </div>
        </div>
    </div>
</div>
