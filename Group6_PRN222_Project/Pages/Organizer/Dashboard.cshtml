@page
@model Group6_PRN222_Project.Pages.Organizer.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <style>
        .dashboard-hero {
            background: var(--c-ink);
            padding: 40px 0;
            border-bottom: 1px solid var(--sidebar-bdr);
            margin: -28px -32px 28px -32px;
            padding: 40px 32px;
        }

        .dashboard-hero__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .dashboard-hero__left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .dashboard-hero__avatar {
            width: 52px;
            height: 52px;
            background: rgba(110, 231, 183, 0.15);
            border: 1px solid rgba(110, 231, 183, 0.3);
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
            color: #6ee7b7;
        }

        .dashboard-hero__name {
            font-family: var(--ff-display);
            font-size: 26px;
            font-weight: 600;
            color: var(--text-1);
            line-height: 1.1;
        }

        .dashboard-hero__role {
            font-size: 13px;
            color: #6ee7b7;
            font-weight: 500;
            margin-top: 3px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dashboard-hero__time {
            font-size: 13px;
            color: var(--text-3);
        }

        /* Stat cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--card-bdr);
            border-radius: var(--r-lg);
            padding: 24px;
            transition: transform var(--tr), box-shadow var(--tr);
        }

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: rgba(184,151,90,.3);
        }

        .stat-card__icon {
            width: 44px;
            height: 44px;
            border-radius: var(--r-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 16px;
        }

        .stat-card__value {
            font-family: var(--ff-display);
            font-size: 40px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -1px;
            margin-bottom: 4px;
        }

        .stat-card__label {
            font-size: 13px;
            color: var(--text-2);
        }

        .stat-card__sub {
            font-size: 12px;
            color: var(--text-3);
            margin-top: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 12px;
            border-top: 1px solid var(--row-bdr);
        }

        .chart-card {
            background: var(--card-bg);
            border: 1px solid var(--card-bdr);
            border-radius: var(--r-lg);
            padding: 24px;
        }

        .chart-title {
            font-family: var(--ff-display);
            font-size: 18px;
            font-weight: 600;
            color: var(--text-1);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        @@media (max-width: 900px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .dashboard-hero__inner {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}

<!-- Dashboard Hero -->
<div class="dashboard-hero">
    <div class="dashboard-hero__inner">
        <div class="dashboard-hero__left">
            <div class="dashboard-hero__avatar">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div>
                <div class="dashboard-hero__name">Metrics & Analytics</div>
                <div class="dashboard-hero__role">
                    <span style="width:6px;height:6px;border-radius:50%;background:#6ee7b7;display:inline-block"></span>
                    Theo dõi hiệu suất và tiến độ sự kiện
                </div>
            </div>
        </div>
        <div class="dashboard-hero__time">
            @DateTime.Now.ToString("dddd, dd/MM/yyyy")
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card__icon" style="background:rgba(184,151,90,.15); color:var(--c-gold)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div class="stat-card__value" style="color:var(--text-1)">@Model.OngoingEvents <span style="font-size:20px;color:var(--text-3)">/ @Model.TotalEvents</span></div>
        <div class="stat-card__label">Hoạt động / Tổng Sự kiện</div>
        <div class="stat-card__sub">
            <a asp-page="/Organizer/Events/Index" style="color:var(--c-gold);text-decoration:none;font-weight:500">Quản lý sự kiện &rarr;</a>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card__icon" style="background:rgba(96,165,250,.15); color:#60A5FA">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
        </div>
        <div class="stat-card__value" style="color:var(--text-1)">@Model.CompletedTasks <span style="font-size:20px;color:var(--text-3)">/ @Model.TotalTasks</span></div>
        <div class="stat-card__label">Tiến độ công việc</div>
        @{
            var percent = Model.TotalTasks > 0 ? (Model.CompletedTasks * 100 / Model.TotalTasks) : 0;
        }
        <div class="stat-card__sub" style="display:flex; flex-direction:column; align-items:flex-start; gap:8px;">
            <div style="width:100%; display:flex; justify-content:space-between;">
                <span>Tỷ lệ hoàn thành</span>
                <span style="color:#60A5FA; font-weight:600">@percent%</span>
            </div>
            <div style="width:100%; height:4px; background:var(--row-bdr); border-radius:2px; overflow:hidden;">
                <div style="width:@percent%; height:100%; background:#60A5FA; border-radius:2px;"></div>
            </div>
            <a asp-page="/Organizer/Tasks/Index" style="color:#60A5FA;text-decoration:none;font-weight:500;margin-top:4px">Giám sát công việc &rarr;</a>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon" style="background:rgba(167,139,250,.15); color:#A78BFA">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        </div>
        <div class="stat-card__value" style="color:var(--text-1)">@Model.TotalBudgetSpent.ToString("C0")</div>
        <div class="stat-card__label">Tổng ngân sách đã chi</div>
        <div class="stat-card__sub" style="display:flex; flex-direction:column; align-items:flex-start; gap:8px;">
            <div style="width:100%; display:flex; justify-content:space-between;">
                <span>Tổng phân bổ</span>
                <span style="color:#A78BFA; font-weight:600">@Model.TotalBudgetAllocated.ToString("C0")</span>
            </div>
            <a asp-page="/Organizer/Budgets/Index" style="color:#A78BFA;text-decoration:none;font-weight:500;margin-top:4px;width:100%;text-align:left">Quản lý ngân sách &rarr;</a>
        </div>
    </div>
</div>

<!-- Chart Area -->
<div class="chart-card">
    <div class="chart-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-gold)" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line><line x1="2" y1="20" x2="22" y2="20"></line></svg>
        Top 5 Ngân sách sự kiện
    </div>
    <div style="height: 350px">
        <canvas id="budgetBarChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var budgetLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BudgetEventNames));
        var budgetAllocated = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BudgetAllocatedData));
        var budgetSpent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BudgetSpentData));

        document.addEventListener('DOMContentLoaded', function () {
            // Configure Chart.js for dark theme
            Chart.defaults.color = 'rgba(250,248,244,0.6)';
            Chart.defaults.borderColor = 'rgba(250,248,244,0.08)';
            
            const barCtx = document.getElementById('budgetBarChart')?.getContext('2d');
            if (barCtx) {
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: budgetLabels,
                        datasets: [
                            {
                                label: 'Allocated Budget',
                                data: budgetAllocated,
                                backgroundColor: 'rgba(184,151,90,0.85)',
                                borderRadius: 4,
                                borderSkipped: false
                            },
                            {
                                label: 'Spent Amount',
                                data: budgetSpent,
                                backgroundColor: 'rgba(96,165,250,0.85)',
                                borderRadius: 4,
                                borderSkipped: false
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { 
                                position: 'top', 
                                labels: { 
                                    usePointStyle: true,
                                    font: { family: "'DM Sans', sans-serif" },
                                    boxWidth: 8
                                } 
                            },
                            tooltip: {
                                backgroundColor: 'rgba(15,13,11,0.95)',
                                titleFont: { family: "'DM Sans', sans-serif", size: 13 },
                                bodyFont: { family: "'DM Sans', sans-serif", size: 13 },
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: true,
                                borderColor: 'rgba(184,151,90,0.2)',
                                borderWidth: 1
                            }
                        },
                        scales: {
                            y: { 
                                beginAtZero: true, 
                                grid: { color: 'rgba(250,248,244,0.04)' },
                                ticks: { font: { family: "'DM Sans', sans-serif", size: 11 } }
                            },
                            x: { 
                                grid: { display: false },
                                ticks: { font: { family: "'DM Sans', sans-serif", size: 11 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
