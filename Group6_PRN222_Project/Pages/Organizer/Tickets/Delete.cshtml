@page
@model Group6_PRN222_Project.Pages.Organizer.Tickets.DeleteModel

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="page-header">
    <div class="page-title">
        <h1>Delete Ticket</h1>
        <p class="subtitle">Xác nhận xóa vé</p>
    </div>
</div>

<div class="card" style="max-width:600px;padding:28px 32px;">
    <h3 style="color:#f87171;margin-bottom:18px;">Are you sure you want to delete this ticket?</h3>
    
    <dl class="row" style="margin-bottom:0;">
        <dt class="col-sm-4" style="color:var(--text-3);font-size:.82rem;">Event</dt>
        <dd class="col-sm-8" style="font-weight:600;">@(Model.Ticket.Event?.EventName ?? "N/A")</dd>
        
        <dt class="col-sm-4" style="color:var(--text-3);font-size:.82rem;">Participant</dt>
        <dd class="col-sm-8">@(Model.Ticket.Participant?.FullName ?? "N/A")</dd>
        
        <dt class="col-sm-4" style="color:var(--text-3);font-size:.82rem;">Ticket Price</dt>
        <dd class="col-sm-8" style="color:var(--c-gold);font-weight:600;">@(Model.Ticket.PaymentStatus ?? "N/A") VNĐ</dd>
        
        <dt class="col-sm-4" style="color:var(--text-3);font-size:.82rem;">QR Code</dt>
        <dd class="col-sm-8 id-cell">@(Model.Ticket.Qrcode?.ToString() ?? "N/A")</dd>
        
        <dt class="col-sm-4" style="color:var(--text-3);font-size:.82rem;">Status</dt>
        <dd class="col-sm-8">
            @{
                var sc = Model.Ticket.Status == "Valid" ? "background:rgba(74,154,122,.12);color:#6ee7b7" :
                         Model.Ticket.Status == "Used" ? "background:rgba(96,165,250,.15);color:#60A5FA" :
                         "background:rgba(220,60,60,.10);color:#f87171";
            }
            <span class="role-badge" style="@sc">@Model.Ticket.Status</span>
        </dd>
    </dl>
    
    <form method="post" style="margin-top:20px;display:flex;gap:10px;">
        <input type="hidden" asp-for="Ticket.TicketId" />
        <button type="submit" class="btn" style="background:rgba(220,60,60,.15);color:#f87171;border:1px solid rgba(220,60,60,.25);">
            Confirm Delete
        </button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
