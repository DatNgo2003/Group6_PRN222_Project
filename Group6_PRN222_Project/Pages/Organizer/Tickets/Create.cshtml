@page
@model Group6_PRN222_Project.Pages.Organizer.Tickets.CreateModel

@{
    ViewData["Title"] = "Create Ticket";
}

<div class="page-header">
    <div class="page-title">
        <h1>Create Ticket</h1>
        <p class="subtitle">Tạo vé mới cho sự kiện</p>
    </div>
</div>

<div class="form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="form-section">
            <div class="section-title">Ticket Information</div>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Ticket.EventId">Event <span class="required">*</span></label>
                    <select asp-for="Ticket.EventId" class="form-control" asp-items="Model.EventList" required>
                        <option value="">-- Select Event --</option>
                    </select>
                    <span asp-validation-for="Ticket.EventId" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Ticket.TicketType">Loại vé <span class="required">*</span></label>
                    <select asp-for="Ticket.TicketType" class="form-control" required>
                        <option value="">-- Chọn loại vé --</option>
                        <option value="Standard">Standard</option>
                        <option value="VIP">VIP</option>
                    </select>
                    <span asp-validation-for="Ticket.TicketType" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Ticket.Price">Giá vé (VNĐ) <span class="required">*</span></label>
                    <input asp-for="Ticket.Price" class="form-control" type="number" min="0" step="1000" placeholder="VNĐ" required />
                    <span asp-validation-for="Ticket.Price" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Ticket.Status">Status</label>
                    <select asp-for="Ticket.Status" class="form-control">
                        <option value="Valid">Valid</option>
                        <option value="Used">Used</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Ticket</button>
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
