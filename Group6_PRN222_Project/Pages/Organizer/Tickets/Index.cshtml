@page
@model Group6_PRN222_Project.Pages.Organizer.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets Management";
}

<div class="page-header">
    <div class="page-title">
        <h1>Tickets Management</h1>
        <p class="subtitle">Quản lý vé sự kiện</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <span class="btn-icon">+</span> Create New Ticket
    </a>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Event Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.Events)
                {
                    <tr>
                        <td class="id-cell">@ev.EventId</td>
                        <td><strong>@ev.EventName</strong></td>
                        <td class="action-cell">
                            <button class="btn-action btn-edit"
                                    onclick="toggleTickets(@ev.EventId)"
                                    id="btn-view-@ev.EventId">
                                View
                            </button>
                            <a asp-page="./Delete" asp-route-eventId="@ev.EventId" class="btn-action btn-delete">Delete</a>
                        </td>
                    </tr>
                    <!-- Ticket Detail Row -->
                    <tr id="tickets-@ev.EventId" style="display:none;">
                        <td colspan="3" style="padding:0;">
                            @{
                                var tickets = Model.TicketsByEvent.ContainsKey(ev.EventId)
                                    ? Model.TicketsByEvent[ev.EventId]
                                    : new List<Group6_PRN222_Project.Models.Ticket>();
                            }
                            @if (tickets.Count == 0)
                            {
                                <div style="padding:12px 20px; color:var(--text-3); font-style:italic;">
                                    Chưa có vé nào cho sự kiện này.
                                    <a asp-page="./Create" class="btn btn-primary" style="margin-left:10px; padding:4px 12px; font-size:.8rem;">Tạo vé</a>
                                </div>
                            }
                            else
                            {
                                <div style="padding:12px 20px; background:rgba(255,255,255,0.03);">
                                    <table style="width:100%; border-collapse:collapse; font-size:.88rem;">
                                        <thead>
                                            <tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
                                                <th style="padding:6px 10px; text-align:left;">ID Vé</th>
                                                <th style="padding:6px 10px; text-align:left;">Loại vé</th>
                                                <th style="padding:6px 10px; text-align:right;">Giá (VNĐ)</th>
                                                <th style="padding:6px 10px; text-align:right;">Số người đăng ký</th>
                                                <th style="padding:6px 10px; text-align:right;">Total (VNĐ)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var grp in tickets.GroupBy(t => new { t.TicketType, t.Price }))
                                            {
                                                var count = grp.Count();
                                                var price = grp.Key.Price ?? 0;
                                                var total = count * price;
                                                <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
                                                    <td style="padding:5px 10px; color:var(--text-3);">—</td>
                                                    <td style="padding:5px 10px;">
                                                        <span class="role-badge" style="@(grp.Key.TicketType == "VIP" ? "background:rgba(250,200,50,.15);color:#f6c90e" : "background:rgba(74,154,122,.12);color:#6ee7b7")">
                                                            @(grp.Key.TicketType ?? "Standard")
                                                        </span>
                                                    </td>
                                                    <td style="padding:5px 10px; text-align:right; color:var(--c-gold);">@price.ToString("N0")</td>
                                                    <td style="padding:5px 10px; text-align:right;">@count</td>
                                                    <td style="padding:5px 10px; text-align:right; font-weight:600; color:var(--c-gold);">@total.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr style="border-top:2px solid rgba(255,255,255,0.12); font-weight:700;">
                                                <td colspan="3" style="padding:6px 10px;">Tổng cộng</td>
                                                <td style="padding:6px 10px; text-align:right;">@tickets.Count</td>
                                                <td style="padding:6px 10px; text-align:right; color:var(--c-gold);">
                                                    @tickets.Sum(t => t.Price ?? 0).ToString("N0")
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Events.Any())
                {
                    <tr>
                        <td colspan="3" class="empty-state">
                            <div class="empty-icon">⊘</div>
                            <div>No events found.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function toggleTickets(eventId) {
            var row = document.getElementById('tickets-' + eventId);
            var btn = document.getElementById('btn-view-' + eventId);
            if (row.style.display === 'none') {
                row.style.display = '';
                btn.textContent = 'Hide';
            } else {
                row.style.display = 'none';
                btn.textContent = 'View';
            }
        }
    </script>
}
