@page "/Organizer/OrganizerDashboard"
@model Group6_PRN222_Project.Pages.Organizer.OrganizerDashboardModel
@{
    ViewData["Title"] = "Organizer Dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .dashboard-hero {
            background: var(--c-accent);
            padding: 40px 0;
        }

        .dashboard-hero__inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .dashboard-hero__left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .dashboard-hero__avatar {
            width: 52px;
            height: 52px;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .dashboard-hero__name {
            font-family: var(--ff-display);
            font-size: 26px;
            font-weight: 600;
            color: #fff;
            line-height: 1.1;
        }

        .dashboard-hero__role {
            font-size: 13px;
            color: rgba(255,255,255,.65);
            margin-top: 3px;
        }

        .dashboard-hero__time {
            font-size: 13px;
            color: rgba(255,255,255,.45);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-lg);
            padding: 24px;
            transition: transform var(--transition), box-shadow var(--transition);
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-md);
            }

        .stat-card__icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 16px;
        }

        .stat-card__value {
            font-family: var(--ff-display);
            font-size: 40px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -1px;
            margin-bottom: 4px;
        }

        .stat-card__label {
            font-size: 13px;
            color: var(--c-ink-60);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .data-table-wrap {
            background: #fff;
            border: 1px solid var(--c-sand);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .data-table-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--c-sand);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .data-table-title {
            font-family: var(--ff-display);
            font-size: 18px;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 12px 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: var(--c-ink-60);
            background: var(--c-cream);
            border-bottom: 1px solid var(--c-sand);
        }

        td {
            padding: 13px 20px;
            font-size: 14px;
            border-bottom: 1px solid var(--c-sand);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: var(--c-cream);
        }

        @@media (max-width: 900px) {
            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="dashboard-hero">
    <div class="dashboard-hero__inner">
        <div class="dashboard-hero__left">
            <div class="dashboard-hero__avatar">🎯</div>
            <div>
                <div class="dashboard-hero__name">@Model.FullName</div>
                <div class="dashboard-hero__role">Organizer — Quản lý sự kiện</div>
            </div>
        </div>
        <div class="dashboard-hero__time">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

<div class="section-sm">
    <div class="container">

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card__icon" style="background:var(--c-gold-pale)">📅</div>
                <div class="stat-card__value" style="color:var(--c-gold)">@Model.MyTotalEvents</div>
                <div class="stat-card__label">Sự kiện của tôi</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__icon" style="background:#E8F2EC">✅</div>
                <div class="stat-card__value" style="color:var(--c-success)">@Model.MyActiveEvents</div>
                <div class="stat-card__label">Đang hoạt động</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__icon" style="background:#E4EDF8">📋</div>
                <div class="stat-card__value" style="color:var(--c-info)">@Model.MyTotalTasks</div>
                <div class="stat-card__label">Tổng nhiệm vụ</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__icon" style="background:#FAE8E4">⏳</div>
                <div class="stat-card__value" style="color:var(--c-danger)">@Model.MyPendingTasks</div>
                <div class="stat-card__label">Chưa bắt đầu</div>
            </div>
        </div>

        <div class="grid-2">
            <!-- Events -->
            <div class="data-table-wrap">
                <div class="data-table-header">
                    <div class="data-table-title">Sự kiện của tôi</div>
                    <span class="badge badge-green">@Model.MyTotalEvents sự kiện</span>
                </div>
                <table>
                    <thead>
                        <tr><th>Tên sự kiện</th><th>Ngày</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.MyEvents)
                        {
                            <tr>
                                <td><strong style="font-size:13px">@ev.EventName</strong><br><span style="font-size:12px;color:var(--c-ink-60)">@ev.Location</span></td>
                                <td style="font-size:12px;color:var(--c-ink-60)">@ev.StartDate?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var bc = ev.Status == "Active" ? "badge-green" : ev.Status == "Planning" ? "badge-blue" : "badge-gray";
                                    }
                                    <span class="badge @bc">@ev.Status</span>
                                </td>
                            </tr>
                        }
                        @if (!Model.MyEvents.Any())
                        {
                            <tr><td colspan="3" style="text-align:center;color:var(--c-ink-60);padding:24px">Chưa có sự kiện nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tasks -->
            <div class="data-table-wrap">
                <div class="data-table-header">
                    <div class="data-table-title">Nhiệm vụ đang theo dõi</div>
                    <span class="badge badge-gold">@Model.MyPendingTasks chờ xử lý</span>
                </div>
                <table>
                    <thead>
                        <tr><th>Nhiệm vụ</th><th>Deadline</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.MyTasks)
                        {
                            <tr>
                                <td><strong style="font-size:13px">@task.TaskName</strong><br><span style="font-size:12px;color:var(--c-ink-60)">@task.AssignedToNavigation?.FullName</span></td>
                                <td style="font-size:12px;color:var(--c-ink-60)">@task.Deadline?.ToString("dd/MM")</td>
                                <td>
                                    @{
                                        var tc = task.Status == "Done" ? "badge-green" : task.Status == "In Progress" ? "badge-blue" : "badge-gray";
                                    }
                                    <span class="badge @tc">@task.Status</span>
                                </td>
                            </tr>
                        }
                        @if (!Model.MyTasks.Any())
                        {
                            <tr><td colspan="3" style="text-align:center;color:var(--c-ink-60);padding:24px">Chưa có nhiệm vụ nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
