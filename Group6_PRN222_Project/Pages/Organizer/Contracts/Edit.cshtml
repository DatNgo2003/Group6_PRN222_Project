@page
@model Group6_PRN222_Project.Pages.Organizer.Contracts.EditModel

@{
    ViewData["Title"] = "Edit Contract";
}

<h1>Edit Contract</h1>

<h4>Contract</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Contract.ContractId" />
            
            <div class="form-group mb-3">
                <label asp-for="Contract.EventId" class="control-label">Event</label>
                <select asp-for="Contract.EventId" class="form-control" asp-items="ViewBag.EventId"></select>
                <span asp-validation-for="Contract.EventId" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Contract.ContractNumber" class="control-label"></label>
                <input asp-for="Contract.ContractNumber" class="form-control" />
                <span asp-validation-for="Contract.ContractNumber" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Contract.VendorName" class="control-label"></label>
                <input asp-for="Contract.VendorName" class="form-control" />
                <span asp-validation-for="Contract.VendorName" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Contract.ContractValue" class="control-label"></label>
                <input asp-for="Contract.ContractValue" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Contract.ContractValue" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Contract.SignDate" class="control-label"></label>
                <input asp-for="Contract.SignDate" class="form-control" type="date" />
                <span asp-validation-for="Contract.SignDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Contract.FileUrl" class="control-label"></label>
                <input asp-for="Contract.FileUrl" class="form-control" />
                <span asp-validation-for="Contract.FileUrl" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Contract.Status" class="control-label"></label>
                <select asp-for="Contract.Status" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Contract.Status" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
