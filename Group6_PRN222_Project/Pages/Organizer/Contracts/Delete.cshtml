@page
@model Group6_PRN222_Project.Pages.Organizer.Contracts.DeleteModel

@{
    ViewData["Title"] = "Delete Contract";
}

<h1>Delete Contract</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Contract</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Contract Number
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contract.ContractNumber)
        </dd>
        <dt class="col-sm-2">
            Vendor Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contract.VendorName)
        </dd>
        <dt class="col-sm-2">
            Value
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contract.ContractValue)
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contract.Status)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Contract.ContractId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
