@page
@model Group6_PRN222_Project.Pages.Organizer.Contracts.IndexModel

@{
    ViewData["Title"] = "Contracts Management";
}

<h1>Contracts Management</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Contract</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Contract Number</th>
            <th>Vendor Name</th>
            <th>Value</th>
            <th>Sign Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Contracts)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ContractNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.VendorName)</td>
                <td>@Html.DisplayFor(modelItem => item.ContractValue)</td>
                <td>@Html.DisplayFor(modelItem => item.SignDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ContractId" class="btn btn-sm btn-warning">Edit</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ContractId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
