@page
@model Group6_PRN222_Project.Pages.Organizer.Staffs.EditRoleModel
@{
    ViewData["Title"] = "Edit Staff Role";
}

<h1>Edit Role for @Model.StaffFullName</h1>
<p>Email: @Model.StaffEmail</p>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="TargetUserId" />
            
            <div class="form-group mb-3">
                <label asp-for="SelectedRoleId" class="control-label">Assign Role (Security, MKT, Logistics)</label>
                <select asp-for="SelectedRoleId" class="form-select" asp-items="Model.RolesList">
                    <option value="">-- No Role --</option>
                </select>
                <small class="form-text text-muted">Only specific staff roles are available for assignment.</small>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
