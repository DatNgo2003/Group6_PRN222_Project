@page
@using Project_PRN222.Helpers
@model Group6_PRN222_Project.Pages.Organizer.FieldReports.IndexModel
@{
    ViewData["Title"] = "Notification Reports";
}

<div class="page-header">
    <div class="page-title">
        <h1>Notification Reports</h1>
        <p class="subtitle">Duyệt báo cáo từ nhân viên hiện trường</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@{
    var approvedCost = Model.Reports.Where(r => r.Status == "Approved" && r.EstimatePrice.HasValue).Sum(r => r.EstimatePrice!.Value);
    var pendingCost  = Model.Reports.Where(r => (r.Status == "Submitted" || r.Status == null) && r.EstimatePrice.HasValue).Sum(r => r.EstimatePrice!.Value);
}

<!-- Cost Summary Card -->
<div class="card" style="margin-bottom:20px; padding:20px;">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
        <span style="font-size:18px;">💰</span>
        <h3 style="margin:0; font-size:16px; font-weight:700; color:var(--text-1);">Tổng Chi Phí Báo Cáo</h3>
    </div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
        <div style="background:rgba(184,151,90,.08); border:1px solid rgba(184,151,90,.2); border-radius:10px; padding:16px;">
            <div style="font-size:11px; color:var(--text-3); text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px;">Tổng Chi Phí</div>
            <div style="font-size:22px; font-weight:700; color:var(--c-gold);">@Model.TotalCost.ToString("N0") <span style="font-size:13px; font-weight:400; color:var(--text-3);">VNĐ</span></div>
            <div style="font-size:12px; color:var(--text-3); margin-top:4px;">@Model.Reports.Count(r => r.EstimatePrice.HasValue) / @Model.Reports.Count báo cáo có giá</div>
        </div>
        <div style="background:rgba(74,154,122,.08); border:1px solid rgba(74,154,122,.2); border-radius:10px; padding:16px;">
            <div style="font-size:11px; color:var(--text-3); text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px;">Đã Duyệt</div>
            <div style="font-size:22px; font-weight:700; color:#6ee7b7;">@approvedCost.ToString("N0") <span style="font-size:13px; font-weight:400; color:var(--text-3);">VNĐ</span></div>
            <div style="font-size:12px; color:var(--text-3); margin-top:4px;">@Model.Reports.Count(r => r.Status == "Approved") báo cáo được duyệt</div>
        </div>
        <div style="background:rgba(250,200,80,.08); border:1px solid rgba(250,200,80,.2); border-radius:10px; padding:16px;">
            <div style="font-size:11px; color:var(--text-3); text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px;">Chờ Duyệt</div>
            <div style="font-size:22px; font-weight:700; color:#fbbf24;">@pendingCost.ToString("N0") <span style="font-size:13px; font-weight:400; color:var(--text-3);">VNĐ</span></div>
            <div style="font-size:12px; color:var(--text-3); margin-top:4px;">@Model.Reports.Count(r => r.Status == "Submitted" || r.Status == null) báo cáo đang chờ</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Report ID</th>
                    <th>Event</th>
                    <th>Staff</th>
                    <th>Report Type</th>
                    <th>Content</th>
                    <th>Price (VNĐ)</th>
                    <th>Report Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td class="id-cell">@r.ReportId</td>
                        <td><strong>@(r.Event?.EventName ?? "—")</strong></td>
                        <td style="color:var(--text-3)">@(r.Staff?.FullName ?? "—")</td>
                        <td>
                            <span class="role-badge role-default">@(r.ReportType ?? "—")</span>
                        </td>
                        <td style="max-width:280px; color:var(--text-2); vertical-align:top;">
                            @if (r.ReportType == "Marketing" && Model.MarketingDetails.ContainsKey(r.ReportId))
                            {
                                var d = Model.MarketingDetails[r.ReportId];
                                <div style="white-space:normal; font-size:.88rem;">@(MarketingFieldReportContent.PreviewPlainText(r.Content) ?? "—")</div>
                                @if (d.Payload.TaskEstimates.Any())
                                {
                                    <details style="margin-top:8px;">
                                        <summary style="cursor:pointer; font-weight:700; color:var(--text-1);">Chi tiết estimate theo task</summary>
                                        <table style="width:100%; margin-top:8px; font-size:.82rem; border-collapse:collapse;">
                                            <thead>
                                                <tr>
                                                    <th style="text-align:left; padding:4px 6px; border-bottom:1px solid var(--border);">Task</th>
                                                    <th style="text-align:right; padding:4px 6px; border-bottom:1px solid var(--border);">Estimate</th>
                                                    <th style="text-align:left; padding:4px 6px; border-bottom:1px solid var(--border);">Ghi chú</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var te in d.Payload.TaskEstimates)
                                                {
                                                    <tr>
                                                        <td style="padding:4px 6px; border-bottom:1px solid rgba(255,255,255,.06);">@(d.TaskNames.GetValueOrDefault(te.TaskId, $"Task #{te.TaskId}"))</td>
                                                        <td style="padding:4px 6px; text-align:right;">@((te.Amount ?? 0).ToString("N0"))</td>
                                                        <td style="padding:4px 6px; color:var(--text-3);">@(te.Note ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <p style="margin:8px 0 0; font-size:.82rem; color:var(--text-3);">Tổng hiển thị: <strong style="color:var(--c-gold);">@(r.EstimatePrice.HasValue ? r.EstimatePrice.Value.ToString("N0") : "—")</strong> VNĐ</p>
                                    </details>
                                }
                            }
                            else
                            {
                                <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">@(r.Content ?? "—")</span>
                            }
                        </td>
                        <td style="color:var(--c-gold); font-weight:600; text-align:right;">
                            @(r.EstimatePrice.HasValue ? r.EstimatePrice.Value.ToString("N0") : "—")
                        </td>
                        <td class="date-cell">@(r.ReportTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>
                            @{
                                var badge = r.Status switch
                                {
                                    "Approved" => "background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.2)",
                                    "Rejected" => "background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.2)",
                                    "Submitted" => "background:rgba(59,130,246,.15);color:#60a5fa;border:1px solid rgba(59,130,246,.2)",
                                    _ => "background:rgba(255,255,255,.07);color:var(--text-3);border:1px solid rgba(255,255,255,.1)"
                                };
                            }
                            <span class="role-badge" style="@badge; font-weight:600; padding:4px 10px; border-radius:6px; font-size:.75rem; text-transform:uppercase; letter-spacing:0.5px;">@(r.Status ?? "Submitted")</span>
                        </td>
                        <td class="action-cell" style="white-space:nowrap;">
                            @if (r.Status == "Submitted" || r.Status == null)
                            {
                                <form method="post" asp-page-handler="Approve" style="display:inline;">
                                    <input type="hidden" name="reportId" value="@r.ReportId" />
                                    <button type="submit" class="btn-action btn-edit"
                                            style="background:rgba(74,154,122,.15);color:#6ee7b7;border-color:rgba(74,154,122,.25);">
                                        ✓ Duyệt
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" style="display:inline; margin-left:4px;">
                                    <input type="hidden" name="reportId" value="@r.ReportId" />
                                    <button type="submit" class="btn-action btn-delete">
                                        ✗ Từ chối
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span style="color:var(--text-3); font-size:.8rem; font-style:italic;">Đã xử lý</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Reports.Any())
                {
                    <tr>
                        <td colspan="9" class="empty-state">
                            <div class="empty-icon">📋</div>
                            <div>Không có báo cáo nào.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
