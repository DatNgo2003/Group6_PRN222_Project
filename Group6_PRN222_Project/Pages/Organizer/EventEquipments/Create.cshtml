@page
@model Group6_PRN222_Project.Pages.Organizer.EventEquipments.CreateModel

@{
    ViewData["Title"] = "Tạo yêu cầu thiết bị";
}

<div class="page-header">
    <div class="page-title">
        <h1>Tạo yêu cầu thiết bị</h1>
        <p class="subtitle">Thêm yêu cầu mượn thiết bị cho sự kiện</p>
    </div>
    <a asp-page="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<div class="form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="margin:20px 32px 0;"></div>

        <div class="form-section">
            <p class="section-title">Thông tin yêu cầu</p>
            <div class="form-grid">
                <div class="form-group">
                    <label>Sự kiện <span class="required">*</span></label>
                    <select asp-for="EventEquipment.EventId" class="form-control" asp-items="ViewBag.EventId">
                        <option value="">-- Chọn sự kiện --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Thiết bị <span class="required">*</span></label>
                    <select asp-for="EventEquipment.EquipmentId" class="form-control" asp-items="ViewBag.EquipmentId">
                        <option value="">-- Chọn thiết bị --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Số lượng yêu cầu <span class="required">*</span></label>
                    <input asp-for="EventEquipment.RequestedQuantity" class="form-control" type="number" min="1" placeholder="Nhập số lượng" />
                    <span asp-validation-for="EventEquipment.RequestedQuantity" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label>Ghi chú</label>
                    <input asp-for="EventEquipment.Note" class="form-control" placeholder="Ghi chú thêm (nếu có)" />
                    <span asp-validation-for="EventEquipment.Note" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Tạo yêu cầu</button>
            <a asp-page="Index" class="btn btn-ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
