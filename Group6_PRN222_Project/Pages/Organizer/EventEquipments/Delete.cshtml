@page "{eventId:int}/{equipmentId:int}"
@model Group6_PRN222_Project.Pages.Organizer.EventEquipments.DeleteModel

@{
    ViewData["Title"] = "Delete Requirement";
}

<h1>Delete Requirement</h1>

<h3>Are you sure you want to delete this requirement?</h3>
<div>
    <h4>Requirement (Event Equipment)</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Equipment
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventEquipment.Equipment.EquipmentName)
        </dd>
        <dt class="col-sm-2">
            Requested Quantity
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventEquipment.RequestedQuantity)
        </dd>
        <dt class="col-sm-2">
            Available Stock
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventEquipment.Equipment.AvailableQuantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventEquipment.Note)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventEquipment.Note)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventEquipment.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventEquipment.Status)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="EventEquipment.EventId" />
        <input type="hidden" asp-for="EventEquipment.EquipmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
