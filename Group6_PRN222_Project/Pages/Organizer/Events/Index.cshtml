@page
@model Group6_PRN222_Project.Pages.Organizer.Events.IndexModel
@{
    ViewData["Title"] = "Events";
}

<h1>Event Planning & Concept</h1>
<p>
    <a asp-page="./Create" class="btn btn-primary">Create New Event</a>
</p>
<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Organizer</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Events)
        {
            <tr>
                <td><strong>@item.EventName</strong></td>
                <td>@item.Location</td>
                <td>@item.StartDate?.ToString("d")</td>
                <td>@item.EndDate?.ToString("d")</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            "Planning" => "bg-secondary",
                            "Ongoing" => "bg-success",
                            "Completed" => "bg-primary",
                            "Cancelled" => "bg-danger",
                            _ => "bg-info text-dark"
                        };
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td>@(item.Organizer?.FullName ?? "N/A")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                </td>
            </tr>
        }
        @if (Model.Events.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center">No events found.</td>
            </tr>
        }
    </tbody>
</table>
