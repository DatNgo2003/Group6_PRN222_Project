@page
@model Group6_PRN222_Project.Pages.Organizer.Events.EditModel
@{
    ViewData["Title"] = "Edit Event";
}

<h1>Edit Event</h1>
<h4>Event Planning & Concept</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Event.EventId" />
            <div class="form-group mb-3">
                <label asp-for="Event.EventName" class="control-label">Event Name</label>
                <input asp-for="Event.EventName" class="form-control" required />
                <span asp-validation-for="Event.EventName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.StartDate" class="control-label">Start Date</label>
                <input asp-for="Event.StartDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="Event.StartDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.EndDate" class="control-label">End Date</label>
                <input asp-for="Event.EndDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="Event.EndDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.Location" class="control-label">Location</label>
                <input asp-for="Event.Location" class="form-control" />
                <span asp-validation-for="Event.Location" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.Amount" class="control-label">Ticket Price (Amount)</label>
                <input asp-for="Event.Amount" class="form-control" type="number" step="0.01" min="0" placeholder="VNĐ" />
                <span asp-validation-for="Event.Amount" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.Status" class="control-label">Status</label>
                <select asp-for="Event.Status" class="form-select" asp-items="ViewBag.StatusList"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.DeploymentMapUrl" class="control-label">Deployment Map URL</label>
                <input asp-for="Event.DeploymentMapUrl" class="form-control" />
                <span asp-validation-for="Event.DeploymentMapUrl" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Event.OrganizerId" class="control-label">Organizer</label>
                <select asp-for="Event.OrganizerId" class="form-select" asp-items="ViewBag.OrganizerId">
                    <option value="">-- Select Organizer --</option>
                </select>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            var start = document.querySelector('[name="Event.StartDate"]').value;
            var end = document.querySelector('[name="Event.EndDate"]').value;
            if (start && end && new Date(start) >= new Date(end)) {
                e.preventDefault();
                alert('Ngày bắt đầu phải trước ngày kết thúc!');
            }
        });
    </script>
}
