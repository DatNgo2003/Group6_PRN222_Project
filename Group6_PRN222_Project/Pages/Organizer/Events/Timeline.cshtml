@page
@model Group6_PRN222_Project.Pages.Organizer.Events.TimelineModel
@{
    ViewData["Title"] = "Event Timeline";
}

<div class="page-header">
    <div class="page-title">
        <h1>Event Timeline</h1>
        <p class="subtitle">Manage the progress and concept stages of <strong>@Model.Event.EventName</strong></p>
    </div>
    <a asp-page="./Index" class="btn btn-ghost">
        &larr; Back to Events
    </a>
</div>

<div class="row" style="display: flex; gap: 24px; flex-wrap: wrap; margin: 0;">
    <!-- Left Column: Timeline Configuration -->
    <div style="flex: 1; min-width: 300px;">
        <div class="card" style="padding: 24px;">
            <div style="margin-bottom: 20px;">
                <h5 style="color: var(--text-1); font-weight: 600; margin-bottom: 4px;"><i class="bi bi-pencil-square" style="color: var(--c-gold); margin-right: 8px;"></i>Edit Dynamic Steps</h5>
                <p style="color: var(--text-3); font-size: 13px; margin: 0;">Add activities and set individual milestone times.</p>
            </div>
            
            <form method="post" asp-page-handler="UpdateConcept" asp-route-id="@Model.Event.EventId" id="conceptForm">
                <div id="stepsContainer" style="margin-bottom: 16px;">
                    @for(int i = 0; i < Model.StepNames.Count; i++)
                    {
                        <div class="step-row" style="display: flex; gap: 8px; margin-bottom: 12px; align-items: stretch;">
                            <div style="background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--r-md); padding: 0 12px; display: flex; align-items: center; color: var(--text-3);">
                                <i class="bi bi-clock"></i>
                            </div>
                            <input type="datetime-local" name="StepTimes" class="form-control" value="@Model.StepTimes[i]" style="width: auto;" />
                            <input type="text" name="StepNames" class="form-control" value="@Model.StepNames[i]" placeholder="E.g. Kêu gọi nhà đầu tư" required style="flex: 1;" />
                            <button type="button" class="btn btn-ghost remove-step" style="padding: 10px; color: #f87171;" title="Remove Step">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>
                
                <button type="button" class="btn btn-ghost" style="width: 100%; border: 1px dashed var(--input-border); margin-bottom: 16px; color: var(--text-2);" id="addStepBtn">
                    <i class="bi bi-plus-lg"></i> Add New Step
                </button>

                <button type="submit" class="btn btn-primary" style="width: 100%;">Save Timeline Activities</button>
            </form>
        </div>
    </div>

    <!-- Right Column: Visual Timeline -->
    <div style="flex: 1.5; min-width: 400px;">
        <div class="card" style="padding: 24px;">
            <div style="margin-bottom: 24px;">
                <h5 style="color: var(--text-1); font-weight: 600; margin-bottom: 4px;"><i class="bi bi-diagram-3" style="color: #6ee7b7; margin-right: 8px;"></i>Interactive Timeline</h5>
                <p style="color: var(--text-3); font-size: 13px; margin: 0;">Click the check icon on any step to update the current event status.</p>
            </div>
            
            <div>
                @{
                    var conceptString = Model.Event.Concept ?? "";
                    
                    // Parse into tuples of (Time, Name)
                    var stepsList = new List<(string Time, string Name)>();
                    if(!string.IsNullOrWhiteSpace(conceptString))
                    {
                        if(conceptString.Contains("::") || conceptString.Contains("|"))
                        {
                            var items = conceptString.Split('|', StringSplitOptions.RemoveEmptyEntries);
                            foreach(var item in items)
                            {
                                var parts = item.Split("::", 2);
                                if(parts.Length == 2) stepsList.Add((parts[0], parts[1]));
                                else stepsList.Add(("", item));
                            }
                        }
                        else
                        {
                            var items = conceptString.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            foreach(var item in items) stepsList.Add(("", item.Trim()));
                        }
                    }

                    var currentStatus = Model.Event.Status ?? "";
                    var currentIndex = stepsList.FindIndex(s => s.Name == currentStatus);
                }

                @if(stepsList.Count == 0)
                {
                    <div style="background: rgba(250,248,244,.05); color: var(--text-2); padding: 16px; border-radius: var(--r-md); font-size: 13px;">
                        No concept steps defined. Please enter steps on the left.
                    </div>
                }
                else
                {
                    <div style="position: relative; padding-left: 8px; margin-top: 8px;">
                        <!-- Connecting Line -->
                        <div style="position: absolute; left: 32px; top: 0; bottom: 0; width: 2px; background-color: var(--row-bdr); z-index: 1;"></div>
                        
                        @for (int i = 0; i < stepsList.Count; i++)
                        {
                            var stepTime = stepsList[i].Time;
                            var stepName = stepsList[i].Name;
                            var isCompleted = i <= currentIndex;
                            var isCurrent = i == currentIndex;
                            
                            var iconColor = isCompleted ? "#6ee7b7" : "var(--text-4)";
                            var iconClass = isCompleted ? "bi-check-circle-fill" : "bi-circle";
                            var textColor = isCompleted ? "var(--text-1)" : "var(--text-3)";
                            var bgStyle = isCurrent ? "background: rgba(250,248,244,.03); border-left: 3px solid #6ee7b7; border-radius: var(--r-md);" : "";

                            <!-- Step Item -->
                            <div style="margin-bottom: 24px; position: relative; padding: 16px; z-index: 2; @bgStyle">
                                
                                @if(!string.IsNullOrWhiteSpace(stepTime))
                                {
                                    <div style="display: flex; align-items: flex-start; margin-bottom: 12px;">
                                        <div style="width: 50px; margin-right: 16px;"></div> <!-- Spacer -->
                                        <div>
                                            <div style="font-size: 11px; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Milestone Time</div>
                                            <div style="display: flex; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--r-md); padding: 6px 12px; font-size: 13px; color: var(--text-2);">
                                                <i class="bi bi-calendar4-week" style="margin-right: 8px; color: var(--text-4);"></i>
                                                @{
                                                    DateTime parsedDate;
                                                    var displayDate = DateTime.TryParse(stepTime, out parsedDate) 
                                                        ? parsedDate.ToString("dd-MMM-yyyy hh:mm tt") 
                                                        : stepTime;
                                                }
                                                @displayDate
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div style="display: flex; align-items: center;">
                                    <!-- Step Circle/Icon -->
                                    <div style="width: 48px; height: 48px; background: var(--card-bg); border: 1px solid var(--card-bdr); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 16px; z-index: 3;">
                                        <i class="bi @iconClass" style="font-size: 20px; color: @iconColor;"></i>
                                    </div>
                                    
                                    <!-- Step Details -->
                                    <div style="flex: 1;">
                                        <h5 style="margin: 0; font-size: 16px; font-weight: 600; color: @textColor;">@stepName</h5>
                                        @if(isCurrent){
                                            <div style="font-size: 13px; color: #6ee7b7; font-weight: 600; margin-top: 4px;"><i class="bi bi-lightning-charge-fill"></i> Current Stage</div>
                                        }
                                    </div>
                                    
                                    <!-- Action Button -->
                                    <div>
                                        @if(!isCurrent)
                                        {
                                            <form method="post" asp-page-handler="ChangeStatus" asp-route-id="@Model.Event.EventId">
                                                <input type="hidden" name="stepName" value="@stepName" />
                                                <button class="btn btn-primary" type="submit" title="Mark as Current Status" style="padding: 6px 16px; font-size: 13px; background: rgba(110,231,183,.1); color: #6ee7b7; border-color: transparent;">
                                                    <i class="bi bi-check2"></i> Set Active
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('addStepBtn').addEventListener('click', function() {
                var container = document.getElementById('stepsContainer');
                var row = document.createElement('div');
                row.className = 'step-row';
                row.style.cssText = 'display: flex; gap: 8px; margin-bottom: 12px; align-items: stretch;';
                row.innerHTML = `
                    <div style="background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--r-md); padding: 0 12px; display: flex; align-items: center; color: var(--text-3);">
                        <i class="bi bi-clock"></i>
                    </div>
                    <input type="datetime-local" name="StepTimes" class="form-control" style="width: auto;" />
                    <input type="text" name="StepNames" class="form-control" placeholder="E.g. Kêu gọi nhà đầu tư" required style="flex: 1;" />
                    <button type="button" class="btn btn-ghost remove-step" style="padding: 10px; color: #f87171;" title="Remove Step">
                        <i class="bi bi-x-lg"></i>
                    </button>
                `;
                container.appendChild(row);
            });

            document.getElementById('stepsContainer').addEventListener('click', function(e) {
                var btn = e.target.closest('.remove-step');
                if(btn) {
                    var row = btn.closest('.step-row');
                    if(document.querySelectorAll('.step-row').length > 1) {
                        row.remove();
                    } else {
                        alert('You must have at least one step in the timeline.');
                    }
                }
            });
        });
    </script>
}
