@page
@model Group6_PRN222_Project.Pages.Organizer.DiscountPolicies.IndexModel
@{
    ViewData["Title"] = "Discount Policies";
}

<h1>Discount Policies</h1>
<p>
    <a asp-page="Create" class="btn btn-primary">Create New Policy</a>
</p>
<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Policy Name</th>
            <th>Event</th>
            <th>Discount Percent</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Policies)
        {
            <tr>
                <td><strong>@item.PolicyName</strong></td>
                <td>@item.Event?.EventName</td>
                <td>@item.DiscountPercent?.ToString("0.##")%</td>
            </tr>
        }
        @if (Model.Policies.Count == 0)
        {
            <tr>
                <td colspan="3" class="text-center">No discount policies found.</td>
            </tr>
        }
    </tbody>
</table>
