@page
@model Group6_PRN222_Project.Pages.Organizer.DiscountPolicies.CreateModel
@{
    ViewData["Title"] = "Create Policy";
}

<h1>Create Discount Policy</h1>
<h4>Discount Policies Management</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="DiscountPolicy.PolicyName" class="control-label">Policy Name</label>
                <input asp-for="DiscountPolicy.PolicyName" class="form-control" required />
                <span asp-validation-for="DiscountPolicy.PolicyName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DiscountPolicy.EventId" class="control-label">Event</label>
                <select asp-for="DiscountPolicy.EventId" class="form-select" asp-items="ViewBag.EventId" required>
                    <option value="">-- Select Event --</option>
                </select>
                <span asp-validation-for="DiscountPolicy.EventId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DiscountPolicy.DiscountPercent" class="control-label">Discount Percent</label>
                <div class="input-group">
                    <input asp-for="DiscountPolicy.DiscountPercent" class="form-control" type="number" step="0.01" max="100" min="0" required />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="DiscountPolicy.DiscountPercent" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Create Policy" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
