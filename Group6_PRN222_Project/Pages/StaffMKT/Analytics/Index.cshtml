@page
@model Project_PRN222.Pages.StaffMKT.Analytics.IndexModel

@{
    ViewData["Title"] = "Staff (MKT) — Analytics";
    Layout = "~/Pages/Shared/_StaffLayout.cshtml";
}

@section Styles {
    <style>
        .page-header {
            margin-bottom: 24px;
        }

        .subtitle {
            color: var(--text-muted);
            font-weight: 700;
            font-size: .9rem;
            margin: 0;
        }

        /* Summary Cards */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .summary-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            text-align: center;
        }

            .summary-card .label {
                font-size: .75rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: var(--text-muted);
                margin-bottom: 6px;
            }

            .summary-card .value {
                font-size: 1.6rem;
                font-weight: 900;
                margin-bottom: 4px;
            }

            .summary-card .unit {
                font-size: .8rem;
                color: var(--text-muted);
            }

        /* Table styles */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: .92rem;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }

        thead th {
            text-align: left;
            padding: 12px 12px;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--text-muted);
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
        }

        tbody td {
            padding: 12px 12px;
            border-bottom: 1px solid var(--border-light);
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .event-name {
            font-weight: 900;
            color: var(--text-dark);
        }

        .status-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: .75rem;
            font-weight: 700;
        }

        .status-completed {
            background-color: #d4edda;
            color: #155724;
        }

        .status-active {
            background-color: #cfe2ff;
            color: #084298;
        }

        .status-planning {
            background-color: #fff3cd;
            color: #664d03;
        }

        /* Section divider */
        .section-divider {
            margin-top: 32px;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 900;
            margin-bottom: 12px;
        }

        /* Cost breakdown visual */
        .cost-breakdown {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .cost-item {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
        }

            .cost-item .label {
                font-size: .75rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: var(--text-muted);
                margin-bottom: 6px;
            }

            .cost-item .amount {
                font-size: 1.4rem;
                font-weight: 900;
            }

            .cost-item.warning .amount {
                color: #ff9800;
            }

            .cost-item.success .amount {
                color: #28a745;
            }
    </style>
}

<!-- Header -->
<div class="page-header">
    <h1 style="font-size:1.4rem;margin-bottom:6px;">Analytics & Cost Analysis</h1>
    <p class="subtitle">Tổng hợp phân tích dự án, chi phí, lợi nhuận và tham gia</p>
</div>

<!-- Summary Statistics -->
<div class="summary-grid">
    <div class="summary-card">
        <div class="label">Tổng Dự Án</div>
        <div class="value">@Model.TotalEvents</div>
        <div class="unit">Events</div>
    </div>
    <div class="summary-card">
        <div class="label">Tổng Ngân Sách</div>
        <div class="value">@Model.TotalBudgetAllocated.ToString("N0")</div>
        <div class="unit">VNĐ</div>
    </div>
    <div class="summary-card">
        <div class="label">Tổng Chi Tiêu</div>
        <div class="value">@Model.TotalSpentAmount.ToString("N0")</div>
        <div class="unit">VNĐ</div>
    </div>
    <div class="summary-card">
        <div class="label">Tổng Lợi Nhuận</div>
        <div class="value">@Model.TotalProfit.ToString("N0")</div>
        <div class="unit">VNĐ</div>
    </div>
    <div class="summary-card">
        <div class="label">Tổng Người Tham Gia</div>
        <div class="value">@Model.TotalParticipants</div>
        <div class="unit">Participants</div>
    </div>
    <div class="summary-card">
        <div class="label">Sử Dụng Ngân Sách</div>
        <div class="value">@Model.BudgetUtilizationPercent.ToString("0.#")%</div>
        <div class="unit">Utilized</div>
    </div>
</div>

<!-- Cost Breakdown Section -->
<div class="section-divider">
    <div class="section-title">Phân Tích Chi Phí - Giảm Vs Chi</div>
    <div class="cost-breakdown">
        <div class="cost-item warning">
            <div class="label">Chi Phí Tiếp Thị</div>
            <div class="amount">@Model.MarketingSpend.ToString("N0")</div>
            <div class="unit">Ad Spend</div>
        </div>
        <div class="cost-item warning">
            <div class="label">Chi Phí Sự Kiện</div>
            <div class="amount">@Model.BudgetSpend.ToString("N0")</div>
            <div class="unit">Budget Spent</div>
        </div>
        <div class="cost-item success">
            <div class="label">Tiết Kiệm</div>
            <div class="amount">@Model.SavingsAmount.ToString("N0")</div>
            <div class="unit">Not Spent</div>
        </div>
    </div>
</div>

<!-- Detailed Event Analytics Table -->
<div class="section-divider">
    <div class="section-title">Chi Tiết Từng Dự Án</div>
</div>

@if (!Model.Rows.Any())
{
    <div style="padding: 20px 0; color: var(--text-muted); font-weight: 800;">Chưa có dữ liệu analytics.</div>
}
else
{
    <table>
        <thead>
            <tr>
                <th style="width:180px;">Sự Kiện</th>
                <th style="width:80px;">Trạng Thái</th>
                <th style="width:100px;">Campaigns</th>
                <th style="width:120px;">Ad Spend</th>
                <th style="width:120px;">Engagement</th>
                <th style="width:120px;">Budget Alloc</th>
                <th style="width:120px;">Budget Spent</th>
                <th style="width:100px;">Utilization</th>
                <th style="width:120px;">Lợi Nhuận</th>
                <th style="width:100px;">Participants</th>
                <th style="width:100px;">Vé Bán</th>
                <th style="width:120px;">Doanh Thu Vé</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><span class="event-name">@r.EventName</span></td>
                    <td>
                        <span class="status-badge status-@r.EventStatus.ToLower()">
                            @r.EventStatus
                        </span>
                    </td>
                    <td>@r.CampaignCount</td>
                    <td>@r.TotalAdSpend.ToString("N0") <span style="color:var(--text-muted);font-size:.8rem;">VNĐ</span></td>
                    <td>@r.AvgEngagement.ToString("0.##")%</td>
                    <td>@r.BudgetAllocated.ToString("N0") <span style="color:var(--text-muted);font-size:.8rem;">VNĐ</span></td>
                    <td>@r.BudgetSpent.ToString("N0") <span style="color:var(--text-muted);font-size:.8rem;">VNĐ</span></td>
                    <td>@r.BudgetUtilization.ToString("0.#")%</td>
                    <td style="font-weight:700;color:@(r.Profit >= 0 ? "#28a745" : "#dc3545");">
                        @r.Profit.ToString("N0") <span style="color:var(--text-muted);font-size:.8rem;">VNĐ</span>
                    </td>
                    <td>@r.ParticipantCount</td>
                    <td>@r.TicketsSold</td>
                    <td>@r.TicketRevenue.ToString("N0") <span style="color:var(--text-muted);font-size:.8rem;">VNĐ</span></td>
                </tr>
            }
        </tbody>
    </table>
}