@page
@model Project_PRN222.Pages.StaffMKT.Campaigns.IndexModel

@{
    ViewData["Title"] = "Staff (MKT) — Campaigns";
    Layout = "~/Pages/Shared/_StaffLayout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h1 style="font-size:1.4rem;margin-bottom:6px;">Danh sách Campaigns</h1>
        <p class="subtitle">Theo dõi ad content, ad spend và cập nhật trạng thái chiến dịch</p>
    </div>
    <a asp-page="/StaffMKT/Campaigns/Create" class="btn btn-primary">Tạo campaign</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<form method="get" style="margin-bottom:14px; display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
    <select name="FilterEventId" class="control">
        @if (Model.FilterEventId == null) { <option value="" selected>-- Tất cả sự kiện --</option> } else { <option value="">-- Tất cả sự kiện --</option> }
        @foreach (var e in Model.Events)
        {
            if (Model.FilterEventId == e.EventId) { <option value="@e.EventId" selected>@e.EventName</option> } else { <option value="@e.EventId">@e.EventName</option> }
        }
    </select>
    <select name="FilterStatus" class="control">
        @if (string.IsNullOrWhiteSpace(Model.FilterStatus)) { <option value="" selected>-- Tất cả trạng thái --</option> } else { <option value="">-- Tất cả trạng thái --</option> }
        @if (string.Equals(Model.FilterStatus, "Running", StringComparison.OrdinalIgnoreCase)) { <option value="Running" selected>Running</option> } else { <option value="Running">Running</option> }
        @if (string.Equals(Model.FilterStatus, "Paused", StringComparison.OrdinalIgnoreCase)) { <option value="Paused" selected>Paused</option> } else { <option value="Paused">Paused</option> }
        @if (string.Equals(Model.FilterStatus, "Completed", StringComparison.OrdinalIgnoreCase)) { <option value="Completed" selected>Completed</option> } else { <option value="Completed">Completed</option> }
    </select>
    <button type="submit" class="btn btn-ghost">Lọc</button>
    <a asp-page="Index" class="btn btn-ghost">Xoá lọc</a>
</form>

@section Styles {
<style>
    .page-header { margin-bottom: 18px; display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:center; }
    .subtitle { color: var(--text-muted); font-weight: 700; font-size: .9rem; margin: 0; }
    .alert { padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 14px; font-weight: 800; font-size: .9rem; }
    .alert-success { background: #e6ffed; border-color: #b7ebc6; color: #0f5132; }
    .alert-danger  { background: #ffe8e8; border-color: #ffc3c3; color: #842029; }
    .control { padding: 9px 10px; border-radius: 10px; border: 1px solid var(--border); min-width: 230px; font-weight: 800; background: #fff; color: var(--text-primary); }
    .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:10px 14px; border-radius:10px; border:1px solid var(--border); font-weight:900; cursor:pointer; background:#fff; text-decoration:none; color:var(--text-primary); }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-ghost { background: transparent; }
    table { width: 100%; border-collapse: collapse; font-size: .92rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    thead th { text-align: left; padding: 12px 12px; font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); background: #f8fafc; border-bottom: 1px solid var(--border); }
    tbody td { padding: 12px 12px; border-bottom: 1px solid var(--border-light); vertical-align: middle; }
    tbody tr:last-child td { border-bottom: none; }
    .badge { display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-weight:900; font-size:.82rem; }
    .badge-green { background: #e8f5e9; color: #1b5e20; }
    .badge-gray { background: #f1f5f9; color: #334155; }
    .badge-blue { background: #eef2ff; color: #3730a3; }
    .content { max-width: 460px; white-space: pre-wrap; word-break: break-word; color: var(--text-primary); font-weight: 700; line-height: 1.35; }
</style>
}

@if (!Model.Campaigns.Any())
{
    <div style="padding: 20px 0; color: var(--text-muted); font-weight: 800;">Chưa có campaign phù hợp.</div>
}
else
{
    <table>
        <thead>
            <tr>
                <th style="width:100px;">ID</th>
                <th>Sự kiện</th>
                <th>Ad Content</th>
                <th style="width:140px;">Ad Spend</th>
                <th style="width:140px;">Engagement</th>
                <th style="width:260px;">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Campaigns)
            {
                <tr>
                    <td>#@c.CampaignId</td>
                    <td>@(c.Event?.EventName ?? "—")</td>
                    <td class="content">@(c.AdContent ?? "—")</td>
                    <td>@((c.AdSpend ?? 0m).ToString("N0"))</td>
                    <td>@((c.EngagementRate ?? 0m).ToString("0.##"))%</td>
                    <td>
                        <form method="post" asp-page-handler="UpdateStatus" style="display:flex; gap:10px; align-items:center;">
                            <input type="hidden" name="campaignId" value="@c.CampaignId" />
                            <select name="status" class="control" style="min-width:150px;">
                                @if (c.Status == "Running") { <option value="Running" selected>Running</option> } else { <option value="Running">Running</option> }
                                @if (c.Status == "Paused") { <option value="Paused" selected>Paused</option> } else { <option value="Paused">Paused</option> }
                                @if (c.Status == "Completed") { <option value="Completed" selected>Completed</option> } else { <option value="Completed">Completed</option> }
                            </select>
                            <button type="submit" class="btn btn-primary">Cập nhật</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
