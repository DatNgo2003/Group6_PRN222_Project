@page
@model Project_PRN222.Pages.StaffMKT.Reports.IndexModel

@{
    ViewData["Title"] = "Staff (MKT) — Reports";
    Layout = "~/Pages/Shared/_StaffLayout.cshtml";
}

@section Styles {
<style>
    .page-header { margin-bottom: 18px; }
    .subtitle { color: var(--text-muted); font-weight: 700; font-size: .9rem; margin: 0; }
    table { width: 100%; border-collapse: collapse; font-size: .92rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    thead th { text-align: left; padding: 12px 12px; font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); background: #f8fafc; border-bottom: 1px solid var(--border); }
    tbody td { padding: 12px 12px; border-bottom: 1px solid var(--border-light); vertical-align: middle; }
    tbody tr:last-child td { border-bottom: none; }
    .badge { display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-weight:900; font-size:.82rem; }
    .badge-green { background: #e8f5e9; color: #1b5e20; }
    .badge-gray { background: #f1f5f9; color: #334155; }
    .badge-blue { background: #eef2ff; color: #3730a3; }
</style>
}

<div class="page-header">
    <h1 style="font-size:1.4rem;margin-bottom:6px;">Engagement Reports</h1>
    <p class="subtitle">Báo cáo tổng hợp hiệu quả theo event từ dữ liệu campaign</p>
</div>

@if (!Model.Rows.Any())
{
    <div style="padding: 20px 0; color: var(--text-muted); font-weight: 800;">Chưa có dữ liệu báo cáo.</div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Sự kiện</th>
                <th style="width:120px;">Campaigns</th>
                <th style="width:150px;">Ad Spend</th>
                <th style="width:150px;">Avg Engagement</th>
                <th style="width:140px;">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td style="font-weight:900;">@r.EventName</td>
                    <td>@r.CampaignCount</td>
                    <td>@r.TotalAdSpend.ToString("N0")</td>
                    <td>@r.AvgEngagement.ToString("0.##")%</td>
                    <td>
                        @{
                            var cls = r.OverallStatus == "Completed" ? "badge-green" : r.OverallStatus == "Paused" ? "badge-gray" : "badge-blue";
                        }
                        <span class="badge @cls">@r.OverallStatus</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
