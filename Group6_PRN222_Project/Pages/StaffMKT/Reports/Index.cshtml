@page
@using Project_PRN222.Helpers
@model Project_PRN222.Pages.StaffMKT.Reports.IndexModel

@{
    ViewData["Title"] = "Báo cáo hiện trường (MKT)";
    Layout = "~/Pages/Shared/_StaffLayout.cshtml";
}

<div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:20px;">
    <div>
        <h1 style="font-size:1.4rem;margin-bottom:6px;">Báo cáo Marketing (FieldReport)</h1>
        <p style="color:var(--text-muted);font-size:.9rem;margin:0;">Estimate chi tiết theo task lưu trong nội dung; cột tổng tiền = tổng các dòng.</p>
    </div>
    <a asp-page="Create" style="display:inline-flex;align-items:center;padding:10px 18px;border-radius:10px;background:#1f6e43;color:#fff;font-weight:700;text-decoration:none;">+ Tạo báo cáo</a>
</div>

@if (TempData["Success"] != null)
{
    <div style="margin-bottom:14px;padding:12px 14px;border-radius:10px;background:#e8f5e9;color:#1b5e20;font-weight:600;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="margin-bottom:14px;padding:12px 14px;border-radius:10px;background:#ffebee;color:#b71c1c;font-weight:600;">@TempData["Error"]</div>
}

<div style="background:var(--card-bg);border:1px solid var(--border);border-radius:14px;overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;font-size:.9rem;">
        <thead>
            <tr style="background:#f8fafc;">
                <th style="text-align:left;padding:12px 14px;border-bottom:1px solid var(--border);">#</th>
                <th style="text-align:left;padding:12px 14px;border-bottom:1px solid var(--border);">Sự kiện</th>
                <th style="text-align:right;padding:12px 14px;border-bottom:1px solid var(--border);">Tổng (VNĐ)</th>
                <th style="text-align:left;padding:12px 14px;border-bottom:1px solid var(--border);">Thời gian</th>
                <th style="text-align:left;padding:12px 14px;border-bottom:1px solid var(--border);">Trạng thái</th>
                <th style="text-align:left;padding:12px 14px;border-bottom:1px solid var(--border);"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reports)
            {
                var preview = MarketingFieldReportContent.PreviewPlainText(r.Content);
                <tr>
                    <td style="padding:12px 14px;border-bottom:1px solid var(--border-light);font-weight:800;">@r.ReportId</td>
                    <td style="padding:12px 14px;border-bottom:1px solid var(--border-light);">
                        <strong>@(r.Event?.EventName ?? "—")</strong>
                        @if (!string.IsNullOrEmpty(preview))
                        {
                            <div style="margin-top:6px;font-size:.82rem;color:var(--text-muted);font-weight:500;">@preview</div>
                        }
                    </td>
                    <td style="padding:12px 14px;border-bottom:1px solid var(--border-light);text-align:right;font-weight:800;color:#1f6e43;">@(r.EstimatePrice.HasValue ? r.EstimatePrice.Value.ToString("N0") : "—")</td>
                    <td style="padding:12px 14px;border-bottom:1px solid var(--border-light);color:var(--text-muted);">@(r.ReportTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td style="padding:12px 14px;border-bottom:1px solid var(--border-light);">
                        @{
                            var st = r.Status ?? "Submitted";
                            var badge = st == "Draft" ? "badge-gray" : st == "Approved" ? "badge-green" : st == "Rejected" ? "badge-warn" : "badge-blue";
                        }
                        <span class="badge @badge">@st</span>
                    </td>
                    <td style="padding:12px 14px;border-bottom:1px solid var(--border-light);white-space:nowrap;">
                        @if (r.Status == "Draft")
                        {
                            <a asp-page="Edit" asp-route-id="@r.ReportId" style="font-weight:700;color:#1f6e43;">Sửa nháp</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Reports.Any())
            {
                <tr>
                    <td colspan="6" style="padding:28px;text-align:center;color:var(--text-muted);font-weight:600;">Chưa có báo cáo nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Styles {
<style>
    .badge { display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-weight:800; font-size:.78rem; }
    .badge-green { background:#e8f5e9;color:#1b5e20;}
    .badge-gray { background:#f1f5f9;color:#334155;}
    .badge-blue { background:#eef2ff;color:#3730a3;}
    .badge-warn { background:#fff3e0;color:#e65100;}
</style>
}
