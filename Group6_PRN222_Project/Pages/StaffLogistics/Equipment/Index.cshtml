@page
@model Project_PRN222.Pages.StaffLogistics.Equipment.IndexModel

@{
    ViewData["Title"] = "Staff (Logistics) — Equipment";
    
}

<div class="page-header">
    <div class="page-title">
        <h1 style="font-size:1.4rem;margin-bottom:6px;">Danh sách Equipment</h1>
        <p class="subtitle">Theo dõi tồn kho phục vụ vận hành thực địa</p>
    </div>
    <div style="margin-top:14px;">
        <a asp-page="/StaffLogistics/Reports/Create" asp-route-reportType="Equipment" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px; background:var(--accent); border:1px solid var(--accent); color:#fff; font-weight:900; text-decoration:none;">
            Tạo Equipment Report
        </a>
    </div>
</div>



@section Styles {
<style>

</style>
}

@if (!Model.Equipments.Any())
{
    <div style="padding: 20px 0; color: var(--text-muted); font-weight: 800;">
        Chưa có dữ liệu equipment.
    </div>
}
else
{
<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:80px;">ID</th>
                    <th>Equipment Name</th>
                    <th>Total Owned</th>
                    <th>Available</th>
                    <th>Defective</th>
                    <th>Outsourced</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Equipments)
                {
                    <tr>
                        <td class="id-cell">#@e.EquipmentId</td>
                        <td><strong>@(e.EquipmentName ?? "—")</strong></td>
                        <td>@e.TotalOwned</td>
                        <td style="color:#6ee7b7; font-weight:600;">@e.AvailableQuantity</td>
                        <td style="color:#f87171; font-weight:600;">@e.DefectiveQuantity</td>
                        <td style="color:var(--c-gold); font-weight:600;">@e.OutsourcedQuantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

