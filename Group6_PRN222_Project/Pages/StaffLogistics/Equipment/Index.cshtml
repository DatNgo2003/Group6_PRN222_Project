@page
@model Project_PRN222.Pages.StaffLogistics.Equipment.IndexModel

@{
    ViewData["Title"] = "Staff (Logistics) — Equipment";
    Layout = "~/Pages/Shared/_StaffLayout.cshtml";
}

<div class="page-header">
    <div class="page-title">
        <h1 style="font-size:1.4rem;margin-bottom:6px;">Danh sách Equipment</h1>
        <p class="subtitle">Theo dõi tồn kho phục vụ vận hành thực địa</p>
    </div>
    <div style="margin-top:14px;">
        <a asp-page="/StaffLogistics/Reports/Create" asp-route-reportType="Equipment" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px; background:var(--accent); border:1px solid var(--accent); color:#fff; font-weight:900; text-decoration:none;">
            Tạo Equipment Report
        </a>
    </div>
</div>

<form method="get" style="margin-bottom: 14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <select name="FilterStatus" class="control">
        @if (string.IsNullOrWhiteSpace(Model.FilterStatus))
        {
            <option value="" selected>-- Tất cả trạng thái --</option>
        }
        else
        {
            <option value="">-- Tất cả trạng thái --</option>
        }

        @if (string.Equals(Model.FilterStatus, "Available", StringComparison.OrdinalIgnoreCase))
        {
            <option value="Available" selected>Available</option>
        }
        else
        {
            <option value="Available">Available</option>
        }

        @if (string.Equals(Model.FilterStatus, "Unavailable", StringComparison.OrdinalIgnoreCase))
        {
            <option value="Unavailable" selected>Unavailable</option>
        }
        else
        {
            <option value="Unavailable">Unavailable</option>
        }

        @if (string.Equals(Model.FilterStatus, "Maintenance", StringComparison.OrdinalIgnoreCase))
        {
            <option value="Maintenance" selected>Maintenance</option>
        }
        else
        {
            <option value="Maintenance">Maintenance</option>
        }
    </select>
    <button type="submit" class="btn btn-ghost" style="padding:10px 14px; border-radius:10px; border:1px solid var(--border); background:#fff; font-weight:900; cursor:pointer;">
        Lọc
    </button>
    <a asp-page="Index" class="btn btn-ghost" style="padding:10px 14px; border-radius:10px; border:1px solid var(--border); background:#fff; font-weight:900; text-decoration:none; color:var(--text-primary);">
        Xoá lọc
    </a>
</form>

@section Styles {
<style>
    .subtitle { color: var(--text-muted); font-weight: 700; font-size: .9rem; margin: 0; }
    .control {
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: #fff;
        font-weight: 800;
        color: var(--text-primary);
        min-width: 220px;
    }

    table { width: 100%; border-collapse: collapse; font-size: .92rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    thead th {
        text-align: left;
        padding: 12px 12px;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
    }
    tbody td { padding: 12px 12px; border-bottom: 1px solid var(--border-light); vertical-align: middle; }
    tbody tr:last-child td { border-bottom: none; }

    .id { color: var(--text-muted); font-weight: 800; font-size: .9rem; }
    .btn { cursor:pointer; }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-primary:hover { background: var(--accent-dim); border-color: var(--accent-dim); }
    .badge {
        display:inline-flex; align-items:center;
        padding:4px 10px; border-radius:999px;
        font-weight:900; font-size:.82rem;
    }
    .badge-green { background: #e8f5e9; color: #1b5e20; }
    .badge-gray { background: #f1f5f9; color: #334155; }
    .badge-amber { background: #fff7ed; color: #9a3412; }
</style>
}

@if (!Model.Equipments.Any())
{
    <div style="padding: 20px 0; color: var(--text-muted); font-weight: 800;">
        Chưa có dữ liệu equipment.
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th style="width:120px;">ID</th>
                <th>Equipment</th>
                <th style="width:160px;">TotalStock</th>
                <th style="width:180px;">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Equipments)
            {
                <tr>
                    <td class="id">@e.EquipmentId</td>
                    <td style="font-weight:900;">@(e.EquipmentName ?? "—")</td>
                    <td>@e.TotalStock</td>
                    <td>
                        @{
                            var status = e.Status ?? "Unknown";
                            var cls = status == "Available" ? "badge-green" : status == "Maintenance" ? "badge-amber" : "badge-gray";
                        }
                        <span class="badge @cls">@status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

