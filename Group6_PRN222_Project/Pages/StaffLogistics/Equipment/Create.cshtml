@page
@model Project_PRN222.Pages.StaffLogistics.Equipment.CreateModel
@{
    ViewData["Title"] = "Thêm thiết bị mới";
}

<div class="page-header">
    <div class="page-title">
        <h1>Thêm thiết bị mới</h1>
        <p class="subtitle">Đăng ký thiết bị mới vào hệ thống quản lý kho</p>
    </div>
    <a asp-page="./Index" class="back-link">← Quay lại danh sách</a>
</div>

<div class="form-card">
    <form method="post">
        <div class="form-section">
            <h3 class="section-title">Thông tin thiết bị</h3>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="form-grid">
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label asp-for="Equipment.EquipmentName">Tên thiết bị <span class="required">*</span></label>
                    <input asp-for="Equipment.EquipmentName" class="form-control" placeholder="Ví dụ: Loa hội trường JBL, Đèn sân khấu 500W..." required />
                    <span class="field-error" asp-validation-for="Equipment.EquipmentName"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Equipment.UnitPrice">Đơn giá (Ước tính)</label>
                    <input asp-for="Equipment.UnitPrice" class="form-control" type="number" step="0.01" min="0" />
                    <span class="field-error" asp-validation-for="Equipment.UnitPrice"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Equipment.TotalOwned">Số lượng ban đầu <span class="required">*</span></label>
                    <input asp-for="Equipment.TotalOwned" class="form-control" type="number" min="1" required />
                    <span class="field-error" asp-validation-for="Equipment.TotalOwned"></span>
                    <div style="font-size:.7rem; color:var(--text-3); margin-top:4px;">Thiết bị sẽ được tự động cộng vào Tồn kho khả dụng.</div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <div style="font-size:.8rem; color:var(--text-3); align-self:center;">
                * Vui lòng kiểm tra kỹ thông tin trước khi lưu.
            </div>
            <button type="submit" class="btn btn-primary" style="margin-left:auto;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Lưu thiết bị
            </button>
        </div>
    </form>
</div>
