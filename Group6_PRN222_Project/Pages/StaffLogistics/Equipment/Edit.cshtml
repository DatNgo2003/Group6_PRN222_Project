@page "{id:int}"
@model Project_PRN222.Pages.StaffLogistics.Equipment.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa thiết bị";
}

<div class="page-header">
    <div class="page-title">
        <h1>Chỉnh sửa thiết bị</h1>
        <p class="subtitle">Cập nhật thông tin và điều chỉnh số lượng tồn kho cho @Model.Equipment.EquipmentName</p>
    </div>
    <a asp-page="./Index" class="back-link">← Quay lại danh sách</a>
</div>

<div class="form-card">
    <form method="post">
        <input type="hidden" asp-for="Equipment.EquipmentId" />
        <div class="form-section">
            <h3 class="section-title">Thông tin thiết bị</h3>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="form-grid">
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label asp-for="Equipment.EquipmentName">Tên thiết bị <span class="required">*</span></label>
                    <input asp-for="Equipment.EquipmentName" class="form-control" required />
                    <span class="field-error" asp-validation-for="Equipment.EquipmentName"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Equipment.UnitPrice">Đơn giá (Ước tính)</label>
                    <input asp-for="Equipment.UnitPrice" class="form-control" type="number" step="0.01" min="0" />
                    <span class="field-error" asp-validation-for="Equipment.UnitPrice"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Equipment.TotalOwned">Tổng số lượng sở hữu <span class="required">*</span></label>
                    <input asp-for="Equipment.TotalOwned" class="form-control" type="number" min="0" required />
                    <span class="field-error" asp-validation-for="Equipment.TotalOwned"></span>
                    <div style="font-size:.7rem; color:var(--text-3); margin-top:4px;">Nếu giảm số lượng này, hệ thống coi là <strong>Mất đồ</strong>.</div>
                </div>

                <div class="form-group">
                    <label asp-for="Equipment.DefectiveQuantity">Số lượng hỏng hóc (Hỏng/Lỗi)</label>
                    <input asp-for="Equipment.DefectiveQuantity" class="form-control" type="number" min="0" required />
                    <span class="field-error" asp-validation-for="Equipment.DefectiveQuantity"></span>
                    <div style="font-size:.7rem; color:var(--text-3); margin-top:4px;">Nếu tăng số lượng này, hệ thống sẽ trừ từ <strong>Số lượng khả dụng</strong>.</div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <div style="font-size:.8rem; color:var(--text-3); align-self:center;">
                * Cẩn thận khi giảm số lượng vì có thể ảnh hưởng đến các phiếu đang xử lý.
            </div>
            <button type="submit" class="btn btn-primary" style="background:#B8975A; color:#1A1714; margin-left:auto;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>
