@page
@model Project_PRN222.Pages.StaffLogistics.IndexModel

@{
    ViewData["Title"] = "Staff (Logistics) — Dashboard";
    
}

<div class="page-header">
    <div class="page-title">
        <h1>Vận hành thực địa</h1>
        <p class="subtitle">Tác vụ & báo cáo logistics dành cho Staff (Logistics)</p>
    </div>
    <div class="header-actions">
        <a asp-page="/StaffLogistics/Tasks/Index" class="btn btn-secondary">Xem Tasks</a>
        <a asp-page="/StaffLogistics/Reports/Create" class="btn btn-primary">Tạo báo cáo</a>
    </div>
</div>

@section Styles {
<style>
    .page-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; gap:16px; flex-wrap:wrap; }
    .page-title h1 { font-family:var(--ff-display); font-size:1.85rem; font-weight:700; margin:0 0 4px; color:var(--text-1); letter-spacing:-.02em; line-height:1.1; }
    .subtitle { color:var(--text-3); font-size:.845rem; margin:0; }
    .header-actions { display:flex; gap:10px; flex-wrap:wrap; }

    .btn {
        display:inline-flex; align-items:center; gap:8px;
        padding:10px 16px; border-radius:var(--r-sm); font-weight:600; font-size:.845rem;
        text-decoration:none; border:1px solid transparent; font-family:var(--ff-body);
    }
    .btn-primary { background: var(--c-gold); color: var(--c-ink); }
    .btn-primary:hover { background: var(--c-gold-dim); }
    .btn-secondary { background: rgba(250,248,244,.07); color: var(--text-2); border-color: var(--card-bdr); }
    .btn-secondary:hover { background: rgba(250,248,244,.11); }

    .grid-3 { display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:16px; }
    @@media (max-width: 900px) { .grid-3 { grid-template-columns: 1fr; } }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--card-bdr);
        border-radius: var(--r-md);
        padding: 18px 24px;
    }
    .stat-label { color: var(--text-3); font-weight:600; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; }
    .stat-value { font-size: 2.2rem; font-weight: 700; margin-top: 10px; color: var(--c-gold); font-family:var(--ff-display); }

    .card {
        background: var(--card-bg);
        border: 1px solid var(--card-bdr);
        border-radius: var(--r-lg);
        overflow: hidden;
        margin-top: 24px;
    }
    .card-head { padding: 18px 24px; border-bottom: 1px solid var(--card-bdr); display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; background:rgba(0,0,0,.12); }
    .card-head h2 { font-size:1.05rem; font-weight:600; font-family:var(--ff-display); margin:0; }
    .card-body { overflow-x:auto; }

    table { width:100%; border-collapse:collapse; font-size:.855rem; }
    th { text-align:left; padding: 11px 18px; font-size:.71rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color: var(--text-3); background:var(--table-head); border-bottom: 1px solid var(--card-bdr); }
    td { padding: 12px 18px; border-bottom: 1px solid rgba(250,248,244,.055); vertical-align:middle; }
    tr:last-child td { border-bottom:none; }
    tbody tr:hover { background: rgba(184,151,90,.04); }

    .badge {
        display:inline-flex; align-items:center; padding:3px 10px; border-radius:20px;
        font-weight:600; font-size:.72rem;
        background: rgba(184,151,90,.15); color: var(--c-gold);
    }
</style>
}

<div class="grid-3">
    <div class="stat-card">
        <div class="stat-label">To Do</div>
        <div class="stat-value">@Model.ToDoCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">In Progress</div>
        <div class="stat-value">@Model.InProgressCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Done</div>
        <div class="stat-value">@Model.DoneCount</div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>Gần đây nhất</h2>
        <div style="color:var(--text-3); font-weight:500; font-size:.8rem; font-family:var(--ff-mono);">
            Logistics: <strong style="color:var(--text-1)">@Model.LogisticsReportsCount</strong> |
            Equipment: <strong style="color:var(--text-1)">@Model.EquipmentReportsCount</strong> |
            Issues: <strong style="color:var(--text-1)">@Model.IssueReportsCount</strong>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.RecentTasks.Any())
        {
            <div style="padding:18px 0; color:var(--text-muted); font-weight:700;">
                Chưa có task nào được gán cho bạn.
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Sự kiện</th>
                        <th>Deadline</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.RecentTasks)
                {
                    <tr>
                        <td style="font-weight:800;">@(t.TaskName ?? "—")</td>
                        <td>@(t.Event?.EventName ?? "—")</td>
                        <td>@(t.Deadline?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>
                            <span class="badge">@(t.Status ?? "—")</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

