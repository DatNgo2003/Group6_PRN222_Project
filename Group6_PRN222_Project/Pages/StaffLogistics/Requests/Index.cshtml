@page
@model Group6_PRN222_Project.Pages.StaffLogistics.Requests.IndexModel
@{
    ViewData["Title"] = "Yêu cầu cấp phát";
}

<div class="page-header">
    <div class="page-title">
        <h1>Yêu cầu cấp phát</h1>
        <p class="subtitle">Quản lý và xét duyệt các yêu cầu thiết bị từ Organizer</p>
    </div>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Sự kiện</th>
                    <th>Thiết bị</th>
                    <th>SL Yêu cầu</th>
                    <th>Tồn kho khả dụng</th>
                    <th>SL Đã Duyệt</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Requests)
                {
                    <tr>
                        <td><strong>@item.Event.EventName</strong></td>
                        <td>@item.Equipment.EquipmentName</td>
                        <td style="color:var(--text-3)">@item.RequestedQuantity</td>
                        <td>
                            @{ 
                                var avaiStock = item.Equipment.AvailableQuantity;
                                var isSufficient = avaiStock >= item.RequestedQuantity;
                                var colorClass = isSufficient ? "color:#6ee7b7" : "color:#f87171";
                            }
                            <span style="@colorClass; font-weight:600">@avaiStock</span>
                        </td>
                        <td style="color:var(--c-gold)">@item.ApprovedQuantity</td>
                        <td>
                            @{
                                var bc = item.Status == "Approved" ? "background:rgba(74,154,122,.12);color:#6ee7b7" :
                                         item.Status == "Pending" ? "background:rgba(184,151,90,.15);color:var(--c-gold)" :
                                         "background:rgba(250,248,244,.07);color:var(--text-3)";
                            }
                            <span class="role-badge" style="@bc">@item.Status</span>
                        </td>
                        <td class="action-cell">
                            @if (item.Status == "Pending")
                            {
                                <a asp-page="./Process" asp-route-eventId="@item.EventId" asp-route-equipmentId="@item.EquipmentId" class="btn-action btn-edit">Xét duyệt</a>
                            }
                            else if (item.Status == "Approved")
                            {
                                <a asp-page="./Export" asp-route-eventId="@item.EventId" asp-route-equipmentId="@item.EquipmentId" class="btn-action btn-edit" style="color:#6ee7b7; border-color:rgba(110,231,183,0.3); background:rgba(110,231,183,0.08);">Xuất kho</a>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Requests.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <div class="empty-icon">⊘</div>
                            <div>Không có yêu cầu nào đang chờ xử lý.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
