@page
@model Project_PRN222.Pages.StaffLogistics.Reports.IndexModel

@{
    ViewData["Title"] = "Staff (Logistics) — Reports";
    Layout = "~/Pages/Shared/_StaffLayout.cshtml";
}

@section Styles {
<style>
    .page-header { margin-bottom: 18px; }
    .subtitle { color: var(--text-muted); font-weight: 700; font-size: .9rem; margin: 0; }

    .card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .card-head {
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .form-row { display:flex; gap: 10px; flex-wrap: wrap; align-items:center; }

    .control {
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: #fff;
        font-weight: 800;
        color: var(--text-primary);
    }
    textarea.control { min-height: 120px; }

    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    thead th {
        text-align: left;
        padding: 12px 12px;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
    }
    tbody td { padding: 12px 12px; border-bottom: 1px solid var(--border-light); vertical-align: top; }
    tbody tr:last-child td { border-bottom: none; }

    .badge {
        display:inline-flex; align-items:center;
        padding:4px 10px; border-radius:999px;
        font-weight:900; font-size:.82rem;
        background: #eef2ff; color: #3730a3;
    }
    .badge-green { background: #e8f5e9; color: #1b5e20; }
    .badge-purple { background: #f1e9ff; color: #4a235a; }

    .content {
        max-width: 520px;
        white-space: pre-wrap;
        word-break: break-word;
        color: var(--text-primary);
        font-weight: 700;
        line-height: 1.35;
    }
</style>
}

<div class="page-header">
    <div>
        <h1 style="font-size:1.4rem;margin-bottom:6px;">Báo cáo của bạn</h1>
        <p class="subtitle">Logistics reports / Equipment reports (từ bảng FieldReports)</p>
    </div>
    <div style="margin-top:14px;">
        <a asp-page="/StaffLogistics/Reports/Create" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px; background:var(--accent); border:1px solid var(--accent); color:#fff; font-weight:900; text-decoration:none;">
            Tạo báo cáo mới
        </a>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <form method="get" class="form-row">
            <select name="FilterEventId" class="control">
                @if (Model.FilterEventId == null)
                {
                    <option value="" selected>-- Tất cả sự kiện --</option>
                }
                else
                {
                    <option value="">-- Tất cả sự kiện --</option>
                }

                @foreach (var e in Model.Events)
                {
                    if (Model.FilterEventId == e.EventId)
                    {
                        <option value="@e.EventId" selected>@e.EventName</option>
                    }
                    else
                    {
                        <option value="@e.EventId">@e.EventName</option>
                    }
                }
            </select>

            <select name="FilterReportType" class="control" style="min-width:220px;">
                @if (string.IsNullOrWhiteSpace(Model.FilterReportType) || string.Equals(Model.FilterReportType, "All", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="" selected>-- Tất cả loại --</option>
                }
                else
                {
                    <option value="">-- Tất cả loại --</option>
                }

                @if (string.Equals(Model.FilterReportType, "Logistics", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Logistics" selected>Logistics</option>
                }
                else
                {
                    <option value="Logistics">Logistics</option>
                }

                @if (string.Equals(Model.FilterReportType, "Equipment", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Equipment" selected>Equipment</option>
                }
                else
                {
                    <option value="Equipment">Equipment</option>
                }
            </select>

            <button type="submit" class="btn btn-ghost" style="padding:10px 14px; border-radius:10px; border:1px solid var(--border); background:#fff; font-weight:900; cursor:pointer;">
                Lọc
            </button>
            <a asp-page="Index" class="btn btn-ghost" style="padding:10px 14px; border-radius:10px; border:1px solid var(--border); background:#fff; font-weight:900; text-decoration:none; color:var(--text-primary);">
                Xoá lọc
            </a>
        </form>
    </div>

    <div style="overflow-x:auto;">
        @if (!Model.Reports.Any())
        {
            <div style="padding: 18px; color: var(--text-muted); font-weight: 900;">
                Không có báo cáo phù hợp.
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width:160px;">Loại</th>
                        <th>Sự kiện</th>
                        <th style="width:180px;">Thời gian</th>
                        <th>Nội dung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reports)
                    {
                        <tr>
                            <td>
                                @{
                                    var type = r.ReportType ?? "";
                                    var cls = type == "Equipment" ? "badge-purple" : "badge-green";
                                }
                                <span class="badge @cls">@type</span>
                            </td>
                            <td>@(r.Event?.EventName ?? "—")</td>
                            <td>@(r.ReportTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="content">@(r.Content ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

