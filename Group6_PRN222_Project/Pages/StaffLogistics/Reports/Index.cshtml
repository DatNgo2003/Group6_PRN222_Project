@page
@model Project_PRN222.Pages.StaffLogistics.Reports.IndexModel

@{
    ViewData["Title"] = "Staff (Logistics) — Reports";
}

<div class="page-header">
    <div class="page-title">
        <h1>Báo cáo của bạn</h1>
        <p class="subtitle">Logistics reports / Equipment reports (từ bảng FieldReports)</p>
    </div>
    <div class="header-actions">
        <a asp-page="/StaffLogistics/Reports/Create" class="btn btn-primary">+ Tạo báo cáo mới</a>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <form method="get" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
            <select name="FilterEventId" class="form-control">
                @if (Model.FilterEventId == null)
                {
                    <option value="" selected>-- Tất cả sự kiện --</option>
                }
                else
                {
                    <option value="">-- Tất cả sự kiện --</option>
                }

                @foreach (var e in Model.Events)
                {
                    if (Model.FilterEventId == e.EventId)
                    {
                        <option value="@e.EventId" selected>@e.EventName</option>
                    }
                    else
                    {
                        <option value="@e.EventId">@e.EventName</option>
                    }
                }
            </select>

            <select name="FilterReportType" class="form-control">
                @if (string.IsNullOrWhiteSpace(Model.FilterReportType) || string.Equals(Model.FilterReportType, "All", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="" selected>-- Tất cả loại --</option>
                }
                else
                {
                    <option value="">-- Tất cả loại --</option>
                }

                @if (string.Equals(Model.FilterReportType, "Logistics", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Logistics" selected>Logistics</option>
                }
                else
                {
                    <option value="Logistics">Logistics</option>
                }

                @if (string.Equals(Model.FilterReportType, "Equipment", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Equipment" selected>Equipment</option>
                }
                else
                {
                    <option value="Equipment">Equipment</option>
                }

                @if (string.Equals(Model.FilterReportType, "Issue", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Issue" selected>Issue</option>
                }
                else
                {
                    <option value="Issue">Issue</option>
                }
            </select>

            <select name="FilterStatus" class="form-control">
                @if (string.IsNullOrWhiteSpace(Model.FilterStatus) || string.Equals(Model.FilterStatus, "All", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="" selected>-- Tất cả trạng thái --</option>
                }
                else
                {
                    <option value="">-- Tất cả trạng thái --</option>
                }

                @if (string.Equals(Model.FilterStatus, "Submitted", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Submitted" selected>Submitted</option>
                }
                else
                {
                    <option value="Submitted">Submitted</option>
                }

                @if (string.Equals(Model.FilterStatus, "Reviewed", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Reviewed" selected>Reviewed</option>
                }
                else
                {
                    <option value="Reviewed">Reviewed</option>
                }

                @if (string.Equals(Model.FilterStatus, "Resolved", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="Resolved" selected>Resolved</option>
                }
                else
                {
                    <option value="Resolved">Resolved</option>
                }
            </select>

            <button type="submit" class="btn btn-secondary" style="height:36px; line-height:36px; padding:0 14px;">Lọc</button>
            <a asp-page="Index" class="btn btn-secondary" style="height:36px; line-height:36px; padding:0 14px;">Xoá lọc</a>
        </form>
    </div>

    <div class="table-wrapper" style="overflow-x:auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:140px;">Loại</th>
                    <th style="width:140px;">Trạng thái</th>
                    <th>Sự kiện</th>
                    <th style="width:160px;">Thời gian</th>
                    <th>Nội dung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td>
                            @{
                                var type = r.ReportType ?? "";
                                var badgeType = type == "Equipment" ? "background:rgba(184,151,90,.15); color:var(--c-gold)" : 
                                                type == "Issue" ? "background:rgba(220,60,60,.12); color:#f87171" : 
                                                "background:rgba(110,231,183,.12); color:#6ee7b7";
                            }
                            <span class="role-badge" style="@badgeType">@type</span>
                        </td>
                        <td>
                            @{
                                var reportStatus = r.Status ?? "Submitted";
                                var statusClass = reportStatus == "Resolved" ? "background:rgba(110,231,183,.12); color:#6ee7b7" : 
                                                  reportStatus == "Reviewed" ? "background:rgba(184,151,90,.15); color:var(--c-gold)" : 
                                                  "background:rgba(250,248,244,.07); color:var(--text-3)";
                            }
                            <span class="role-badge" style="@statusClass">@reportStatus</span>
                        </td>
                        <td><strong>@(r.Event?.EventName ?? "—")</strong></td>
                        <td style="color:var(--text-3); font-family:var(--ff-mono);">@(r.ReportTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td style="color:var(--text-1); font-weight:600; white-space:pre-wrap;">@(r.Content ?? "—")</td>
                    </tr>
                }
                @if (!Model.Reports.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <div class="empty-icon">📝</div>
                            <div>Không có báo cáo phù hợp.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
