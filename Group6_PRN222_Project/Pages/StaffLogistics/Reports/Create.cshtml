@page
@model Project_PRN222.Pages.StaffLogistics.Reports.CreateModel

@{
    ViewData["Title"] = "Thêm báo cáo";
}

<div class="page-header">
    <div class="page-title">
        <h1>Tạo báo cáo thao tác</h1>
        <p class="subtitle">Loại: Logistics / Equipment / Issue — nội dung mô tả tình hình thực địa</p>
    </div>
    <a asp-page="Index" class="back-link">← Quay lại danh sách</a>
</div>

<div class="form-card">
    <div class="form-section">
        <form method="post">
            <h3 class="section-title">Thông tin Báo cáo</h3>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" style="margin-bottom:16px;">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="EventId">Sự kiện <span class="required">*</span></label>
                    <select asp-for="EventId" class="form-control">
                        @foreach (var e in Model.Events)
                        {
                            if (Model.EventId == e.EventId)
                            {
                                <option value="@e.EventId" selected>@e.EventName</option>
                            }
                            else
                            {
                                <option value="@e.EventId">@e.EventName</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="ReportType">Loại báo cáo <span class="required">*</span></label>
                    <select asp-for="ReportType" class="form-control">
                        @if (string.Equals(Model.ReportType, "Logistics", StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="Logistics" selected>Logistics</option>
                        }
                        else
                        {
                            <option value="Logistics">Logistics</option>
                        }

                        @if (string.Equals(Model.ReportType, "Equipment", StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="Equipment" selected>Equipment</option>
                        }
                        else
                        {
                            <option value="Equipment">Equipment</option>
                        }

                        @if (string.Equals(Model.ReportType, "Issue", StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="Issue" selected>Issue</option>
                        }
                        else
                        {
                            <option value="Issue">Issue</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label asp-for="ReportContent">Nội dung báo cáo <span class="required">*</span></label>
                    <textarea asp-for="ReportContent" class="form-control" rows="8" placeholder="Ví dụ: tình hình thiết bị, checklist, issue phát sinh..."></textarea>
                    <div style="font-size:.75rem; color:var(--text-3); margin-top:4px;">Ghi rõ thông tin quan trọng để Admin/Organizer theo dõi.</div>
                </div>
            </div>

            <div class="form-actions mt-4" style="background:transparent; padding:0; border:none;">
                <button type="submit" class="btn btn-primary" style="background:#6ee7b7; color:#064e3b;">Lưu báo cáo</button>
            </div>
        </form>
    </div>
</div>
