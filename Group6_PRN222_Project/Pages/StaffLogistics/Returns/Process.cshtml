@page "{eventId:int}/{equipmentId:int}"
@model Group6_PRN222_Project.Pages.StaffLogistics.Returns.ProcessModel
@{
    ViewData["Title"] = "Ghi nhận trả thiết bị";
}

<div class="page-header">
    <div class="page-title">
        <h1>Xử lý thu hồi thiết bị</h1>
        <p class="subtitle">Kiểm đếm và đánh giá tình trạng thiết bị sau sự kiện</p>
    </div>
    <a asp-page="./Index" class="back-link">← Quay lại danh sách</a>
</div>

<div class="form-card">
    <div class="form-section">
        <h3 class="section-title">Thông tin Phiếu xuất</h3>
        <dl class="row mb-0 mt-3" style="font-size:.875rem;">
            <dt class="col-sm-3" style="color:var(--text-2);">Sự kiện:</dt>
            <dd class="col-sm-9" style="font-weight:600;">@Model.RequestDetails.Event.EventName</dd>

            <dt class="col-sm-3" style="color:var(--text-2);">Thiết bị:</dt>
            <dd class="col-sm-9" style="font-weight:600;">@Model.RequestDetails.Equipment.EquipmentName</dd>
            
            <dt class="col-sm-3" style="color:var(--c-gold);">Số lượng cần thu hồi:</dt>
            <dd class="col-sm-9" style="color:var(--c-gold); font-weight:800; font-size:1.1rem;">@Model.RequestDetails.ExportedQuantity</dd>
        </dl>
    </div>

    <form method="post">
        <input type="hidden" asp-for="RequestDetails.EventId" />
        <input type="hidden" asp-for="RequestDetails.EquipmentId" />

        <div class="form-section">
            <h3 class="section-title">Kết quả kiểm đếm</h3>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="margin-bottom:18px;"></div>
            
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="GoodQty">Nguyên vẹn (Tốt) <span class="required">*</span></label>
                    <input asp-for="GoodQty" class="form-control" type="number" min="0" max="@Model.RequestDetails.ExportedQuantity" />
                    <span class="field-error" asp-validation-for="GoodQty"></span>
                    <div style="font-size:.75rem; color:var(--text-3); margin-top:4px;">Cộng dồn lại vào Tồn kho khả dụng.</div>
                </div>

                <div class="form-group">
                    <label asp-for="DefectiveQty">Hỏng/Cần sửa chữa <span class="required">*</span></label>
                    <input asp-for="DefectiveQty" class="form-control" type="number" min="0" max="@Model.RequestDetails.ExportedQuantity" />
                    <span class="field-error" asp-validation-for="DefectiveQty"></span>
                    <div style="font-size:.75rem; color:var(--text-3); margin-top:4px;">Lưu vào kho hàng lỗi chờ xử lý sửa chữa.</div>
                </div>

                <div class="form-group">
                    <label asp-for="LostQty">Thiếu, Mất hỏng hoàn toàn (Cần đền bù) <span class="required">*</span></label>
                    <input asp-for="LostQty" class="form-control" type="number" min="0" max="@Model.RequestDetails.ExportedQuantity" />
                    <span class="field-error" asp-validation-for="LostQty"></span>
                    <div style="font-size:.75rem; color:var(--text-3); margin-top:4px;">Trừ thẳng vào Tổng tài sản (Total Owned).</div>
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label asp-for="Note">Ghi chú thêm</label>
                    <input asp-for="Note" class="form-control" placeholder="Tình trạng chi tiết..." />
                </div>
            </div>
            
        </div>
        <div class="form-actions">
            <div style="font-size:.8rem; color:var(--text-3); align-self:center;">
                * Trạng thái yêu cầu sẽ hoàn tất.
            </div>
            <button type="submit" class="btn btn-primary" style="background:#6ee7b7; color:#064e3b; margin-left:auto;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Xác nhận hoàn tất
            </button>
        </div>
    </form>
</div>
