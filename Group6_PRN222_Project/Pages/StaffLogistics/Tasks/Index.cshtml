@page
@model Project_PRN222.Pages.StaffLogistics.Tasks.IndexModel

@{
    ViewData["Title"] = "Staff (Logistics) — Tasks";
}

<div class="page-header">
    <div class="page-title">
        <h1>Danh sách Tasks</h1>
        <p class="subtitle">Cập nhật trạng thái theo tiến độ vận hành thực địa</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px;">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 280px;">Task</th>
                    <th>Sự kiện</th>
                    <th style="width: 180px;">Deadline</th>
                    <th style="width: 260px;">Cập nhật trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tasks)
                {
                    <tr>
                        <td>
                            <div style="font-weight: 600; color:var(--text-1);">@(t.TaskName ?? "—")</div>
                            <div style="color:var(--text-3); font-size:.86rem; margin-top:4px;">
                                @(t.Description ?? "")
                            </div>
                        </td>
                        <td><strong>@(t.Event?.EventName ?? "—")</strong></td>
                        <td style="color:var(--text-2); font-family:var(--ff-mono);">@(t.Deadline?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>
                            <form method="post" asp-page-handler="UpdateStatus" style="display:flex; gap:8px;">
                                <input type="hidden" name="taskId" value="@t.TaskId" />
                                <select name="status" class="form-control" style="width:auto;">
                                    @if (t.Status == "To Do")
                                    {
                                        <option value="To Do" selected>To Do</option>
                                    }
                                    else
                                    {
                                        <option value="To Do">To Do</option>
                                    }

                                    @if (t.Status == "In Progress")
                                    {
                                        <option value="In Progress" selected>In Progress</option>
                                    }
                                    else
                                    {
                                        <option value="In Progress">In Progress</option>
                                    }

                                    @if (t.Status == "Done")
                                    {
                                        <option value="Done" selected>Done</option>
                                    }
                                    else
                                    {
                                        <option value="Done">Done</option>
                                    }

                                    @if (t.Status == "Completed")
                                    {
                                        <option value="Completed" selected>Completed</option>
                                    }
                                    else
                                    {
                                        <option value="Completed">Completed</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-secondary" style="height:38px; line-height:38px; padding:0 14px;">Lưu</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Tasks.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <div class="empty-icon">✓</div>
                            <div>Không có task nào được gán cho bạn.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
